<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1 fw-bold">
      <i class="bi bi-people me-2 text-primary"></i>
      Users
    </h4>
    <p class="text-muted mb-0 small">
      Manage all registered users
    </p>
  </div>

  <div class="text-muted small">
    Page <%= currentPage %> of <%= totalPages %>
  </div>
</div>

<!-- Search Card -->
<!-- Search -->
<div class="mb-4">
  <form
    method="GET"
    action="/admin/users"
    class="d-flex align-items-center gap-2"
  >

    <div
      class="position-relative"
      style="width:380px;max-width:100%;"
    >
      <i
        class="bi bi-search position-absolute"
        style="
          left:14px;
          top:50%;
          transform:translateY(-50%);
          color:#94a3b8;
          font-size:14px;
        "
      ></i>

      <input
        type="text"
        name="search"
        class="form-control border-0 shadow-sm"
        placeholder="Search users..."
        value="<%= search %>"
        style="
          height:44px;
          padding-left:40px;
          border-radius:12px;
          background:#fff;
        "
      />
    </div>

    <button
      type="submit"
      class="btn btn-primary px-4"
      style="
        height:44px;
        border-radius:12px;
      "
    >
      Search
    </button>

    <% if(search) { %>
      <a
        href="/admin/users"
        class="btn btn-light border px-3"
        style="
          height:44px;
          border-radius:12px;
          display:flex;
          align-items:center;
        "
      >
        Clear
      </a>
    <% } %>

  </form>
</div>

<!-- Users Table -->
<div class="card shadow-sm border-0">
  <div class="card-header bg-white py-3">
    <span class="fw-semibold">All Users</span>
  </div>

  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3">#</th>
            <th>User</th>
            <th>Email</th>
            <th>Stage</th>
            <th>Interests</th>
            <th>Status</th>
            <th>Joined</th>
            <th class="text-end pe-3">Actions</th>
          </tr>
        </thead>

        <tbody>

          <% if (users.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center text-muted py-5">
                <i class="bi bi-people fs-1 d-block mb-2 opacity-50"></i>
                No users found
              </td>
            </tr>
          <% } %>

          <% users.forEach((u, i) => { %>

          <tr>

            <td class="ps-3">
              <span class="text-muted">
                <%= ((currentPage - 1) * 10) + i + 1 %>
              </span>
            </td>

            <td>
              <div class="d-flex align-items-center gap-3">

                <img
                  src="<%= u.avatar || '/images/avatar.png' %>"
                  width="48"
                  height="48"
                  class="rounded-circle"
                  style="object-fit:cover;border:1px solid #e2e8f0"
                />

                <div>
                  <a
                    href="/admin/users/<%= u._id %>"
                    class="text-decoration-none text-dark fw-semibold"
                  >
                    <%= u.name || u.username %>
                  </a>

                  <div class="small text-muted">
                    @<%= u.username %>
                  </div>
                </div>

              </div>
            </td>

            <td>
              <small class="text-muted">
                <%= u.email %>
              </small>
            </td>

            <td>
              <% if (u.stage) { %>

                <span
                  class="badge bg-primary-subtle text-primary border border-primary-subtle"
                >
                  <%= u.stage?.name || u.stage?.title || '-' %>
                </span>

              <% } else { %>

                <span class="text-muted">-</span>

              <% } %>
            </td>

            <td>

              <% if (u.businessInterests && u.businessInterests.length > 0) { %>

                <span class="badge bg-light text-dark border">
                  <%= u.businessInterests.length %> Selected
                </span>

              <% } else { %>

                <span class="text-muted">-</span>

              <% } %>

            </td>

            <td>

              <% if (u.isActive) { %>

                <span class="badge bg-success-subtle text-success border border-success-subtle">
                  Active
                </span>

              <% } else { %>

                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                  Inactive
                </span>

              <% } %>

            </td>

            <td>
              <small class="text-muted">
                <%= new Date(u.createdAt).toLocaleDateString('en-IN') %>
              </small>
            </td>

            <td class="text-end pe-3">

              <div class="d-flex justify-content-end gap-1">

                <a
                  href="/admin/users/<%= u._id %>"
                  class="btn btn-sm btn-outline-info"
                  title="View"
                >
                  <i class="bi bi-eye"></i>
                </a>

                <form
                  action="/admin/users/<%= u._id %>/toggle"
                  method="POST"
                  style="display:inline"
                >
                  <button
                    class="btn btn-sm btn-outline-warning"
                    title="<%= u.isActive ? 'Deactivate' : 'Activate' %>"
                  >
                    <i class="bi bi-<%= u.isActive ? 'pause' : 'play' %>"></i>
                  </button>
                </form>

                <form
                  action="/admin/users/<%= u._id %>/delete"
                  method="POST"
                  style="display:inline"
                >
                  <button
                    class="btn btn-sm btn-outline-danger btn-delete"
                    title="Delete"
                  >
                    <i class="bi bi-trash"></i>
                  </button>
                </form>

              </div>

            </td>

          </tr>

          <% }) %>

        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Pagination -->
<% if (totalPages > 1) { %>

<nav class="mt-4">
  <ul class="pagination pagination-sm justify-content-center">

    <% for(let i = 1; i <= totalPages; i++) { %>

      <li class="page-item <%= currentPage === i ? 'active' : '' %>">
        <a
          class="page-link"
          href="/admin/users?page=<%= i %><%= search ? '&search=' + search : '' %>"
        >
          <%= i %>
        </a>
      </li>

    <% } %>

  </ul>
</nav>

<% } %>

<script>
document.querySelectorAll('.btn-delete').forEach(btn => {
  btn.addEventListener('click', function(e) {
    if (!confirm('Delete this user?')) {
      e.preventDefault();
    }
  });
});
</script>

<%- include('../partials/footer') %>