<%- include('../partials/header') %>

<div class="row g-3">
<div class="col-md-4">
  <div class="card shadow-sm border-0">
    <div class="card-body text-center py-4">

      <img
        src="<%= user.avatar %>"
        alt="avatar"
        class="rounded-circle mb-3"
        width="90"
        height="90"
        style="object-fit:cover;border:3px solid #e2e8f0"
      />

      <h5 class="fw-bold mb-1">
        <%= user.name || user.username %>
      </h5>

      <p class="text-muted small mb-3">
        @<%= user.username %>
      </p>

      <% if(user.isActive){ %>
        <span class="badge bg-success-subtle text-success border border-success-subtle">
          Active User
        </span>
      <% } else { %>
        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
          Deactivated
        </span>
      <% } %>

      <hr>

      <div class="d-grid gap-2">

        <form action="/admin/users/<%= user._id %>/toggle" method="POST">
          <button class="btn w-100 <%= user.isActive ? 'btn-outline-warning' : 'btn-outline-success' %>">
            <i class="bi bi-<%= user.isActive ? 'pause-circle' : 'play-circle' %> me-2"></i>
            <%= user.isActive ? 'Deactivate Account' : 'Activate Account' %>
          </button>
        </form>

        <form action="/admin/users/<%= user._id %>/delete" method="POST">
          <button class="btn btn-outline-danger w-100 btn-delete">
            <i class="bi bi-trash me-2"></i>
            Delete User
          </button>
        </form>

      </div>

    </div>
  </div>
</div>

  <div class="col-md-8">
   <div class="card shadow-sm border-0">
  <div class="card-header bg-white py-3">
  <h6 class="mb-0 fw-semibold">
    <i class="bi bi-person me-2 text-primary"></i>
    User Profile
  </h6>
</div>
      <div class="card-body">
     <table class="table align-middle mb-0">
          <tr><td class="text-muted" width="140">Name</td><td><strong><%= user.name || '-' %></strong></td></tr>
          <tr><td class="text-muted">Username</td><td>@<%= user.username %></td></tr>
          <tr><td class="text-muted">Email</td><td><%= user.email %></td></tr>
          <tr><td class="text-muted">Bio</td><td><%= user.bio || '-' %></td></tr>
          <tr><td class="text-muted">Joined</td><td><%= new Date(user.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'long',year:'numeric'}) %></td></tr>
          <tr>
  <td class="text-muted">Location</td>
  <td><%= user.location || '-' %></td>
</tr>

<tr>
  <td class="text-muted">Birth Date</td>
  <td>
    <%= user.birthdate
      ? new Date(user.birthdate).toLocaleDateString('en-IN')
      : '-' %>
  </td>
</tr>

<tr>
  <td class="text-muted">Twitter</td>
  <td><%= user.twitterHandle || '-' %></td>
</tr>

<tr>
  <td class="text-muted">Description</td>
  <td><%= user.description || '-' %></td>
</tr>

<tr>
  <td class="text-muted">Coding Level</td>
  <td><%= user.codingLevel || '-' %></td>
</tr>
        </table>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-header">📋 Signup Journey</div>
      <div class="card-body">
        <table class="table table-sm mb-0">
          <tr>
            <td class="text-muted" width="140">Stage</td>
            <td>
              <% if (user.stage) { %>
                <span class="badge bg-primary bg-opacity-10 text-primary" style="border:1px solid #c7d2fe"><%= user.stage?.name || user.stage?.title || '-' %></span>
              <% } else { %><span class="text-muted">-</span><% } %>
            </td>
          </tr>
          <!-- <tr>
            <td class="text-muted">Role</td>
            <td>
              <% if (user.selfRole) { %>
                <span class="badge bg-success bg-opacity-10 text-success" style="border:1px solid #bbf7d0"><%= user.selfRole %></span>
              <% } else { %><span class="text-muted">-</span><% } %>
            </td>
          </tr> -->
        <tr>
  <td class="text-muted">Business Interests</td>
  <td>
    <% if (user.businessInterests && user.businessInterests.length > 0) { %>
      <div class="d-flex flex-wrap gap-1">
        <% user.businessInterests.forEach(interest => { %>
          <span
            class="badge bg-warning bg-opacity-10 text-warning"
            style="border:1px solid #fde68a;font-size:.72rem"
          >
            <%= interest %>
          </span>
        <% }) %>
      </div>
    <% } else { %>
      <span class="text-muted">-</span>
    <% } %>
  </td>
</tr>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="mt-3">
  <a href="/admin/users" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Users</a>
</div>

<%- include('../partials/footer') %>
