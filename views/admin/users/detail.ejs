<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
  <%- include('../_layouts/head') %>
  <title>User Detail | <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    body { padding-top: 78px !important; }
    #main { margin-top: 0 !important; }
    .section-title { font-size: 1rem; font-weight: 600; color: #1a237e; border-left: 4px solid #3949ab; padding-left: 10px; margin: 20px 0 10px; }
    .form-note { font-size: 12px; color: #757575; margin-top: 4px; }
    .profile-avatar {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid #e2e8f0;
    }
  </style>
</head>
<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
  data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

  <%- include('../partials/header') %>

  <div id="main">
    <div class="row">
      <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
        <div class="container">
          <div class="row">
            <div class="col s12 m6 l6">
              <h5 class="breadcrumbs-title mt-0 mb-0"><span>User Detail</span></h5>
            </div>
            <div class="col s12 m6 l6 right-align-md">
              <ol class="breadcrumbs mb-0">
                <a class="btn gradient-45deg-purple-deep-orange pull-right btn-breadcrumbs"
                  style="color:#fff;" href="/admin/users">Back to Users</a>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <div class="col s12">
        <div class="container">
          <div class="section">

            <div class="row">

              <!-- LEFT: Profile Card -->
              <div class="col s12 m4 l3">
                <div class="card-panel center-align">
                  <img
                    src="<%= user.Profilephoto || user.avatar || '/img/avatar.png' %>"
                    alt="avatar"
                    class="profile-avatar mb-3"
                    onerror="this.onerror=null; this.src='/img/avatar.png';"
                  />
                  <h5 class="fw-bold mb-1"><%= user.name || user.username %></h5>
                  <p class="text-muted small mb-3">@<%= user.username %></p>

                  <% if (user.isActive) { %>
                    <span class="badge-active">Active User</span>
                  <% } else { %>
                    <span class="badge-inactive">Deactivated</span>
                  <% } %>

                  <div class="mt-4">
                    <form action="/admin/users/<%= user._id %>/toggle" method="POST" style="display:inline;">
                      <button class="btn waves-effect waves-light <%= user.isActive ? 'orange' : 'green' %>">
                        <i class="material-icons left"><%= user.isActive ? 'pause' : 'play_arrow' %></i>
                        <%= user.isActive ? 'Deactivate' : 'Activate' %>
                      </button>
                    </form>
                  </div>

                  <form action="/admin/users/<%= user._id %>/delete" method="POST" style="display:inline; margin-top:10px;">
                    <button class="btn waves-effect waves-light red btn-delete">
                      <i class="material-icons left">delete</i> Delete User
                    </button>
                  </form>
                </div>

                <!-- Social Links -->
                <% if (user.socialLinks && user.socialLinks.length > 0) { %>
                <div class="card-panel">
                  <p class="section-title"><i class="bi bi-share"></i> Social Links</p>
                  <% user.socialLinks.forEach(link => { %>
                    <div class="d-flex align-items-center gap-2 mb-2">
                      <span class="badge" style="background:#e3f2fd;color:#1565c0;text-transform:capitalize"><%= link.platform %></span>
                      <a href="<%= link.link %>" target="_blank" class="small text-primary truncate"><%= link.link %></a>
                    </div>
                  <% }) %>
                </div>
                <% } %>
              </div>

              <!-- RIGHT: User Details -->
              <div class="col s12 m8 l9">

                <!-- Profile Information -->
                <div class="card-panel">
                  <p class="section-title"><i class="bi bi-person"></i> Profile Information</p>
                  <table class="striped">
                    <tbody>
                      <tr><td class="grey-text" style="width:160px">Full Name</td><td><%= user.name || '—' %></td></tr>
                      <tr><td class="grey-text">Username</td><td>@<%= user.username %></td></tr>
                      <tr><td class="grey-text">Email</td><td><%= user.email || '—' %></td></tr>
                      <tr><td class="grey-text">Location</td><td><%= user.location || '—' %></td></tr>
                      <tr><td class="grey-text">Birth Date</td><td><%= user.birthdate ? new Date(user.birthdate).toLocaleDateString('en-IN') : '—' %></td></tr>
                      <tr><td class="grey-text">Twitter</td><td><%= user.twitterHandle ? '@' + user.twitterHandle : '—' %></td></tr>
                      <tr><td class="grey-text">Bio</td><td><%= user.bio || '—' %></td></tr>
                      <tr><td class="grey-text">Description</td><td><%= user.description || '—' %></td></tr>
                      <tr><td class="grey-text">Joined</td><td><%= new Date(user.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'long', year:'numeric' }) %></td></tr>
                      <tr><td class="grey-text">Auth Provider</td><td><span class="badge"><%= user.authProvider || 'local' %></span></td></tr>
                    </tbody>
                  </table>
                </div>

                <!-- Signup Journey -->
                <div class="card-panel">
                  <p class="section-title"><i class="bi bi-signpost"></i> Signup Journey</p>
                  <table class="striped">
                    <tbody>
                      <tr><td class="grey-text" style="width:160px">Stage</td>
                        <td>
                          <% if (user.stage) { %>
                            <span class="badge blue"><%= user.stage?.name || user.stage?.title || '—' %></span>
                          <% } else { %>—<% } %>
                        </td>
                      </tr>
                      <tr><td class="grey-text">Coding Level</td><td><%= user.codingLevel || '—' %></td></tr>
                      <tr><td class="grey-text">Business Interests</td>
                        <td>
                          <% if (user.businessInterests && user.businessInterests.length > 0) { %>
                            <% user.businessInterests.forEach(interest => { %>
                              <span class="badge orange"><%= interest %></span>
                            <% }) %>
                          <% } else { %>—<% } %>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>

              </div>
            </div>
          </div>
        </div>
        <div class="content-overlay"></div>
      </div>
    </div>
  </div>

  <%- include('../_layouts/commonJs') %>

  <script>
    // === STRONG ANTI AUTO-REFRESH + ERROR HANDLING ===
    let refreshBlocked = true;

    window.onbeforeunload = null;
    if (window.stop) window.stop();

    // Block repeated image errors
    document.querySelectorAll('img').forEach(img => {
      img.addEventListener('error', function() {
        if (this.src.includes('avatar.png')) {
          this.onerror = null; // prevent infinite loop
        }
      });
    });

    // Block intervals/timeouts
    const originalSetInterval = window.setInterval;
    const originalSetTimeout = window.setTimeout;
    window.setInterval = function() { return null; };
    window.setTimeout = function() { return null; };

    // Keyboard refresh block
    document.addEventListener('keydown', function(e) {
      if (e.key === 'F5' || (e.ctrlKey && e.key === 'r') || (e.metaKey && e.key === 'r')) {
        e.preventDefault();
      }
    }, true);

    // Aggressive cleanup
    setInterval(() => {
      if (refreshBlocked) {
        for (let i = 0; i < 200; i++) {
          window.clearInterval(i);
          window.clearTimeout(i);
        }
      }
    }, 800);

    console.log('%c✅ User Detail Page Loaded - Auto Refresh & Image Errors Disabled', 'color: green; font-weight: bold');

    // Delete Confirmation
    document.querySelectorAll('.btn-delete').forEach(btn => {
      btn.addEventListener('click', function(e) {
        if (!confirm('Are you sure you want to delete this user permanently? This action cannot be undone.')) {
          e.preventDefault();
        }
      });
    });
  </script>
</body>
</html>