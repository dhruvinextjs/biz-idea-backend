<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1 fw-bold"><i class="bi bi-person-circle me-2 text-primary"></i>User Detail</h4>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
        <li class="breadcrumb-item"><a href="/admin/users">Users</a></li>
        <li class="breadcrumb-item active"><%= user.name || user.username %></li>
      </ol>
    </nav>
  </div>
  <a href="/admin/users" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i> Back
  </a>
</div>

<div class="row g-4">

  <!-- LEFT: Profile Card -->
  <div class="col-12 col-lg-4">

    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body text-center py-4">
        <img
          src="<%= user.Profilephoto || user.avatar || '/images/avatar.png' %>"
          alt="avatar"
          class="rounded-circle mb-3"
          width="90" height="90"
          style="object-fit:cover;border:3px solid #e2e8f0"
        />
        <h5 class="fw-bold mb-1"><%= user.name || user.username %></h5>
        <p class="text-muted small mb-2">@<%= user.username %></p>
        <% if (user.email) { %>
          <p class="text-muted small mb-3"><i class="bi bi-envelope me-1"></i><%= user.email %></p>
        <% } %>

        <% if (user.isActive) { %>
          <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
            <i class="bi bi-check-circle me-1"></i>Active User
          </span>
        <% } else { %>
          <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2">
            <i class="bi bi-pause-circle me-1"></i>Deactivated
          </span>
        <% } %>

        <hr class="my-3">

        <div class="d-grid gap-2">
          <form action="/admin/users/<%= user._id %>/toggle" method="POST">
            <button class="btn w-100 <%= user.isActive ? 'btn-outline-warning' : 'btn-outline-success' %>">
              <i class="bi bi-<%= user.isActive ? 'pause-circle' : 'play-circle' %> me-2"></i>
              <%= user.isActive ? 'Deactivate Account' : 'Activate Account' %>
            </button>
          </form>
          <form action="/admin/users/<%= user._id %>/delete" method="POST">
            <button class="btn btn-outline-danger w-100 btn-delete">
              <i class="bi bi-trash me-2"></i>Delete User
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Social Links -->
    <% if (user.socialLinks && user.socialLinks.length > 0) { %>
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-share me-2 text-info"></i>Social Links</h6>
      </div>
      <div class="card-body">
        <% user.socialLinks.forEach(link => { %>
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-light text-dark border text-capitalize" style="min-width:80px"><%= link.platform %></span>
            <a href="<%= link.link %>" target="_blank" class="text-truncate small text-primary"><%= link.link %></a>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>

  </div>

  <!-- RIGHT: Details -->
  <div class="col-12 col-lg-8">

    <!-- Profile Info -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-person me-2 text-primary"></i>Profile Information</h6>
      </div>
      <div class="card-body p-0">
        <table class="table align-middle mb-0">
          <tbody>
            <tr>
              <td class="text-muted ps-4" style="width:160px">Full Name</td>
              <td class="fw-semibold"><%= user.name || '—' %></td>
            </tr>
            <tr>
              <td class="text-muted ps-4">Username</td>
              <td>@<%= user.username %></td>
            </tr>
            <tr>
              <td class="text-muted ps-4">Email</td>
              <td><%= user.email || '—' %></td>
            </tr>
            <tr>
              <td class="text-muted ps-4">Location</td>
              <td><%= user.location || '—' %></td>
            </tr>
            <tr>
              <td class="text-muted ps-4">Birth Date</td>
              <td><%= user.birthdate ? new Date(user.birthdate).toLocaleDateString('en-IN') : '—' %></td>
            </tr>
            <tr>
              <td class="text-muted ps-4">Twitter</td>
              <td><%= user.twitterHandle ? '@' + user.twitterHandle : '—' %></td>
            </tr>
            <tr>
              <td class="text-muted ps-4">Bio</td>
              <td><%= user.bio || '—' %></td>
            </tr>
            <tr>
              <td class="text-muted ps-4">Description</td>
              <td><%= user.description || '—' %></td>
            </tr>
            <tr>
              <td class="text-muted ps-4">Joined</td>
              <td><%= new Date(user.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'long', year:'numeric' }) %></td>
            </tr>
            <tr>
              <td class="text-muted ps-4">Auth Provider</td>
              <td>
                <span class="badge bg-light text-dark border text-capitalize"><%= user.authProvider || 'local' %></span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Signup Journey -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-signpost me-2 text-success"></i>Signup Journey</h6>
      </div>
      <div class="card-body p-0">
        <table class="table align-middle mb-0">
          <tbody>
            <tr>
              <td class="text-muted ps-4" style="width:160px">Stage</td>
              <td>
                <% if (user.stage) { %>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                    <%= user.stage?.name || user.stage?.title || '—' %>
                  </span>
                <% } else { %><span class="text-muted">—</span><% } %>
              </td>
            </tr>
            <tr>
              <td class="text-muted ps-4">Coding Level</td>
              <td><%= user.codingLevel || '—' %></td>
            </tr>
            <tr>
              <td class="text-muted ps-4">Business Interests</td>
              <td>
                <% if (user.businessInterests && user.businessInterests.length > 0) { %>
                  <div class="d-flex flex-wrap gap-1">
                    <% user.businessInterests.forEach(interest => { %>
                      <span class="badge bg-warning-subtle text-warning border border-warning-subtle" style="font-size:.72rem">
                        <%= interest %>
                      </span>
                    <% }) %>
                  </div>
                <% } else { %><span class="text-muted">—</span><% } %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<script>
document.querySelectorAll('.btn-delete').forEach(btn => {
  btn.addEventListener('click', function(e) {
    if (!confirm('Are you sure you want to delete this user permanently?')) e.preventDefault();
  });
});
</script>

<%- include('../partials/footer') %>
