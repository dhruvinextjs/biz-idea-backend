<%
  // Flash messages safely read karo — agar exist na kare to empty object
  const flashMessages = typeof messages !== 'undefined' ? messages : {};
  const flashTypes = Object.keys(flashMessages);
%>

<% flashTypes.forEach(function(type) { %>
  <% const msgs = flashMessages[type]; %>

  <% if (msgs && msgs.length > 0) { %>

    <%
      // Bootstrap alert class map karo flash type se
      let alertClass = 'alert-info';
      if (type === 'success') alertClass = 'alert-success';
      else if (type === 'error')   alertClass = 'alert-danger';
      else if (type === 'warning') alertClass = 'alert-warning';
    %>

    <div class="alert <%= alertClass %> alert-dismissible fade show" role="alert">
      <% msgs.forEach(function(message) { %>
        <div><%= message %></div>
      <% }) %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>

  <% } %>
<% }) %>
