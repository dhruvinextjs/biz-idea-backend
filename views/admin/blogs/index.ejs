<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <span class="text-muted">Page <%= currentPage %> of <%= totalPages %></span>
  <a href="/admin/blogs/create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Blog</a>
</div>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead><tr><th>#</th><th>Title</th><th>Category</th><th>Author</th><th>Featured</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead>
      <tbody>
        <% if (blogs.length === 0) { %>
          <tr><td colspan="8" class="text-center text-muted py-4">No blogs yet.</td></tr>
        <% } %>
        <% blogs.forEach((b, i) => { %>
        <tr>
          <td class="text-muted"><%= ((currentPage-1)*10) + i + 1 %></td>
          <td><strong><%= b.title.substring(0,45) %><%= b.title.length > 45 ? '...' : '' %></strong></td>
          <td><span class="badge bg-primary"><%= b.category %></span></td>
          <td><%= b.author %></td>
          <td><% if (b.isFeatured) { %><span class="badge bg-warning text-dark">⭐</span><% } else { %>-<% } %></td>
          <td><span class="badge <%= b.isActive ? 'badge-active' : 'badge-inactive' %>"><%= b.isActive ? 'Active' : 'Hidden' %></span></td>
          <td><%= new Date(b.publishedAt).toLocaleDateString() %></td>
          <td>
            <a href="/admin/blogs/<%= b._id %>/edit" class="btn btn-sm btn-outline-secondary py-0 me-1"><i class="bi bi-pencil"></i></a>
            <form action="/admin/blogs/<%= b._id %>/delete" method="POST" style="display:inline">
              <button class="btn btn-sm btn-outline-danger py-0 btn-delete"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% if (totalPages > 1) { %>
<nav class="mt-3"><ul class="pagination pagination-sm justify-content-center">
  <% for(let i = 1; i <= totalPages; i++) { %><li class="page-item <%= currentPage===i?'active':'' %>"><a class="page-link" href="/admin/blogs?page=<%= i %>"><%= i %></a></li><% } %>
</ul></nav>
<% } %>
<%- include('../partials/footer') %>
