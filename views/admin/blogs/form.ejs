<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
  <%- include('../_layouts/head') %>
  <title><%= blog ? 'Edit Blog' : 'Create Blog' %> | <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    body { padding-top: 78px !important; }
    #main { margin-top: 0 !important; }
    .section-title { font-size: 1rem; font-weight: 600; color: #1a237e; border-left: 4px solid #3949ab; padding-left: 10px; margin: 20px 0 10px; }
    .required-star { color: #e53935; }
    .form-note { font-size: 12px; color: #757575; margin-top: 4px; }
    .input-field label.active { color: #3949ab !important; }
  </style>
</head>
<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
  data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

  <%- include('../partials/header') %>

  <div id="main">
    <div class="row">
      <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
        <div class="container">
          <div class="row">
            <div class="col s12 m6 l6">
              <h5 class="breadcrumbs-title mt-0 mb-0"><span><%= blog ? 'Edit Blog Post' : 'Create Blog Post' %></span></h5>
            </div>
            <div class="col s12 m6 l6 right-align-md">
              <ol class="breadcrumbs mb-0">
                <a class="btn gradient-45deg-purple-deep-orange pull-right btn-breadcrumbs"
                  style="color:#fff;" href="/admin/blogs">Back to Blogs</a>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <div class="col s12">
        <div class="container">
          <div class="section">
            <div class="card-panel">
              <div class="card-content">
                <form id="blogForm" method="POST"
                  action="/admin/blogs/<%= blog ? blog._id + '/edit' : 'create' %>"
                  onsubmit="return validateForm()">
                  <div class="row">

                    <!-- CONTENT -->
                    <div class="col s12">
                      <p class="section-title"><i class="bi bi-pencil-square"></i> Content</p>
                    </div>
                    <div class="input-field col s12">
                      <input id="title" name="title" type="text" value="<%= blog ? blog.title : '' %>" required>
                      <label for="title" class="<%= blog ? 'active' : '' %>">Title <span class="required-star">*</span></label>
                      <span id="titleError" class="helper-text red-text"></span>
                    </div>
                    <div class="input-field col s12">
                      <textarea id="excerpt" name="excerpt" class="materialize-textarea" required><%= blog ? blog.excerpt : '' %></textarea>
                      <label for="excerpt" class="<%= blog ? 'active' : '' %>">Excerpt <span class="required-star">*</span></label>
                      <span id="excerptError" class="helper-text red-text"></span>
                    </div>
                    <div class="input-field col s12">
                      <textarea id="content" name="content" class="materialize-textarea" required><%= blog ? blog.content : '' %></textarea>
                      <label for="content" class="<%= blog ? 'active' : '' %>">Full Content <span class="required-star">*</span></label>
                      <span id="contentError" class="helper-text red-text"></span>
                    </div>

                    <!-- SETTINGS -->
                    <div class="col s12">
                      <p class="section-title"><i class="bi bi-sliders"></i> Settings</p>
                    </div>
                    <div class="input-field col s12 m6">
                      <select name="category">
                        <% ['IDEAS','GUIDE','FINANCE','TECH','MARKETING','GENERAL'].forEach(cat => { %>
                          <option value="<%= cat %>" <%= blog && blog.category === cat ? 'selected' : '' %>><%= cat %></option>
                        <% }) %>
                      </select>
                      <label>Category</label>
                    </div>
                    <div class="input-field col s12 m6">
                      <input name="author" type="text" value="<%= blog ? blog.author : 'TheBizIdeas Team' %>">
                      <label class="active">Author</label>
                    </div>
                    <div class="input-field col s12 m6">
                      <input name="image" type="text" value="<%= blog ? blog.image : '/images/startup-sketch.png' %>">
                      <label class="active">Cover Image URL</label>
                    </div>
                    <div class="input-field col s12 m6">
                      <input name="publishedAt" type="date" value="<%= blog ? new Date(blog.publishedAt).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>">
                      <label class="active">Published Date</label>
                    </div>

                    <!-- STATUS -->
                    <div class="col s12">
                      <p class="section-title"><i class="bi bi-toggle-on"></i> Status</p>
                    </div>
                    <div class="col s12 m6">
                      <div class="switch" style="margin:10px 0;">
                        <label>Inactive
                          <input type="checkbox" name="isActive" value="true" <%= !blog || blog.isActive ? 'checked' : '' %>>
                          <span class="lever"></span>
                          Active
                        </label>
                      </div>
                      <p class="form-note">Visible on site when active</p>
                    </div>
                    <div class="col s12 m6">
                      <div class="switch" style="margin:10px 0;">
                        <label>Normal
                          <input type="checkbox" name="isFeatured" value="true" <%= blog && blog.isFeatured ? 'checked' : '' %>>
                          <span class="lever"></span>
                          Featured ⭐
                        </label>
                      </div>
                      <p class="form-note">Show at top when featured</p>
                    </div>

                    <!-- BUTTONS -->
                    <div class="col s12 right-align" style="margin-top:20px;">
                      <button type="submit" id="submitBtn"
                        class="btn gradient-45deg-purple-deep-orange waves-effect waves-light">
                        <i class="material-icons left"><%= blog ? 'save' : 'add_circle' %></i>
                        <%= blog ? 'Update Blog' : 'Create Blog' %>
                      </button>
                      <a href="/admin/blogs" class="btn grey waves-effect waves-light" style="margin-left:8px;">
                        <i class="material-icons left">cancel</i>Cancel
                      </a>
                    </div>

                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
        <div class="content-overlay"></div>
      </div>
    </div>
  </div>

  <%- include('../_layouts/commonJs') %>
  <script>
    $(document).ready(function () {
      $('select').formSelect();
      M.updateTextFields();
      document.querySelectorAll('.materialize-textarea').forEach(el => M.textareaAutoResize(el));
    });
    function validateForm() {
      let valid = true;
      ['title','excerpt','content'].forEach(id => {
        const el = document.getElementById(id);
        const err = document.getElementById(id + 'Error');
        if (!el.value.trim()) { err.innerText = id.charAt(0).toUpperCase() + id.slice(1) + ' is required.'; valid = false; }
        else err.innerText = '';
      });
      if (valid) { const btn = document.getElementById('submitBtn'); btn.disabled = true; btn.innerHTML = '<i class="material-icons left">hourglass_empty</i> Saving...'; }
      return valid;
    }
  </script>
</body>
</html>
