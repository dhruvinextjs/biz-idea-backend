<%- include('../partials/header') %>

<div class="card" style="max-width:800px">
  <div class="card-header"><%= blog ? '✏️ Edit Blog' : '➕ Create Blog Post' %></div>
  <div class="card-body">
    <form action="/admin/blogs/<%= blog ? blog._id + '/edit' : 'create' %>" method="POST">
      <div class="row g-3">
        <div class="col-12">
          <label class="form-label fw-semibold">Title *</label>
          <input type="text" name="title" class="form-control" value="<%= blog ? blog.title : '' %>" required/>
        </div>
        <div class="col-12">
          <label class="form-label fw-semibold">Excerpt *</label>
          <textarea name="excerpt" class="form-control" rows="2" required><%= blog ? blog.excerpt : '' %></textarea>
        </div>
        <div class="col-12">
          <label class="form-label fw-semibold">Content *</label>
          <textarea name="content" class="form-control" rows="10" required placeholder="Full blog content (supports HTML)"><%= blog ? blog.content : '' %></textarea>
        </div>
        <div class="col-md-6">
          <label class="form-label fw-semibold">Category</label>
          <select name="category" class="form-select">
            <% ['IDEAS','GUIDE','FINANCE','TECH','MARKETING','GENERAL'].forEach(cat => { %>
              <option value="<%= cat %>" <%= blog && blog.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label fw-semibold">Author</label>
          <input type="text" name="author" class="form-control" value="<%= blog ? blog.author : 'TheBizIdeas Team' %>"/>
        </div>
        <div class="col-md-6">
          <label class="form-label fw-semibold">Cover Image URL</label>
          <input type="text" name="image" class="form-control" value="<%= blog ? blog.image : '/images/startup-sketch.png' %>"/>
        </div>
        <div class="col-md-6">
          <label class="form-label fw-semibold">Published Date</label>
          <input type="date" name="publishedAt" class="form-control" value="<%= blog ? new Date(blog.publishedAt).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>"/>
        </div>
        <div class="col-md-6">
          <div class="form-check form-switch mt-2">
            <input class="form-check-input" type="checkbox" name="isActive" value="true" <%= !blog || blog.isActive ? 'checked' : '' %>/>
            <label class="form-check-label">Active</label>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-check form-switch mt-2">
            <input class="form-check-input" type="checkbox" name="isFeatured" value="true" <%= blog && blog.isFeatured ? 'checked' : '' %>/>
            <label class="form-check-label">⭐ Featured</label>
          </div>
        </div>
        <div class="col-12 d-flex gap-2">
          <button type="submit" class="btn btn-primary"><%= blog ? 'Update' : 'Create' %> Blog</button>
          <a href="/admin/blogs" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
