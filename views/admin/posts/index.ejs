<%- include('../partials/header') %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-1 fw-bold">
        <i class="bi bi-chat-square-text me-2 text-primary"></i>Community Posts
      </h4>
      <p class="text-muted mb-0 small">Review and moderate community posts</p>
    </div>
    <a href="/admin/posts/create" class="btn btn-primary">
      <i class="bi bi-plus-lg me-1"></i> Create Post
    </a>
  </div>

  <!-- Stats Pills -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <a href="/admin/posts" class="text-decoration-none">
        <div
          class="card border-0 shadow-sm text-center py-3 <%= !currentStatus || currentStatus === 'all' ? 'border border-primary border-2' : '' %>">
          <div class="fw-bold fs-5">All</div>
          <div class="text-muted small">Posts</div>
        </div>
      </a>
    </div>
    <div class="col-6 col-md-3">
      <a href="/admin/posts?status=pending" class="text-decoration-none">
        <div
          class="card border-0 shadow-sm text-center py-3 <%= currentStatus === 'pending' ? 'border border-warning border-2' : '' %>">
          <div class="fw-bold fs-5 text-warning">Pending</div>
          <div class="text-muted small">Need Review</div>
        </div>
      </a>
    </div>
    <div class="col-6 col-md-3">
      <a href="/admin/posts?status=approved" class="text-decoration-none">
        <div
          class="card border-0 shadow-sm text-center py-3 <%= currentStatus === 'approved' ? 'border border-success border-2' : '' %>">
          <div class="fw-bold fs-5 text-success">Approved</div>
          <div class="text-muted small">Live</div>
        </div>
      </a>
    </div>
    <div class="col-6 col-md-3">
      <a href="/admin/posts?status=rejected" class="text-decoration-none">
        <div
          class="card border-0 shadow-sm text-center py-3 <%= currentStatus === 'rejected' ? 'border border-danger border-2' : '' %>">
          <div class="fw-bold fs-5 text-danger">Rejected</div>
          <div class="text-muted small">Declined</div>
        </div>
      </a>
    </div>
  </div>

  <% if (typeof successMessage !=='undefined' && successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= successMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

      <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <span class="fw-semibold">
            <% if (currentStatus==='pending' ) { %>⏳ Pending Posts
              <% } else if (currentStatus==='approved' ) { %>✅ Approved Posts
                <% } else if (currentStatus==='rejected' ) { %>❌ Rejected Posts
                  <% } else { %>All Posts<% } %>
          </span>
          <span class="text-muted small">Page <%= currentPage %> of <%= totalPages %></span>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="ps-3">#</th>
                  <th>Title</th>
                  <th>Author</th>
                  <th>Upvotes</th>
                  <th>Comments</th>
                  <th>Pinned</th>
                  <th>Status</th>
                  <th>Date</th>
                  <th class="text-end pe-3">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (posts.length===0) { %>
                  <tr>
                    <td colspan="9" class="text-center text-muted py-5">
                      <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                      No posts found.
                    </td>
                  </tr>
                  <% } %>
                    <% posts.forEach((p, i)=> { %>
                      <tr>
                        <td class="ps-3 text-muted small">
                          <%= ((currentPage-1)*10) + i + 1 %>
                        </td>
                        <td>
                          <div class="fw-semibold">
                            <% if (p.isPinned) { %><span class="text-warning me-1">📌</span>
                              <% } %>
                                <%= p.title.substring(0,45) %>
                                  <%= p.title.length> 45 ? '...' : '' %>
                          </div>
                          <% if (!p.author) { %>
                            <small class="badge bg-info-subtle text-info border border-info-subtle">Admin post</small>
                            <% } %>
                        </td>
                        <td><small class="text-muted">@<%= p.authorName %></small></td>
                        <td><span class="badge bg-light text-dark border">👍 <%= p.upvotes %></span></td>
                        <td><span class="badge bg-light text-dark border">💬 <%= p.commentCount %></span></td>
                        <td class="text-center">
                          <% if (p.isPinned) { %>
                            <span class="badge bg-warning text-dark">📌 Yes</span>
                            <% } else { %>
                              <span class="text-muted">—</span>
                              <% } %>
                        </td>
                        <td>
                          <% if (p.status==='pending' ) { %>
                            <span
                              class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending</span>
                            <% } else if (p.status==='approved' ) { %>
                              <span
                                class="badge bg-success-subtle text-success border border-success-subtle">Approved</span>
                              <% } else if (p.status==='rejected' ) { %>
                                <span
                                  class="badge bg-danger-subtle text-danger border border-danger-subtle">Rejected</span>
                                <% } %>
                        </td>
                        <td><small>
                            <%= new Date(p.createdAt).toLocaleDateString() %>
                          </small></td>
                        <td class="text-end pe-3">
                          <div class="d-flex gap-1 justify-content-end flex-wrap">

                            <!-- ✅ VIEW DETAILS BUTTON -->
                            <button class="btn btn-sm btn-outline-info btn-view-post" title="View Details"
                              data-id="<%= p._id %>">
                              <i class="bi bi-eye"></i>
                            </button>

                            <% if (p.status==='pending' ) { %>
                              <form action="/admin/posts/<%= p._id %>/approve" method="POST" style="display:inline">
                                <button class="btn btn-sm btn-success" title="Approve">
                                  <i class="bi bi-check-lg"></i>
                                </button>
                              </form>
                              <form action="/admin/posts/<%= p._id %>/reject" method="POST" style="display:inline">
                                <button class="btn btn-sm btn-danger" title="Reject">
                                  <i class="bi bi-x-lg"></i>
                                </button>
                              </form>
                              <% } %>

                                <!-- toggle isActive -->
                                <form action="/admin/posts/<%= p._id %>/toggle" method="POST" style="display:inline">
                                  <button class="btn btn-sm btn-outline-warning"
                                    title="<%= p.isActive ? 'Hide' : 'Show' %>">
                                    <i class="bi bi-toggle-<%= p.isActive ? 'on' : 'off' %>"></i>
                                  </button>
                                </form>

                                <form action="/admin/posts/<%= p._id %>/delete" method="POST" style="display:inline">
                                  <button class="btn btn-sm btn-outline-danger btn-delete" title="Delete">
                                    <i class="bi bi-trash"></i>
                                  </button>
                                </form>
                          </div>
                        </td>
                      </tr>
                      <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <% if (totalPages> 1) { %>
          <div class="card-footer bg-white py-3">
            <nav>
              <ul class="pagination pagination-sm justify-content-center mb-0">
                <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= currentPage - 1 %>&status=<%= currentStatus %>">
                    <i class="bi bi-chevron-left"></i>
                  </a>
                </li>
                <% for(let i=1; i <=totalPages; i++) { %>
                  <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= i %>&status=<%= currentStatus %>">
                      <%= i %>
                    </a>
                  </li>
                  <% } %>
                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                      <a class="page-link" href="?page=<%= currentPage + 1 %>&status=<%= currentStatus %>">
                        <i class="bi bi-chevron-right"></i>
                      </a>
                    </li>
              </ul>
            </nav>
          </div>
          <% } %>
      </div>


      <!-- ===================== POST DETAIL MODAL ===================== -->
      <div class="modal fade" id="postDetailModal" tabindex="-1" aria-labelledby="postDetailModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
          <div class="modal-content border-0 shadow">

            <div class="modal-header border-bottom">
              <h5 class="modal-title fw-bold" id="postDetailModalLabel">
                <i class="bi bi-file-text me-2 text-primary"></i>Post Details
              </h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4" id="postDetailBody">
              <!-- Filled by JS -->
              <div class="text-center py-5" id="postDetailLoading">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2 mb-0">Loading post...</p>
              </div>
            </div>

            <div class="modal-footer border-top d-flex justify-content-between" id="postDetailFooter"
              style="display:none!important">
              <div id="modalActionBtns"></div>
              <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>

          </div>
        </div>
      </div>
      <!-- ============================================================= -->


      <script>
        document.querySelectorAll('.btn-view-post').forEach(btn => {
          btn.addEventListener('click', async function () {
            const postId = this.dataset.id;
            const modal = new bootstrap.Modal(document.getElementById('postDetailModal'));
            const body = document.getElementById('postDetailBody');
            const footer = document.getElementById('postDetailFooter');
            const actionBtns = document.getElementById('modalActionBtns');

            // reset
            body.innerHTML = `
      <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-muted mt-2 mb-0">Loading post...</p>
      </div>`;
            footer.style.display = 'none';
            modal.show();

            try {
              const res = await fetch(`/admin/posts/${postId}/detail`);
              const json = await res.json();
              if (!json.success) throw new Error(json.message);

              const p = json.data;
              const statusBadge = {
                pending: '<span class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending</span>',
                approved: '<span class="badge bg-success-subtle text-success border border-success-subtle">Approved</span>',
                rejected: '<span class="badge bg-danger-subtle text-danger border border-danger-subtle">Rejected</span>',
              }[p.status] || '';

              // naya — explicit origin lagao
              const imageHtml = p.image
                ? `<img src="${window.location.origin}${p.image}" class="img-fluid rounded mb-3 w-100" style="max-height:280px;object-fit:cover;" alt="Post image" onerror="this.style.display='none'">`
                : '';

              const tagsHtml = (p.tags && p.tags.length)
                ? p.tags.map(t => `<span class="badge bg-secondary-subtle text-secondary me-1">#${t}</span>`).join('')
                : '<span class="text-muted small">No tags</span>';

              body.innerHTML = `
        ${imageHtml}

        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
          ${statusBadge}
          ${p.isPinned ? '<span class="badge bg-warning text-dark">📌 Pinned</span>' : ''}
          ${!p.author ? '<span class="badge bg-info-subtle text-info border border-info-subtle">Admin post</span>' : ''}
          ${p.isActive
                  ? '<span class="badge bg-success-subtle text-success border border-success-subtle">Visible</span>'
                  : '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Hidden</span>'}
        </div>

        <h5 class="fw-bold mb-1">${p.title}</h5>
        <p class="text-muted small mb-3">
          <i class="bi bi-person-circle me-1"></i>@${p.authorName || 'Unknown'}
          &nbsp;·&nbsp;
          <i class="bi bi-calendar3 me-1"></i>${new Date(p.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
          &nbsp;·&nbsp;
          👍 ${p.upvotes} upvotes &nbsp;·&nbsp; 💬 ${p.commentCount} comments
        </p>

        <hr class="my-3">

        <div class="mb-3" style="white-space: pre-wrap; line-height: 1.7; font-size: 0.95rem;">
          ${p.content}
        </div>

        <hr class="my-3">

        <div class="mb-2">
          <span class="fw-semibold small me-2">Tags:</span>
          ${tagsHtml}
        </div>
      `;

              // footer action buttons for pending posts
              actionBtns.innerHTML = '';
              if (p.status === 'pending') {
                actionBtns.innerHTML = `
          <form action="/admin/posts/${p._id}/approve" method="POST" style="display:inline">
            <button class="btn btn-success btn-sm me-1">
              <i class="bi bi-check-lg me-1"></i>Approve
            </button>
          </form>
          <form action="/admin/posts/${p._id}/reject" method="POST" style="display:inline">
            <button class="btn btn-danger btn-sm">
              <i class="bi bi-x-lg me-1"></i>Reject
            </button>
          </form>`;
              }
              footer.style.display = 'flex';

            } catch (err) {
              body.innerHTML = `
        <div class="text-center py-5 text-danger">
          <i class="bi bi-exclamation-triangle fs-2 d-block mb-2"></i>
          <p class="mb-0">Failed to load post: ${err.message}</p>
        </div>`;
              footer.style.display = 'flex';
            }
          });
        });

        // Delete confirm
        document.querySelectorAll('.btn-delete').forEach(btn => {
          btn.addEventListener('click', e => {
            if (!confirm('Are you sure you want to delete this post?')) e.preventDefault();
          });
        });
      </script>

      <%- include('../partials/footer') %>