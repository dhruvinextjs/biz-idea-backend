<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
  <%- include('../_layouts/head') %>
  <title>Community Posts | <%= title %></title>

  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/jquery.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/extensions/responsive/css/responsive.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/select.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="/app-assets/css/pages/data-tables.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

  <style>
    body { padding-top: 78px !important; }
    #main { margin-top: 0 !important; }

    .badge-active   { background:rgba(76,175,80,0.12); color:#4CAF50; border:1px solid rgba(76,175,80,0.3); padding:3px 10px; border-radius:12px; font-size:11px; }
    .badge-inactive { background:rgba(158,158,158,0.12); color:#9e9e9e; border:1px solid rgba(158,158,158,0.3); padding:3px 10px; border-radius:12px; font-size:11px; }
    .badge-pending  { background:rgba(255,193,7,0.12); color:#FFC107; border:1px solid rgba(255,193,7,0.3); padding:3px 10px; border-radius:12px; font-size:11px; }
    .badge-approved { background:rgba(76,175,80,0.12); color:#4CAF50; border:1px solid rgba(76,175,80,0.3); padding:3px 10px; border-radius:12px; font-size:11px; }
    .badge-rejected { background:rgba(244,67,54,0.12); color:#F44336; border:1px solid rgba(244,67,54,0.3); padding:3px 10px; border-radius:12px; font-size:11px; }

    .admin-badge {
      background:rgba(33,150,243,0.12); 
      color:#2196F3; 
      border:1px solid rgba(33,150,243,0.3); 
      padding:2px 8px; 
      border-radius:10px; 
      font-size:10px;
    }

    .action-btns {
      display: flex;
      align-items: center;
      border: none;
      gap: 6px;
      flex-wrap: nowrap;
    }
  </style>
</head>

<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
  data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

  <%- include('../partials/header') %>

  <div id="main">
    <div class="row">
      <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
        <div class="container">
          <div class="row">
            <div class="col s12 m6 l6">
              <h5 class="breadcrumbs-title mt-0 mb-0"><span>Community Posts</span></h5>
            </div>
            <div class="col s12 m6 l6 right-align-md">
              <ol class="breadcrumbs mb-0">
                <a class="btn gradient-45deg-purple-deep-orange pull-right btn-breadcrumbs"
                  style="color:#fff;" href="/admin/posts/create">Create New Post</a>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <div class="col s12">
        <div class="container">
          <div class="section section-data-tables">
            <div class="row">
              <div class="col s12">
                <div class="card">
                  <div class="card-content">
                    <div class="row">
                      <div class="col s12 overflow">

                        <table id="page-length-option" class="display" style="width:100%">
                          <thead>
                            <tr>
                              <th>Sr</th>
                              <th>Title</th>
                              <th>Author</th>
                              <th>Upvotes</th>
                              <th>Comments</th>
                              <th>Pinned</th>
                              <th>Status</th>
                              <th>Date</th>
                              <th class="text-end">Actions</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (posts.length === 0) { %>
                              <tr>
                                <td colspan="9" class="center-align grey-text" style="padding:40px 0;">
                                  <i class="material-icons" style="font-size:48px; opacity:0.3; display:block; margin-bottom:8px;">inbox</i>
                                  No posts found.
                                </td>
                              </tr>
                            <% } else { %>
                              <% posts.forEach((p, i) => { %>
                              <tr>
                                <td><%= ((currentPage-1)*10) + i + 1 %></td>

                                <td>
                                  <strong style="display:flex; align-items:center; gap:6px;">
                                    <% if (p.isPinned) { %><span style="color:#FFC107;">📌</span><% } %>
                                    <%= p.title.substring(0,45) %><%= p.title.length > 45 ? '…' : '' %>
                                  </strong>
                                  <!-- <% if (!p.author) { %>
                                    <span class="admin-badge">Admin Post</span>
                                  <% } %> -->
                                </td>

                                <td><small style="color:#9e9e9e;">@<%= p.authorName || '—' %></small></td>

                                <td class="center-align"><strong><%= p.upvotes %></strong></td>
                                <td class="center-align"><strong><%= p.commentCount %></strong></td>

                                <td class="center-align">
                                  <% if (p.isPinned) { %>
                                    <span style="background:rgba(255,193,7,0.12); color:#FFC107; border:1px solid rgba(255,193,7,0.3); padding:3px 10px; border-radius:12px; font-size:11px;">Yes</span>
                                  <% } else { %>
                                    —
                                  <% } %>
                                </td>

                                <td>
                                  <% if (p.status === 'pending') { %>
                                    <span class="badge-pending">Pending</span>
                                  <% } else if (p.status === 'approved') { %>
                                    <span class="badge-approved">Approved</span>
                                  <% } else if (p.status === 'rejected') { %>
                                    <span class="badge-rejected">Rejected</span>
                                  <% } %>
                                </td>

                                <td><%= new Date(p.createdAt).toLocaleDateString('en-GB') %></td>

                                <td class="text-end">
                                  <div class="action-btns">

                                    <a href="javascript:void(0)" class="waves-effect waves-light btn-view-post"
                                      data-id="<%= p._id %>" title="View">
                                      <i class="material-icons" style="font-size:18px; color:#2196F3;">remove_red_eye</i>
                                    </a>

                                    <% if (p.status === 'pending') { %>
                                      <form action="/admin/posts/<%= p._id %>/approve" method="POST" style="display:inline; margin:0;">
                                        <button type="submit" class="waves-effect waves-light" title="Approve">
                                          <i class="material-icons" style="font-size:18px; color:#4CAF50;">check_circle</i>
                                        </button>
                                      </form>
                                      <form action="/admin/posts/<%= p._id %>/reject" method="POST" style="display:inline; margin:0;">
                                        <button type="submit" class="waves-effect waves-light" title="Reject">
                                          <i class="material-icons" style="font-size:18px; color:#F44336;">cancel</i>
                                        </button>
                                      </form>
                                    <% } %>


                                    <form action="/admin/posts/<%= p._id %>/delete" method="POST" style="display:inline; margin:0;">
                                      <button type="submit" class="waves-effect waves-light border-none bg-none"
                                        onclick="return confirm('Delete this post?');" title="Delete">
                                        <i class="material-icons" style="font-size:18px; color:#2196F3;">delete</i>
                                      </button>
                                    </form>

                                  </div>
                                </td>
                              </tr>
                              <% }) %>
                            <% } %>
                          </tbody>
                        </table>

                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="content-overlay"></div>
      </div>
    </div>
  </div>

  <%- include('../_layouts/commonJs') %>
  <script src="/app-assets/vendors/data-tables/js/jquery.dataTables.min.js"></script>
  <script src="/app-assets/js/scripts/data-tables.js"></script>

  <script>
    document.querySelectorAll('.btn-view-post').forEach(btn => {
      btn.addEventListener('click', async function () {
        const postId = this.dataset.id;
        try {
          const res = await fetch(`/admin/posts/${postId}/detail`);
          const json = await res.json();
          if (json.success) {
            M.toast({ html: `<b>${json.data.title}</b>`, classes: 'blue' });
          }
        } catch (err) {
          M.toast({ html: 'Failed to load post details', classes: 'red' });
        }
      });
    });
  </script>
</body>
</html>