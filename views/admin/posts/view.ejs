<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>
  <%- include('../_layouts/head') %>
  <title>Post Details | <%= title %></title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

  <style>
    body { padding-top: 78px !important; }
    #main { margin-top: 0 !important; }

    .view-card { border: none; border-radius: 10px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); margin-bottom: 24px; }
    .view-card .card-header { background: #fff; border-bottom: 1px solid #f1f1f1; padding: 16px 20px; border-radius: 10px 10px 0 0; }
    .view-card .card-header h6 { margin: 0; font-weight: 600; font-size: 14px; }
    .view-card .card-body { padding: 20px; }

    .badge-pending   { background:rgba(255,193,7,0.12);  color:#FFC107; border:1px solid rgba(255,193,7,0.3);  padding:4px 12px; border-radius:12px; font-size:11px; font-weight:500; }
    .badge-approved  { background:rgba(76,175,80,0.12);  color:#4CAF50; border:1px solid rgba(76,175,80,0.3);  padding:4px 12px; border-radius:12px; font-size:11px; font-weight:500; }
    .badge-rejected  { background:rgba(244,67,54,0.12);  color:#F44336; border:1px solid rgba(244,67,54,0.3);  padding:4px 12px; border-radius:12px; font-size:11px; font-weight:500; }
    .badge-pinned    { background:rgba(255,193,7,0.12);  color:#FFC107; border:1px solid rgba(255,193,7,0.3);  padding:4px 12px; border-radius:12px; font-size:11px; font-weight:500; }
    .badge-admin     { background:rgba(33,150,243,0.12); color:#2196F3; border:1px solid rgba(33,150,243,0.3); padding:4px 12px; border-radius:12px; font-size:11px; font-weight:500; }
    .badge-active    { background:rgba(76,175,80,0.12);  color:#4CAF50; border:1px solid rgba(76,175,80,0.3);  padding:4px 12px; border-radius:12px; font-size:11px; font-weight:500; }
    .badge-inactive  { background:rgba(158,158,158,0.12);color:#9e9e9e; border:1px solid rgba(158,158,158,0.3);padding:4px 12px; border-radius:12px; font-size:11px; font-weight:500; }

    .stat-box { border-radius: 10px; padding: 16px; text-align: center; }
    .stat-box .stat-value { font-weight: 700; font-size: 20px; }
    .stat-box .stat-label { color:#9e9e9e; font-size: 12px; margin-top:2px; }

    .cover-img-wrap { border-radius: 10px; overflow: hidden; margin-bottom: 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    .cover-img-wrap img { width:100%; max-height:340px; object-fit:cover; display:block; }

    .meta-row { display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid #f5f5f5; }
    .meta-row:last-child { border-bottom:none; }
    .meta-label { color:#9e9e9e; font-size: 13px; }
    .meta-value { font-size: 13px; font-weight: 500; }

    .btn-view-action { border-radius: 8px; font-weight: 500; }

    .post-content-box {
      white-space: pre-wrap; line-height: 1.8; font-size: 14px;
    }

    .toggle-switch-form { display:inline-block; }
    .css-toggle {
      position: relative; display: inline-block; width: 38px; height: 20px;
      border-radius: 12px; transition: background 0.2s ease; flex-shrink: 0;
    }
    .css-toggle.is-on  { background: #FF9800; }
    .css-toggle.is-off { background: #d9d9d9; }
    .css-toggle-knob {
      position: absolute; top: 2px; left: 2px; width: 16px; height: 16px;
      border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,0.25);
      transition: left 0.2s ease;
    }
    .css-toggle.is-on .css-toggle-knob { left: 20px; }
  </style>
</head>

<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
  data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

  <%- include('../partials/header') %>

  <div id="main">
    <div class="row">
      <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
        <div class="container">
          <div class="row">
            <div class="col s12 m6 l6">
              <h5 class="breadcrumbs-title mt-0 mb-0"><span>Post Details</span></h5>
            </div>
            <div class="col s12 m6 l6 right-align-md">
              <ol class="breadcrumbs mb-0">
                <a class="btn btn-outline-secondary pull-right btn-breadcrumbs" href="/admin/posts">
                  <i class="bi bi-arrow-left me-1"></i> Back
                </a>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <div class="col s12">
        <div class="container">
          <div class="section">
            <div class="row">

              <!-- ── LEFT COLUMN ───────────────────────────────────── -->
              <div class="col s12 m12 l8">

                <!-- Cover Image -->
                <% if (post.image) { %>
                <div class="cover-img-wrap">
                  <img src="<%= post.image %>" alt="<%= post.title %>">
                </div>
                <% } %>

                <!-- Title + badges -->
                <div class="card view-card">
                  <div class="card-content" style="padding:20px;">
                    <div class="d-flex flex-wrap" style="gap:8px; margin-bottom:14px;">
                      <% if (post.isPinned) { %>
                        <span class="badge-pinned">📌 Pinned</span>
                      <% } %>
                      <% if (!post.author) { %>
                        <span class="badge-admin">Admin post</span>
                      <% } %>
                      <% if (post.status === 'pending') { %>
                        <span class="badge-pending">Pending</span>
                      <% } else if (post.status === 'approved') { %>
                        <span class="badge-approved">Approved</span>
                      <% } else if (post.status === 'rejected') { %>
                        <span class="badge-rejected">Rejected</span>
                      <% } %>
                      <span class="<%= post.isActive ? 'badge-active' : 'badge-inactive' %>">
                        <%= post.isActive ? 'Active' : 'Hidden' %>
                      </span>
                    </div>

                    <h4 style="font-weight:700; margin-bottom:8px;"><%= post.title %></h4>

                    <div style="color:#9e9e9e; font-size:13px; margin-bottom:16px;">
                      <span style="margin-right:14px;">
                        <i class="bi bi-person me-1"></i>@<%= post.authorName %>
                      </span>
                      <span>
                        <i class="bi bi-calendar3 me-1"></i><%= new Date(post.createdAt).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %>
                      </span>
                    </div>

                    <div class="post-content-box">
                      <%= post.content || post.description || 'No content available.' %>
                    </div>
                  </div>
                </div>

              </div>

              <!-- ── RIGHT COLUMN ──────────────────────────────────── -->
              <div class="col s12 m12 l4">

                <!-- Stats -->
                <div class="card view-card">
                  <div class="card-header">
                    <h6><i class="bi bi-bar-chart me-2" style="color:#2196F3;"></i>Stats</h6>
                  </div>
                  <div class="card-body">
                    <div class="row">
                      <div class="col s6" style="margin-bottom:12px;">
                        <div class="stat-box" style="background:rgba(33,150,243,0.08);">
                          <div class="stat-value" style="color:#2196F3;">👍 <%= post.upvotes || 0 %></div>
                          <div class="stat-label">Upvotes</div>
                        </div>
                      </div>
                      <div class="col s6" style="margin-bottom:12px;">
                        <div class="stat-box" style="background:rgba(76,175,80,0.08);">
                          <div class="stat-value" style="color:#4CAF50;">💬 <%= post.commentCount || 0 %></div>
                          <div class="stat-label">Comments</div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Status & Moderation -->
                <div class="card view-card">
                  <div class="card-header">
                    <h6><i class="bi bi-shield-check me-2" style="color:#607D8B;"></i>Moderation</h6>
                  </div>
                  <div class="card-body">
                    <div class="meta-row">
                      <span class="meta-label">Status</span>
                      <span class="meta-value">
                        <% if (post.status === 'pending') { %>
                          <span class="badge-pending">Pending</span>
                        <% } else if (post.status === 'approved') { %>
                          <span class="badge-approved">Approved</span>
                        <% } else if (post.status === 'rejected') { %>
                          <span class="badge-rejected">Rejected</span>
                        <% } %>
                      </span>
                    </div>
                    <div class="meta-row">
                      <span class="meta-label">Visibility</span>
                      <form action="/admin/posts/<%= post._id %>/toggle" method="POST" class="toggle-switch-form">
                        <button type="submit" style="background:none; border:none; padding:0; margin:0; cursor:pointer; display:inline-flex; align-items:center;"
                          title="<%= post.isActive ? 'Hide' : 'Show' %>">
                          <span class="css-toggle <%= post.isActive ? 'is-on' : 'is-off' %>">
                            <span class="css-toggle-knob"></span>
                          </span>
                        </button>
                      </form>
                    </div>
                    <div class="meta-row">
                      <span class="meta-label">Pinned</span>
                      <span class="meta-value"><%= post.isPinned ? 'Yes' : 'No' %></span>
                    </div>
                  </div>

                  <% if (post.status === 'pending') { %>
                  <div class="card-body" style="padding-top:0; display:flex; gap:10px;">
                    <form action="/admin/posts/<%= post._id %>/approve" method="POST" style="flex:1;">
                      <button type="submit" class="btn btn-view-action" style="width:100%; background:linear-gradient(45deg,#4CAF50,#66BB6A); color:#fff; border:none;">
                        <i class="bi bi-check-circle me-1"></i> Approve
                      </button>
                    </form>
                    <form action="/admin/posts/<%= post._id %>/reject" method="POST" style="flex:1;">
                      <button type="submit" class="btn btn-view-action" style="width:100%; background:linear-gradient(45deg,#F44336,#EF5350); color:#fff; border:none;">
                        <i class="bi bi-x-circle me-1"></i> Reject
                      </button>
                    </form>
                  </div>
                  <% } %>
                </div>

                <!-- Meta -->
                <div class="card view-card">
                  <div class="card-header">
                    <h6><i class="bi bi-info-circle me-2" style="color:#607D8B;"></i>Meta</h6>
                  </div>
                  <div class="card-body">
                    <div class="meta-row">
                      <span class="meta-label">Author</span>
                      <span class="meta-value">@<%= post.authorName %></span>
                    </div>
                    <div class="meta-row">
                      <span class="meta-label">Created</span>
                      <span class="meta-value"><%= new Date(post.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></span>
                    </div>
                    <% if (post.updatedAt) { %>
                    <div class="meta-row">
                      <span class="meta-label">Updated</span>
                      <span class="meta-value"><%= new Date(post.updatedAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></span>
                    </div>
                    <% } %>
                    <div class="meta-row">
                      <span class="meta-label">ID</span>
                      <span class="meta-value" style="font-family:monospace; font-size:11px; color:#9e9e9e;">
                        <%= post._id %>
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Actions -->
                <div style="display:grid; gap:10px;">
                  <% if (post.isActive) { %>
                    <a href="/admin/posts/block/<%= post._id %>"
                      class="btn btn-view-action" style="background:linear-gradient(45deg,#F44336,#EF5350); color:#fff;">
                      <i class="bi bi-slash-circle me-1"></i> Block Post
                    </a>
                  <% } else { %>
                    <a href="/admin/posts/unblock/<%= post._id %>"
                      class="btn btn-view-action" style="background:linear-gradient(45deg,#4CAF50,#66BB6A); color:#fff;">
                      <i class="bi bi-check-circle me-1"></i> Unblock Post
                    </a>
                  <% } %>
                  <form action="/admin/posts/<%= post._id %>/delete" method="POST" onsubmit="return confirm('Delete this post?');">
                    <button type="submit" class="btn btn-outline-danger btn-view-action" style="width:100%;">
                      <i class="bi bi-trash me-1"></i> Delete Post
                    </button>
                  </form>
                  <a href="/admin/posts" class="btn btn-outline-secondary btn-view-action">
                    <i class="bi bi-arrow-left me-1"></i> Back to Posts
                  </a>
                </div>

              </div>
            </div>
          </div>
        </div>
        <div class="content-overlay"></div>
      </div>
    </div>
  </div>

  <%- include('../_layouts/commonJs') %>

</body>
</html>
