<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1 fw-bold">
      <i class="bi bi-lightbulb me-2 text-warning"></i>Idea Details
    </h4>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
        <li class="breadcrumb-item"><a href="/admin/ideas?type=<%= idea.type %>">Ideas</a></li>
        <li class="breadcrumb-item active">View</li>
      </ol>
    </nav>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/ideas/<%= idea._id %>/edit" class="btn btn-primary btn-sm">
      <i class="bi bi-pencil me-1"></i> Edit
    </a>
    <a href="/admin/ideas?type=<%= idea.type %>" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i> Back
    </a>
  </div>
</div>


<div class="row g-4">

  <!-- ── LEFT COLUMN ───────────────────────────────────── -->
  <div class="col-12 col-lg-8">

    <!-- Cover Image -->
    <% if (idea.image) { %>
    <div class="card shadow-sm border-0 mb-4 overflow-hidden">
      <img src="<%= idea.image %>" alt="<%= idea.title %>"
        style="width:100%;max-height:320px;object-fit:cover;">
    </div>
    <% } %>

    <!-- Title + badges -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body">
        <div class="d-flex flex-wrap gap-2 mb-3">
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
            <%= idea.type?.charAt(0).toUpperCase() + idea.type?.slice(1) %>
          </span>
          <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
            <%= idea.category %>
          </span>
          <% if (idea.isFeatured) { %>
            <span class="badge bg-warning text-dark">⭐ Featured</span>
          <% } %>
          <% if (idea.isActive) { %>
            <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
          <% } else { %>
            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Hidden</span>
          <% } %>
          <% if (idea.platform) { %>
            <span class="badge bg-info-subtle text-info border border-info-subtle">
              <i class="bi bi-display me-1"></i><%= idea.platform %>
            </span>
          <% } %>
          <% if (idea.monetization) { %>
            <span class="badge bg-success-subtle text-success border border-success-subtle">
              💰 <%= idea.monetization %>
            </span>
          <% } %>
          <% if (idea.costToBuild) { %>
            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
              🏗 <%= idea.costToBuild %>
            </span>
          <% } %>
        </div>

        <h4 class="fw-bold mb-2"><%= idea.title %></h4>
        <p class="text-muted mb-0"><%= idea.description %></p>

        <% if (idea.tags && idea.tags.length) { %>
        <div class="mt-3 d-flex flex-wrap gap-1">
          <% idea.tags.forEach(tag => { %>
            <span class="badge bg-light text-dark border">#<%= tag %></span>
          <% }) %>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Business Overview -->
    <% if (idea.businessOverview) { %>
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-briefcase me-2 text-primary"></i>Business Overview</h6>
      </div>
      <div class="card-body" style="white-space:pre-wrap;line-height:1.8;">
        <%= idea.businessOverview %>
      </div>
    </div>
    <% } %>

    <!-- Problem & Solution -->
    <% if (idea.problem || idea.solution) { %>
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-exclamation-circle me-2 text-danger"></i>Problem & Solution</h6>
      </div>
      <div class="card-body">
        <% if (idea.problem) { %>
        <div class="mb-4">
          <p class="fw-semibold text-danger mb-1">🔴 The Problem</p>
          <p class="mb-0" style="white-space:pre-wrap;line-height:1.8;"><%= idea.problem %></p>
        </div>
        <% } %>
        <% if (idea.solution) { %>
        <div>
          <p class="fw-semibold text-success mb-1">🟢 The Solution</p>
          <p class="mb-0" style="white-space:pre-wrap;line-height:1.8;"><%= idea.solution %></p>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- How It Works -->
    <% if (idea.howItWorks && idea.howItWorks.length) { %>
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-gear me-2 text-info"></i>How It Works</h6>
      </div>
      <div class="card-body">
        <ol class="mb-0 ps-3">
          <% idea.howItWorks.forEach(step => { %>
            <li class="mb-2" style="line-height:1.7;"><%= step %></li>
          <% }) %>
        </ol>
      </div>
    </div>
    <% } %>

    <!-- Revenue Model -->
    <% if (idea.revenueModel && idea.revenueModel.length) { %>
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-currency-dollar me-2 text-success"></i>Revenue Model</h6>
      </div>
      <div class="card-body">
        <ul class="mb-0 ps-3">
          <% idea.revenueModel.forEach(item => { %>
            <li class="mb-2" style="line-height:1.7;"><%= item %></li>
          <% }) %>
        </ul>
      </div>
    </div>
    <% } %>

    <!-- Tech Stack -->
    <% if (idea.techStack && idea.techStack.length) { %>
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-code-slash me-2 text-primary"></i>Tech Stack</h6>
      </div>
      <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
          <% idea.techStack.forEach(tech => { %>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
              <i class="bi bi-braces me-1"></i><%= tech %>
            </span>
          <% }) %>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Marketing Strategy -->
    <% if (idea.marketingStrategy) { %>
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-megaphone me-2 text-warning"></i>Marketing Strategy</h6>
      </div>
      <div class="card-body" style="white-space:pre-wrap;line-height:1.8;">
        <%= idea.marketingStrategy %>
      </div>
    </div>
    <% } %>

    <!-- Conclusion -->
    <% if (idea.conclusion) { %>
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-flag me-2 text-secondary"></i>Conclusion</h6>
      </div>
      <div class="card-body" style="white-space:pre-wrap;line-height:1.8;">
        <%= idea.conclusion %>
      </div>
    </div>
    <% } %>

  </div>

  <!-- ── RIGHT COLUMN ──────────────────────────────────── -->
  <div class="col-12 col-lg-4">

    <!-- Stats -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-bar-chart me-2 text-primary"></i>Stats</h6>
      </div>
      <div class="card-body">
        <div class="row g-3 text-center">
          <div class="col-6">
            <div class="bg-primary-subtle rounded p-3">
              <div class="fw-bold fs-5 text-primary">👍 <%= idea.upvotes || 0 %></div>
              <div class="text-muted small">Upvotes</div>
            </div>
          </div>
          <div class="col-6">
            <div class="bg-danger-subtle rounded p-3">
              <div class="fw-bold fs-5 text-danger">❤️ <%= idea.likes ? idea.likes.length : 0 %></div>
              <div class="text-muted small">Likes</div>
            </div>
          </div>
          <div class="col-6">
            <div class="bg-warning-subtle rounded p-3">
              <div class="fw-bold fs-5 text-warning">👎 <%= idea.dislikes ? idea.dislikes.length : 0 %></div>
              <div class="text-muted small">Dislikes</div>
            </div>
          </div>
          <div class="col-6">
            <div class="bg-success-subtle rounded p-3">
              <div class="fw-bold fs-5 text-success"><%= idea.profitMargin %>%</div>
              <div class="text-muted small">Profit Margin</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Investment -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-cash-stack me-2 text-success"></i>Investment</h6>
      </div>
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small">Range</span>
          <span class="fw-semibold">
            $<%= idea.investmentMin?.toLocaleString() %> – $<%= idea.investmentMax?.toLocaleString() %>
          </span>
        </div>
        <% if (idea.costToBuild) { %>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small">Cost to Build</span>
          <span class="badge bg-warning-subtle text-warning border border-warning-subtle"><%= idea.costToBuild %></span>
        </div>
        <% } %>
        <div class="d-flex justify-content-between align-items-center">
          <span class="text-muted small">Team Size</span>
          <span class="fw-semibold"><%= idea.teamSize %></span>
        </div>
      </div>
    </div>

    <!-- Execution Breakdown -->
    <% const eb = idea.executionBreakdown; %>
    <% if (eb && (eb.investmentRequired || eb.timeToLaunch || eb.requiredTeam || eb.profitMarginDetail)) { %>
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-list-check me-2 text-info"></i>Execution Breakdown</h6>
      </div>
      <div class="card-body">
        <% if (eb.investmentRequired) { %>
        <div class="mb-3">
          <p class="text-muted small mb-1">💰 Investment Required</p>
          <p class="fw-semibold mb-0"><%= eb.investmentRequired %></p>
        </div>
        <% } %>
        <% if (eb.timeToLaunch) { %>
        <div class="mb-3">
          <p class="text-muted small mb-1">⏱ Time to Launch</p>
          <p class="fw-semibold mb-0"><%= eb.timeToLaunch %></p>
        </div>
        <% } %>
        <% if (eb.requiredTeam) { %>
        <div class="mb-3">
          <p class="text-muted small mb-1">👥 Required Team</p>
          <p class="fw-semibold mb-0"><%= eb.requiredTeam %></p>
        </div>
        <% } %>
        <% if (eb.profitMarginDetail) { %>
        <div>
          <p class="text-muted small mb-1">📈 Profit Margin Detail</p>
          <p class="fw-semibold mb-0"><%= eb.profitMarginDetail %></p>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- Meta -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-info-circle me-2 text-secondary"></i>Meta</h6>
      </div>
      <div class="card-body">
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted small">Created</span>
          <span class="small"><%= new Date(idea.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></span>
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted small">Updated</span>
          <span class="small"><%= new Date(idea.updatedAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></span>
        </div>
        <div class="d-flex justify-content-between">
          <span class="text-muted small">ID</span>
          <span class="small text-muted" style="font-family:monospace;font-size:11px;">
            <%= idea._id %>
          </span>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="d-grid gap-2">
      <a href="/admin/ideas/<%= idea._id %>/edit" class="btn btn-primary">
        <i class="bi bi-pencil me-1"></i> Edit Idea
      </a>
      <a href="/admin/ideas?type=<%= idea.type %>" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Ideas
      </a>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>