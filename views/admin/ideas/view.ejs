<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>
  <%- include('../_layouts/head') %>
  <title>Idea Details | <%= title %></title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

  <style>
    body { padding-top: 78px !important; }
    #main { margin-top: 0 !important; }

    .view-card { border: none; border-radius: 10px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); margin-bottom: 24px; }
    .view-card .card-header { background: #fff; border-bottom: 1px solid #f1f1f1; padding: 16px 20px; border-radius: 10px 10px 0 0; }
    .view-card .card-header h6 { margin: 0; font-weight: 600; font-size: 14px; }
    .view-card .card-body { padding: 20px; }

    .badge-active   { background:rgba(76,175,80,0.12);  color:#4CAF50; border:1px solid rgba(76,175,80,0.3);  padding:4px 12px; border-radius:12px; font-size:11px; font-weight:500; }
    .badge-inactive { background:rgba(158,158,158,0.12);color:#9e9e9e; border:1px solid rgba(158,158,158,0.3);padding:4px 12px; border-radius:12px; font-size:11px; font-weight:500; }
    .badge-featured { background:rgba(255,193,7,0.12);  color:#FFC107; border:1px solid rgba(255,193,7,0.3);  padding:4px 12px; border-radius:12px; font-size:11px; font-weight:500; }
    .badge-type     { background:rgba(99,102,241,0.12); color:#6366f1; border:1px solid rgba(99,102,241,0.3); padding:4px 12px; border-radius:12px; font-size:11px; font-weight:500; }
    .badge-category { background:rgba(33,150,243,0.12); color:#2196F3; border:1px solid rgba(33,150,243,0.3); padding:4px 12px; border-radius:12px; font-size:11px; font-weight:500; }
    .badge-info-soft{ background:rgba(0,188,212,0.12);  color:#00BCD4; border:1px solid rgba(0,188,212,0.3);  padding:4px 12px; border-radius:12px; font-size:11px; font-weight:500; }
    .badge-money    { background:rgba(76,175,80,0.12);  color:#4CAF50; border:1px solid rgba(76,175,80,0.3);  padding:4px 12px; border-radius:12px; font-size:11px; font-weight:500; }
    .badge-cost     { background:rgba(255,152,0,0.12);  color:#FF9800; border:1px solid rgba(255,152,0,0.3);  padding:4px 12px; border-radius:12px; font-size:11px; font-weight:500; }
    .tag-chip       { background:#f5f5f5; color:#555; border:1px solid #e0e0e0; padding:3px 10px; border-radius:10px; font-size:11px; }

    .tech-chip {
      background: rgba(99,102,241,0.08); color:#6366f1; border:1px solid rgba(99,102,241,0.25);
      padding: 6px 14px; border-radius: 8px; font-size: 12px; font-weight: 500;
    }

    .stat-box { border-radius: 10px; padding: 16px; text-align: center; }
    .stat-box .stat-value { font-weight: 700; font-size: 20px; }
    .stat-box .stat-label { color:#9e9e9e; font-size: 12px; margin-top:2px; }

    .cover-img-wrap { border-radius: 10px; overflow: hidden; margin-bottom: 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    .cover-img-wrap img { width:100%; max-height:340px; object-fit:cover; display:block; }

    .meta-row { display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid #f5f5f5; }
    .meta-row:last-child { border-bottom:none; }
    .meta-label { color:#9e9e9e; font-size: 13px; }
    .meta-value { font-size: 13px; font-weight: 500; }

    .btn-view-action { border-radius: 8px; font-weight: 500; }
  </style>
</head>

<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
  data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

  <%- include('../partials/header') %>

  <div id="main">
    <div class="row">
      <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
        <div class="container">
          <div class="row">
            <div class="col s12 m6 l6">
              <h5 class="breadcrumbs-title mt-0 mb-0"><span>Idea Details</span></h5>
            </div>
            <div class="col s12 m6 l6 right-align-md">
              <ol class="breadcrumbs mb-0">
                <a class="btn gradient-45deg-purple-deep-orange pull-right btn-breadcrumbs"
                  style="color:#fff; margin-right:8px;" href="/admin/ideas/<%= idea._id %>/edit">
                  <i class="bi bi-pencil-square me-1"></i> Edit
                </a>
                <a class="btn btn-outline-secondary pull-right btn-breadcrumbs"
                  href="/admin/ideas?type=<%= idea.type %>">
                  <i class="bi bi-arrow-left me-1"></i> Back
                </a>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <div class="col s12">
        <div class="container">
          <div class="section">
            <div class="row">

              <!-- ── LEFT COLUMN ───────────────────────────────────── -->
              <div class="col s12 m12 l8">

                <!-- Cover Image -->
                <% if (idea.image) { %>
                <div class="cover-img-wrap">
                  <img src="<%= idea.image %>" alt="<%= idea.title %>">
                </div>
                <% } %>

                <!-- Title + badges -->
                <div class="card view-card">
                  <div class="card-content" style="padding:20px;">
                    <div class="d-flex flex-wrap" style="gap:8px; margin-bottom:14px;">
                      <span class="badge-type">
                        <%= idea.type ? idea.type.charAt(0).toUpperCase() + idea.type.slice(1) : '' %>
                      </span>
                      <span class="badge-category"><%= idea.category %></span>
                      <% if (idea.isFeatured) { %>
                        <span class="badge-featured">⭐ Featured</span>
                      <% } %>
                      <span class="<%= idea.isActive ? 'badge-active' : 'badge-inactive' %>">
                        <%= idea.isActive ? 'Active' : 'Hidden' %>
                      </span>
                      <% if (idea.platform) { %>
                        <span class="badge-info-soft">
                          <i class="bi bi-display me-1"></i><%= idea.platform %>
                        </span>
                      <% } %>
                      <% if (idea.monetization) { %>
                        <span class="badge-money">💰 <%= idea.monetization %></span>
                      <% } %>
                      <% if (idea.costToBuild) { %>
                        <span class="badge-cost">🏗 <%= idea.costToBuild %></span>
                      <% } %>
                    </div>

                    <h4 style="font-weight:700; margin-bottom:8px;"><%= idea.title %></h4>
                    <p style="color:#9e9e9e; margin-bottom:0; line-height:1.7;"><%= idea.description %></p>

                    <% if (idea.tags && idea.tags.length) { %>
                    <div class="d-flex flex-wrap" style="gap:6px; margin-top:14px;">
                      <% idea.tags.forEach(tag => { %>
                        <span class="tag-chip">#<%= tag %></span>
                      <% }) %>
                    </div>
                    <% } %>
                  </div>
                </div>

                <!-- Business Overview -->
                <% if (idea.businessOverview) { %>
                <div class="card view-card">
                  <div class="card-header">
                    <h6><i class="bi bi-briefcase me-2" style="color:#2196F3;"></i>Business Overview</h6>
                  </div>
                  <div class="card-body" style="white-space:pre-wrap; line-height:1.8;">
                    <%= idea.businessOverview %>
                  </div>
                </div>
                <% } %>

                <!-- Problem & Solution -->
                <% if (idea.problem || idea.solution) { %>
                <div class="card view-card">
                  <div class="card-header">
                    <h6><i class="bi bi-exclamation-circle me-2" style="color:#F44336;"></i>Problem &amp; Solution</h6>
                  </div>
                  <div class="card-body">
                    <% if (idea.problem) { %>
                    <div style="margin-bottom:20px;">
                      <p style="font-weight:600; color:#F44336; margin-bottom:6px;">🔴 The Problem</p>
                      <p style="margin:0; line-height:1.8;"><%= idea.problem %></p>
                    </div>
                    <% } %>
                    <% if (idea.solution) { %>
                    <div>
                      <p style="font-weight:600; color:#4CAF50; margin-bottom:6px;">🟢 The Solution</p>
                      <p style="margin:0; line-height:1.8;"><%= idea.solution %></p>
                    </div>
                    <% } %>
                  </div>
                </div>
                <% } %>

                <!-- How It Works -->
                <% if (idea.howItWorks && idea.howItWorks.length) { %>
                <div class="card view-card">
                  <div class="card-header">
                    <h6><i class="bi bi-gear me-2" style="color:#00BCD4;"></i>How It Works</h6>
                  </div>
                  <div class="card-body">
                    <ol style="margin:0; padding-left:18px;">
                      <% idea.howItWorks.forEach(step => { %>
                        <li style="margin-bottom:10px; line-height:1.7;"><%= step %></li>
                      <% }) %>
                    </ol>
                  </div>
                </div>
                <% } %>

                <!-- Revenue Model -->
                <% if (idea.revenueModel && idea.revenueModel.length) { %>
                <div class="card view-card">
                  <div class="card-header">
                    <h6><i class="bi bi-currency-dollar me-2" style="color:#4CAF50;"></i>Revenue Model</h6>
                  </div>
                  <div class="card-body">
                    <ul style="margin:0; padding-left:18px;">
                      <% idea.revenueModel.forEach(item => { %>
                        <li style="margin-bottom:10px; line-height:1.7;"><%= item %></li>
                      <% }) %>
                    </ul>
                  </div>
                </div>
                <% } %>

                <!-- Tech Stack -->
                <% if (idea.techStack && idea.techStack.length) { %>
                <div class="card view-card">
                  <div class="card-header">
                    <h6><i class="bi bi-code-slash me-2" style="color:#6366f1;"></i>Tech Stack</h6>
                  </div>
                  <div class="card-body">
                    <div class="d-flex flex-wrap" style="gap:8px;">
                      <% idea.techStack.forEach(tech => { %>
                        <span class="tech-chip"><i class="bi bi-braces me-1"></i><%= tech %></span>
                      <% }) %>
                    </div>
                  </div>
                </div>
                <% } %>

                <!-- Marketing Strategy -->
                <% if (idea.marketingStrategy) { %>
                <div class="card view-card">
                  <div class="card-header">
                    <h6><i class="bi bi-megaphone me-2" style="color:#FFC107;"></i>Marketing Strategy</h6>
                  </div>
                  <div class="card-body" style="white-space:pre-wrap; line-height:1.8;">
                    <%= idea.marketingStrategy %>
                  </div>
                </div>
                <% } %>

                <!-- Conclusion -->
                <% if (idea.conclusion) { %>
                <div class="card view-card">
                  <div class="card-header">
                    <h6><i class="bi bi-flag me-2" style="color:#607D8B;"></i>Conclusion</h6>
                  </div>
                  <div class="card-body" style="white-space:pre-wrap; line-height:1.8;">
                    <%= idea.conclusion %>
                  </div>
                </div>
                <% } %>

              </div>

              <!-- ── RIGHT COLUMN ──────────────────────────────────── -->
              <div class="col s12 m12 l4">

                <!-- Stats -->
                <div class="card view-card">
                  <div class="card-header">
                    <h6><i class="bi bi-bar-chart me-2" style="color:#2196F3;"></i>Stats</h6>
                  </div>
                  <div class="card-body">
                    <div class="row">
                      <div class="col s6" style="margin-bottom:12px;">
                        <div class="stat-box" style="background:rgba(33,150,243,0.08);">
                          <div class="stat-value" style="color:#2196F3;">👍 <%= idea.upvotes || 0 %></div>
                          <div class="stat-label">Upvotes</div>
                        </div>
                      </div>
                      <div class="col s6" style="margin-bottom:12px;">
                        <div class="stat-box" style="background:rgba(244,67,54,0.08);">
                          <div class="stat-value" style="color:#F44336;">❤️ <%= idea.likes ? idea.likes.length : 0 %></div>
                          <div class="stat-label">Likes</div>
                        </div>
                      </div>
                      <div class="col s6">
                        <div class="stat-box" style="background:rgba(255,193,7,0.08);">
                          <div class="stat-value" style="color:#FFC107;">👎 <%= idea.dislikes ? idea.dislikes.length : 0 %></div>
                          <div class="stat-label">Dislikes</div>
                        </div>
                      </div>
                      <div class="col s6">
                        <div class="stat-box" style="background:rgba(76,175,80,0.08);">
                          <div class="stat-value" style="color:#4CAF50;"><%= idea.profitMargin %>%</div>
                          <div class="stat-label">Profit Margin</div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Investment -->
                <div class="card view-card">
                  <div class="card-header">
                    <h6><i class="bi bi-cash-stack me-2" style="color:#4CAF50;"></i>Investment</h6>
                  </div>
                  <div class="card-body">
                    <div class="meta-row">
                      <span class="meta-label">Range</span>
                      <span class="meta-value">
                        $<%= idea.investmentMin?.toLocaleString() %> – $<%= idea.investmentMax?.toLocaleString() %>
                      </span>
                    </div>
                    <% if (idea.costToBuild) { %>
                    <div class="meta-row">
                      <span class="meta-label">Cost to Build</span>
                      <span class="badge-cost"><%= idea.costToBuild %></span>
                    </div>
                    <% } %>
                    <div class="meta-row">
                      <span class="meta-label">Team Size</span>
                      <span class="meta-value"><%= idea.teamSize %></span>
                    </div>
                  </div>
                </div>

                <!-- Execution Breakdown -->
                <% const eb = idea.executionBreakdown; %>
                <% if (eb && (eb.investmentRequired || eb.timeToLaunch || eb.requiredTeam || eb.profitMarginDetail)) { %>
                <div class="card view-card">
                  <div class="card-header">
                    <h6><i class="bi bi-list-check me-2" style="color:#00BCD4;"></i>Execution Breakdown</h6>
                  </div>
                  <div class="card-body">
                    <% if (eb.investmentRequired) { %>
                    <div style="margin-bottom:16px;">
                      <p style="color:#9e9e9e; font-size:12px; margin-bottom:4px;">💰 Investment Required</p>
                      <p style="font-weight:600; margin:0;"><%= eb.investmentRequired %></p>
                    </div>
                    <% } %>
                    <% if (eb.timeToLaunch) { %>
                    <div style="margin-bottom:16px;">
                      <p style="color:#9e9e9e; font-size:12px; margin-bottom:4px;">⏱ Time to Launch</p>
                      <p style="font-weight:600; margin:0;"><%= eb.timeToLaunch %></p>
                    </div>
                    <% } %>
                    <% if (eb.requiredTeam) { %>
                    <div style="margin-bottom:16px;">
                      <p style="color:#9e9e9e; font-size:12px; margin-bottom:4px;">👥 Required Team</p>
                      <p style="font-weight:600; margin:0;"><%= eb.requiredTeam %></p>
                    </div>
                    <% } %>
                    <% if (eb.profitMarginDetail) { %>
                    <div>
                      <p style="color:#9e9e9e; font-size:12px; margin-bottom:4px;">📈 Profit Margin Detail</p>
                      <p style="font-weight:600; margin:0;"><%= eb.profitMarginDetail %></p>
                    </div>
                    <% } %>
                  </div>
                </div>
                <% } %>

                <!-- Meta -->
                <div class="card view-card">
                  <div class="card-header">
                    <h6><i class="bi bi-info-circle me-2" style="color:#607D8B;"></i>Meta</h6>
                  </div>
                  <div class="card-body">
                    <div class="meta-row">
                      <span class="meta-label">Created</span>
                      <span class="meta-value"><%= new Date(idea.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></span>
                    </div>
                    <div class="meta-row">
                      <span class="meta-label">Updated</span>
                      <span class="meta-value"><%= new Date(idea.updatedAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></span>
                    </div>
                    <div class="meta-row">
                      <span class="meta-label">ID</span>
                      <span class="meta-value" style="font-family:monospace; font-size:11px; color:#9e9e9e;">
                        <%= idea._id %>
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Actions -->
                <div style="display:grid; gap:10px;">
                  <a href="/admin/ideas/<%= idea._id %>/edit" class="btn gradient-45deg-purple-deep-orange btn-view-action" style="color:#fff;">
                    <i class="bi bi-pencil me-1"></i> Edit Idea
                  </a>
                  <a href="/admin/ideas?type=<%= idea.type %>" class="btn btn-outline-secondary btn-view-action">
                    <i class="bi bi-arrow-left me-1"></i> Back to Ideas
                  </a>
                </div>

              </div>
            </div>
          </div>
        </div>
        <div class="content-overlay"></div>
      </div>
    </div>
  </div>

  <%- include('../_layouts/commonJs') %>

</body>
</html>
