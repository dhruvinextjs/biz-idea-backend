<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>

<body
  class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns">

  <%- include('../partials/header') %>

    <div id="main">

      <div class="row">

        <div id="breadcrumbs-wrapper">

          <div class="container">

            <div class="row">

              <div class="col s12 m6 l6">
                <h5 class="breadcrumbs-title mt-0 mb-0">
                  <span>
                    <%= idea ? 'Edit Idea' : 'Create Idea' %>
                  </span>
                </h5>
              </div>

              <div class="col s12 m6 l6 right-align-md">
                <ol class="breadcrumbs mb-0">

                  <li class="breadcrumb-item">
                    <a href="/admin">
                      Home
                    </a>
                  </li>

                  <li class="breadcrumb-item">
                    <a href="/admin/ideas">
                      Ideas
                    </a>
                  </li>

                  <li class="breadcrumb-item active">
                    <%= idea ? 'Edit Idea' : 'Create Idea' %>
                  </li>

                </ol>
              </div>

            </div>

          </div>

        </div>

        <div class="container">

          <div class="section">

            <div class="row">

              <div class="col s12">
                <% if (success && success.length) { %>
                  <div class="card-panel green white-text">
                    <%= success[0] %>
                  </div>
                  <% } %>

                    <% if (error && error.length) { %>
                      <div class="card-panel red white-text">
                        <%= error[0] %>
                      </div>
                      <% } %>
              </div>

            </div>

            <form method="POST" id="form" enctype="multipart/form-data"
              action="/admin/ideas/<%= idea ? idea._id + '/edit' : 'create' %>">

              <div class="col s12">

                <div class="card">

                  <div class="card-content">

                    <div class="row">

                      <!-- Title -->

                      <div class="input-field col m12 s12">

                        <input id="title" name="title" type="text" value="<%= idea ? idea.title : '' %>" required>

                        <label class="<%= idea ? 'active' : '' %>" for="title">
                          Title
                        </label>

                      </div>

                      <!-- Type -->

                      <div class="input-field col m6 s12">

                        <select id="type" name="type">

                          <option value="business">
                            Business Idea
                          </option>

                          <option value="app">
                            App Idea
                          </option>

                          <option value="startup">
                            Startup Idea
                          </option>

                        </select>

                        <label>
                          Idea Type
                        </label>

                      </div>

                      <!-- Category -->

                      <div class="input-field col m6 s12">

                        <select name="category">

                          <option value="AI & Tech">
                            AI & Tech
                          </option>

                          <option value="SaaS">
                            SaaS
                          </option>

                          <option value="E-Commerce">
                            E-Commerce
                          </option>

                          <option value="Local Business">
                            Local Business
                          </option>

                          <option value="Services">
                            Services
                          </option>

                          <option value="Other">
                            Other
                          </option>

                        </select>

                        <label>
                          Category
                        </label>

                      </div>

                      <!-- Description -->

                      <div class="input-field col s12">

                        <textarea id="description" name="description"
                          class="materialize-textarea"><%= idea ? idea.description : '' %></textarea>

                        <label class="<%= idea ? 'active' : '' %>">
                          Short Description
                        </label>

                      </div>

                      <!-- Full Description -->

                      <div class="input-field col s12">

                        <textarea id="fullDescription" name="fullDescription"
                          class="materialize-textarea"><%= idea ? idea.fullDescription : '' %></textarea>

                        <label class="<%= idea ? 'active' : '' %>">
                          Full Description
                        </label>

                      </div>

                      <!-- Investment -->

                      <div class="input-field col m4 s12">
                        <input type="number" name="investmentMin">
                        <label class="active">
                          Min Investment
                        </label>
                      </div>

                      <div class="input-field col m4 s12">
                        <input type="number" name="investmentMax">
                        <label class="active">
                          Max Investment
                        </label>
                      </div>

                      <div class="input-field col m4 s12">
                        <input type="number" name="profitMargin">
                        <label class="active">
                          Profit Margin %
                        </label>
                      </div>

                      <!-- Team Size -->

                      <div class="input-field col m6 s12">

                        <select name="teamSize">
                          <option>Solo (1)</option>
                          <option>Small (2-5)</option>
                          <option>Medium (6-15)</option>
                          <option>Large (15+)</option>
                        </select>

                        <label>
                          Team Size
                        </label>

                      </div>

                      <!-- Image Upload -->

                      <div class="input-field col m6 s12">

                        Idea Image

                        <input type="file" name="image" class="dropify" accept="image/*" />

                      </div>

                      <!-- Tags -->

                      <div class="input-field col s12">

                        <input type="text" name="tags">

                        <label>
                          Tags
                        </label>

                      </div>

                      <!-- Active -->

                      <div class="col m6 s12">

                        <p>

                          <label>

                            <input type="checkbox" name="isActive" checked>

                            <span>
                              Active
                            </span>

                          </label>

                        </p>

                      </div>

                      <!-- Featured -->

                      <div class="col m6 s12">

                        <p>

                          <label>

                            <input type="checkbox" name="isFeatured">

                            <span>
                              Featured
                            </span>

                          </label>

                        </p>

                      </div>

                      <!-- Buttons -->

                      <div class="col s12">

                        <button type="submit" class="btn purple">
                          Save Idea
                        </button>

                        <a onclick="history.back()" class="btn red">
                          Cancel
                        </a>

                      </div>

                    </div>

                  </div>

                </div>

              </div>

            </form>

          </div>

        </div>

      </div>

    </div>
</body>

</html>