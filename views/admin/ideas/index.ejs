<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>
  <%- include('../_layouts/head') %>
  <title>Ideas | <%= title %></title>

  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/jquery.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/extensions/responsive/css/responsive.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/select.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="/app-assets/css/pages/data-tables.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

  <style>
    body { padding-top: 78px !important; }
    #main { margin-top: 0 !important; }
    .badge-active   { background:rgba(76,175,80,0.12);  color:#4CAF50; border:1px solid rgba(76,175,80,0.3);  padding:3px 10px; border-radius:12px; font-size:11px; }
    .badge-inactive { background:rgba(158,158,158,0.12);color:#9e9e9e; border:1px solid rgba(158,158,158,0.3);padding:3px 10px; border-radius:12px; font-size:11px; }
    .badge-featured { background:rgba(255,193,7,0.12);  color:#FFC107; border:1px solid rgba(255,193,7,0.3);  padding:3px 10px; border-radius:12px; font-size:11px; }
    .type-tabs { display:flex; gap:8px; margin-bottom:12px; }
    .type-tab { padding:5px 18px; border-radius:20px; font-size:13px; font-weight:500; text-decoration:none; border:1px solid #e2e8f0; color:#475569; transition:all 0.2s; }
    .type-tab.active, .type-tab:hover { background:#6366f1; color:#fff; border-color:#6366f1; }
  </style>
</head>

<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
  data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

  <%- include('../partials/header') %>

  <div id="main">
    <div class="row">
      <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
        <div class="container">
          <div class="row">
            <div class="col s12 m6 l6">
              <h5 class="breadcrumbs-title mt-0 mb-0"><span>Ideas Management</span></h5>
            </div>
            <div class="col s12 m6 l6 right-align-md">
              <ol class="breadcrumbs mb-0">
                <a class="btn gradient-45deg-purple-deep-orange pull-right btn-breadcrumbs"
                  style="color:#fff;" href="/admin/ideas/create?type=<%= type %>">
                  Add New Idea
                </a>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <div class="col s12">
        <div class="container">
          <div class="section section-data-tables">
            <div class="row">
              <div class="col s12">

                <!-- Type Tabs -->
                <div class="type-tabs">
                  <a href="/admin/ideas?type=business" class="type-tab <%= type === 'business' ? 'active' : '' %>">
                    <i class="bi bi-briefcase me-1"></i>Business
                  </a>
                  <a href="/admin/ideas?type=app" class="type-tab <%= type === 'app' ? 'active' : '' %>">
                    <i class="bi bi-phone me-1"></i>App
                  </a>
                  <a href="/admin/ideas?type=startup" class="type-tab <%= type === 'startup' ? 'active' : '' %>">
                    <i class="bi bi-rocket me-1"></i>Startup
                  </a>
                </div>

                <div class="card">
                  <div class="card-content">
                    <div class="row">
                      <div class="col s12 overflow">
                        <table id="page-length-option" class="display" style="width:100%">
                          <thead>
                            <tr>
                              <th>#</th>
                              <th>Idea</th>
                              <th>Category</th>
                              <th>Investment</th>
                              <th>Margin</th>
                              <th>Featured</th>
                              <th>Status</th>
                              <th>Action</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% ideas.forEach((idea, i) => { %>
                            <tr>
                              <td><%= ((currentPage - 1) * 10) + i + 1 %></td>
                              <td>
                                <strong><%= idea.title.substring(0, 45) %><%= idea.title.length > 45 ? '…' : '' %></strong>
                                <!-- <div style="font-size:12px; color:#9e9e9e;"><%= idea.teamSize %></div>
                                <small style="color:#9e9e9e;">
                                  <%= idea.description ? idea.description.substring(0, 70) + '...' : '' %>
                                </small> -->
                              </td>
                              <td><%= idea.category %></td>
                              <td style="white-space:nowrap;">
                                $<%= idea.investmentMin.toLocaleString() %> – $<%= idea.investmentMax.toLocaleString() %>
                              </td>
                              <td><strong><%= idea.profitMargin %>%</strong></td>
                              <td>
                                <% if (idea.isFeatured) { %>
                                  <span class="badge-featured">Featured</span>
                                <% } else { %>
                                  <span class="badge-inactive">No</span>
                                <% } %>
                              </td>
                              <td>
                                <span class="<%= idea.isActive ? 'badge-active' : 'badge-inactive' %>">
                                  <%= idea.isActive ? 'Active' : 'Hidden' %>
                                </span>
                              </td>
                              <td style="white-space:nowrap;">
                                <div style="display:flex; align-items:center; gap:8px;">
                                  <a href="/admin/ideas/<%= idea._id %>/view" class="waves-effect waves-light" title="View">
                                    <i class="material-icons" style="font-size:18px; color:#2196F3;">remove_red_eye</i>
                                  </a>
                                  <a href="/admin/ideas/<%= idea._id %>/edit" class="waves-effect waves-light" title="Edit">
                                    <i class="material-icons" style="font-size:18px; color:#2196F3;">edit</i>
                                  </a>
                                  <form action="/admin/ideas/<%= idea._id %>/delete?type=<%= type %>" method="POST" style="display:inline; margin:0;">
                                    <button type="submit" class="waves-effect waves-light"
                                      style="background:none; border:none; padding:0; margin:0; cursor:pointer;"
                                      title="Delete" onclick="return confirm('Delete this idea?');">
                                      <i class="material-icons" style="font-size:18px; color:#2196F3;">delete</i>
                                    </button>
                                  </form>
                                </div>
                              </td>
                            </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>
        <div class="content-overlay"></div>
      </div>
    </div>
  </div>

  <%- include('../_layouts/commonJs') %>
  <script src="/app-assets/vendors/data-tables/js/jquery.dataTables.min.js"></script>
  <script src="/app-assets/js/scripts/data-tables.js"></script>

</body>
</html>
