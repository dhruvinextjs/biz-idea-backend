<%- include('../partials/header') %>

<style>
.idea-header{
    background:#090e2d;
    border-radius:24px;
    padding:28px;
    color:#fff;
    margin-bottom:24px;
    position:relative;
    overflow:hidden;
}

.idea-header::before{
    content:"";
    position:absolute;
    right:-40px;
    top:-40px;
    width:180px;
    height:180px;
    border-radius:50%;
    background:rgba(253,115,6,.12);
}

.idea-header::after{
    content:"";
    position:absolute;
    left:-30px;
    bottom:-30px;
    width:120px;
    height:120px;
    border-radius:50%;
    background:rgba(253,115,6,.08);
}

.idea-card{
    border:none;
    border-radius:24px;
    overflow:hidden;
    box-shadow:
    0 10px 25px rgba(9,14,45,.06),
    0 20px 60px rgba(9,14,45,.08);
}

.idea-card .card-header{
    background:#fff;
    border-bottom:1px solid #eef2f7;
}

.type-btn{
    border-radius:999px;
    padding:.7rem 1.3rem;
    font-weight:600;
    transition:.3s;
}

.type-btn.btn-primary{
    background:#fd7306;
    border-color:#fd7306;
}

.type-btn.btn-primary:hover{
    background:#e56400;
    border-color:#e56400;
}

.btn-primary{
    background:#fd7306;
    border-color:#fd7306;
}

.btn-primary:hover{
    background:#e56400;
    border-color:#e56400;
}

.badge.bg-primary{
    background:#090e2d !important;
}

.table thead th{
    background:#f8f9fc;
    color:#090e2d;
    font-weight:700;
    border:none;
}

.table tbody tr{
    transition:.25s;
}

.table tbody tr:hover{
    background:#fff8f3;
}

.action-btn{
    width:38px;
    height:38px;
    border-radius:12px;
}

.action-btn.btn-outline-primary{
    color:#090e2d;
    border-color:#090e2d;
}

.action-btn.btn-outline-primary:hover{
    background:#090e2d;
    color:#fff;
}

.action-btn.btn-outline-danger:hover{
    color:#fff;
}

.idea-title{
    font-weight:700;
    color:#090e2d;
}

.pagination .page-item.active .page-link{
    background:#fd7306;
    border-color:#fd7306;
}

.pagination .page-link{
    color:#090e2d;
}

.stats-card{
    border:none;
    border-radius:20px;
    padding:20px;
    background:#fff;
    box-shadow:0 8px 30px rgba(0,0,0,.05);
}

.stats-card h3{
    color:#090e2d;
    font-weight:800;
}

.stats-icon{
    width:55px;
    height:55px;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(253,115,6,.12);
    color:#fd7306;
    font-size:22px;
}

@media(max-width:768px){
    .idea-header{
        text-align:center;
    }
}
</style>

<div class="idea-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
    <div>
        <h3 class="fw-bold mb-1">
            <i class="bi bi-lightbulb-fill me-2"></i>
            Idea Management
        </h3>
        <p class="mb-0 opacity-75">
            Manage all your business, app and startup ideas
        </p>
    </div>

<a href="/admin/ideas/create?type=<%= type %>" class="btn btn-light fw-semibold">
    <i class="bi bi-plus-lg me-1"></i>
    Add New Idea
</a>


</div>

<div class="mb-4 d-flex flex-wrap gap-2">
    <a href="/admin/ideas?type=business" class="btn type-btn <%= type === 'business' ? 'btn-primary' : 'btn-outline-primary' %>">
         Business
    </a>

<a href="/admin/ideas?type=app" class="btn type-btn <%= type === 'app' ? 'btn-primary' : 'btn-outline-primary' %>">
     App
</a>

<a href="/admin/ideas?type=startup" class="btn type-btn <%= type === 'startup' ? 'btn-primary' : 'btn-outline-primary' %>">
     Startup
</a>


</div>

<div class="card idea-card">
    <div class="card-header bg-white border-0 py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Ideas List</h5>
            <span class="badge bg-primary"><%= ideas.length %> Records</span>
        </div>
    </div>


<div class="table-responsive">
    <table class="table idea-table table-hover mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>Idea</th>
                <th>Category</th>
                <th>Investment</th>
                <th>Margin</th>
                <th>Featured</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            <% if (ideas.length === 0) { %>
                <tr>
                    <td colspan="8" class="text-center py-5 text-muted">
                        No ideas found.
                    </td>
                </tr>
            <% } %>

            <% ideas.forEach((idea, i) => { %>

            <tr>
                <td>
                    <%= ((currentPage-1)*10)+i+1 %>
                </td>

                <td>
                    <div class="idea-title">
                        <%= idea.title.substring(0,45) %><%= idea.title.length > 45 ? '...' : '' %>

                        <small class="text-muted">
                            <%= idea.teamSize %>
                        </small>
                    </div>
                </td>

                <td>
                    <span class="badge bg-light text-dark border">
                        <%= idea.category %>
                    </span>
                </td>

                <td>
                    $<%= idea.investmentMin.toLocaleString() %> -
                    $<%= idea.investmentMax.toLocaleString() %>
                </td>

                <td>
                    <strong><%= idea.profitMargin %>%</strong>
                </td>

                <td>
                    <% if (idea.isFeatured) { %>
                        <span class="badge bg-warning text-dark">
                             Featured
                        </span>
                    <% } else { %>
                        <span class="badge bg-light text-secondary">
                            No
                        </span>
                    <% } %>
                </td>

                <td>
                    <span class="badge <%= idea.isActive ? 'bg-success' : 'bg-secondary' %>">
                        <%= idea.isActive ? 'Active' : 'Hidden' %>
                    </span>
                </td>

                <td>
                    <div class="d-flex gap-2">

                        <a href="/admin/ideas/<%= idea._id %>/edit"
                           class="btn btn-outline-primary btn-sm action-btn">
                            <i class="bi bi-pencil"></i>
                        </a>

                        <form action="/admin/ideas/<%= idea._id %>/delete?type=<%= type %>" method="POST">

                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm action-btn btn-delete">
                                <i class="bi bi-trash"></i>
                            </button>

                        </form>

                    </div>
                </td>
            </tr>

            <% }) %>
        </tbody>
    </table>
</div>


</div>

<% if (totalPages > 1) { %>

<nav class="mt-4">
    <ul class="pagination justify-content-center">
        <% for(let i=1;i<=totalPages;i++){ %>
            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                <a class="page-link"
                   href="/admin/ideas?type=<%= type %>&page=<%= i %>">
                    <%= i %>
                </a>
            </li>
        <% } %>
    </ul>
</nav>
<% } %>

<%- include('../partials/footer') %>
