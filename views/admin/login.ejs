```ejs
<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>
    <%- include('_layouts/head') %>
    <title>Login | BizIdeas Admin</title>

    <link rel="stylesheet" type="text/css" href="/app-assets/css/pages/login.css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>

<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 1-column login-bg blank-page blank-page"
    data-open="click"
    data-menu="vertical-dark-menu"
    data-col="1-column">

    <div class="row login-container">
        <div class="col s12">

            <div class="container">
                <div id="login-page" class="row">

                    <div class="col s12 m6 l4 z-depth-4 card-panel border-radius-6 login-card bg-opacity-8"
                        style="background-color: white;">

                        <form class="login-form"
                            id="loginform"
                            action="/admin/login"
                            method="POST"
                            onsubmit="return validate()">

                            <div class="row">

                                <div class="s12" style="text-align:center;">
                                    <br>
                                    <img src="/img/Logo.png" width="40%" />
                                </div>

                                <div class="col s12" style="text-align:center;margin-bottom:20px;">
                                    <br>
                                    <span style="font-size:22px;font-weight:900;color:black;">
                                        ADMIN LOGIN
                                    </span>
                                </div>

                            </div>

                            <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
                                <div class="card-alert card red lighten-5">
                                    <div class="card-content red-text">
                                        <p>
                                            <i class="material-icons">error</i>
                                            <%= error %>
                                        </p>
                                    </div>
                                </div>
                            <% } %>

                            <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
                                <div class="card-alert card green lighten-5">
                                    <div class="card-content green-text">
                                        <p>
                                            <i class="material-icons">check_circle</i>
                                            <%= success %>
                                        </p>
                                    </div>
                                </div>
                            <% } %>

                            <div class="row margin">
                                <div class="input-field col s12">

                                    <i class="material-icons prefix pt-2">
                                        person_outline
                                    </i>

                                    <input
                                        id="email"
                                        type="text"
                                        name="email"
                                        autocomplete="username">

                                    <label for="email">
                                        Email Address
                                    </label>

                                    <small>
                                        <div id="error1"
                                            class="error"
                                            style="margin-left:3rem;color:red;">
                                        </div>
                                    </small>

                                </div>
                            </div>

                            <div class="row margin">
                                <div class="input-field col s12">

                                    <i class="material-icons prefix pt-2">
                                        lock_outline
                                    </i>

                                    <input
                                        id="pass"
                                        type="password"
                                        name="password"
                                        autocomplete="current-password">

                                    <label for="pass">
                                        Password
                                    </label>

                                    <i class="material-icons toggle-password"
                                        style="position:absolute;
                                               right:20px;
                                               top:50%;
                                               transform:translateY(-50%);
                                               cursor:pointer;
                                               user-select:none;">
                                        visibility_off
                                    </i>

                                    <small>
                                        <div id="error2"
                                            class="error"
                                            style="margin-left:3rem;color:red;">
                                        </div>
                                    </small>

                                </div>
                            </div>

                            <div class="row">
                                <div class="input-field col s12 mb-10">

                                    <button
                                        class="btn waves-effect waves-light border-round col s12"
                                        type="submit"
                                        id="submitBtn"
                                        style="background-color:#3D3D3D;">

                                        Log In

                                    </button>

                                </div>
                            </div>

                        </form>

                    </div>

                </div>
            </div>

            <div class="content-overlay"></div>

        </div>
    </div>

    <script>
        const form = document.getElementById('loginform');

        function validate() {

            let returnVal = true;

            const email = document.getElementById('email');
            const password = document.getElementById('pass');

            const emailValue = email.value.trim();
            const passwordValue = password.value.trim();

            const error1 = document.getElementById('error1');
            const error2 = document.getElementById('error2');

            if (emailValue === '') {
                error1.innerText = 'Please enter email.';
                returnVal = false;
            } else if (!validateEmail(emailValue)) {
                error1.innerText = 'Please enter valid email.';
                returnVal = false;
            } else {
                error1.innerText = '';
            }

            if (passwordValue === '') {
                error2.innerText = 'Please enter password.';
                returnVal = false;
            } else if (passwordValue.length < 6) {
                error2.innerText = 'Password must be at least 6 characters.';
                returnVal = false;
            } else {
                error2.innerText = '';
            }

            if (returnVal) {
                document.getElementById('submitBtn').disabled = true;
                document.getElementById('submitBtn').innerText = 'Logging in...';
            }

            return returnVal;
        }

        function validateEmail(email) {
            return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        }

        const togglePassword =
            document.querySelector('.toggle-password');

        const passwordInput =
            document.querySelector('#pass');

        togglePassword.addEventListener('click', function () {

            const type =
                passwordInput.getAttribute('type') === 'password'
                    ? 'text'
                    : 'password';

            passwordInput.setAttribute('type', type);

            this.textContent =
                type === 'password'
                    ? 'visibility_off'
                    : 'visibility';
        });
    </script>

    <%- include('_layouts/commonJs') %>

</body>

</html>
```
