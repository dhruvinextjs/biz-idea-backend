<%- include('./partials/header') %>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-4 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon bg-primary bg-opacity-10 text-primary mb-2">👥</div>
      <div class="stat-value"><%= stats.totalUsers %></div>
      <div class="stat-label">Users</div>
    </div>
  </div>
  <div class="col-6 col-md-4 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon bg-warning bg-opacity-10 text-warning mb-2">💡</div>
      <div class="stat-value"><%= stats.totalIdeas %></div>
      <div class="stat-label">Ideas</div>
    </div>
  </div>
  <div class="col-6 col-md-4 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon bg-success bg-opacity-10 text-success mb-2">📖</div>
      <div class="stat-value"><%= stats.totalCaseStudies %></div>
      <div class="stat-label">Case Studies</div>
    </div>
  </div>
  <div class="col-6 col-md-4 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon bg-info bg-opacity-10 text-info mb-2">✍️</div>
      <div class="stat-value"><%= stats.totalBlogs %></div>
      <div class="stat-label">Blogs</div>
    </div>
  </div>
  <div class="col-6 col-md-4 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon bg-danger bg-opacity-10 text-danger mb-2">📨</div>
      <div class="stat-value"><%= stats.newContacts %></div>
      <div class="stat-label">New Enquiries</div>
    </div>
  </div>
  <div class="col-6 col-md-4 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon bg-purple bg-opacity-10 mb-2" style="color:#8b5cf6">🔔</div>
      <div class="stat-value"><%= stats.totalNewsletterSubs %></div>
      <div class="stat-label">Subscribers</div>
    </div>
  </div>
</div>

<div class="row g-3">
  <!-- Quick Actions -->
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-header">⚡ Quick Actions</div>
      <div class="card-body d-grid gap-2">
        <a href="/admin/ideas/create?type=business" class="btn btn-outline-primary btn-sm text-start"><i class="bi bi-plus-circle me-2"></i>Add Business Idea</a>
        <a href="/admin/ideas/create?type=app" class="btn btn-outline-primary btn-sm text-start"><i class="bi bi-plus-circle me-2"></i>Add App Idea</a>
        <a href="/admin/ideas/create?type=startup" class="btn btn-outline-primary btn-sm text-start"><i class="bi bi-plus-circle me-2"></i>Add Startup Idea</a>
        <a href="/admin/case-studies/create" class="btn btn-outline-success btn-sm text-start"><i class="bi bi-plus-circle me-2"></i>Add Case Study</a>
        <a href="/admin/blogs/create" class="btn btn-outline-info btn-sm text-start"><i class="bi bi-plus-circle me-2"></i>Add Blog Post</a>
        <a href="/admin/services/create" class="btn btn-outline-secondary btn-sm text-start"><i class="bi bi-plus-circle me-2"></i>Add Service</a>
      </div>
    </div>
  </div>

  <!-- Recent Users -->
  <div class="col-md-8">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        👤 Recent Users
        <a href="/admin/users" class="btn btn-sm btn-outline-primary">View All</a>
      </div>
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Joined</th></tr></thead>
          <tbody>
            <% recentUsers.forEach(u => { %>
            <tr>
              <td><strong><%= u.name %></strong><br><small class="text-muted">@<%= u.username %></small></td>
              <td><%= u.email %></td>
              <td><span class="badge bg-<%= u.role === 'admin' ? 'danger' : 'secondary' %>"><%= u.role %></span></td>
              <td><span class="badge <%= u.isActive ? 'badge-active' : 'badge-inactive' %>"><%= u.isActive ? 'Active' : 'Inactive' %></span></td>
              <td><%= new Date(u.createdAt).toLocaleDateString() %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Recent Ideas -->
  <div class="col-12">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        💡 Recent Ideas
        <a href="/admin/ideas" class="btn btn-sm btn-outline-primary">View All</a>
      </div>
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead><tr><th>Title</th><th>Type</th><th>Category</th><th>Investment</th><th>Margin</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody>
            <% recentIdeas.forEach(idea => { %>
            <tr>
              <td><strong><%= idea.title.substring(0,50) %><%= idea.title.length > 50 ? '...' : '' %></strong></td>
              <td><span class="badge bg-primary"><%= idea.type %></span></td>
              <td><%= idea.category %></td>
              <td>$<%= idea.investmentMin.toLocaleString() %> - $<%= idea.investmentMax.toLocaleString() %></td>
              <td><%= idea.profitMargin %>%</td>
              <td><span class="badge <%= idea.isActive ? 'badge-active' : 'badge-inactive' %>"><%= idea.isActive ? 'Active' : 'Inactive' %></span></td>
              <td>
                <a href="/admin/ideas/<%= idea._id %>/edit" class="btn btn-xs btn-outline-secondary btn-sm py-0">Edit</a>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('./partials/footer') %>
