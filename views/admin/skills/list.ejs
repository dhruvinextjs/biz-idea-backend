<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="mb-1">Skills Management</h5>
    <span class="text-muted small">
      Total: <strong><%= skills ? skills.length : 0 %></strong> skills 
      <span class="mx-2">•</span> 
      Shown in Signup Step 4
    </span>
  </div>
  <a href="/admin/skills/create" class="btn btn-primary btn-sm">
    <i class="bi bi-plus-lg me-1"></i>Add New Skill
  </a>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th width="70">Icon</th>
            <th>Name</th>
            <th>Category</th>
            <th width="110">Status</th>
            <th width="130">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if(!skills || skills.length === 0){ %>
            <tr>
              <td colspan="6" class="text-center text-muted py-5">
                No skills found yet.<br>
                <a href="/admin/skills/create" class="text-primary">Add your first skill →</a>
              </td>
            </tr>
          <% } else { %>
            <% skills.forEach(s => { %>
            <tr>
              <td><span style="font-size:1.55rem"><%= s.icon || '📌' %></span></td>
              <td><span class="fw-semibold"><%= s.name %></span></td>
              <td><span class="badge bg-secondary-subtle text-secondary"><%= s.category %></span></td>
             
              <td>
                <% if(s.isActive){ %>
                  <span class="badge badge-active">Active</span>
                <% } else { %>
                  <span class="badge badge-inactive">Inactive</span>
                <% } %>
              </td>
              <td>
                <a href="/admin/skills/edit/<%= s._id %>" class="btn btn-sm btn-outline-secondary me-1">
                  <i class="bi bi-pencil"></i>
                </a>
                <form action="/admin/skills/delete/<%= s._id %>" method="POST" class="d-inline" 
                      onsubmit="return confirm('Are you sure to delete this skill?')">
                  <button class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>