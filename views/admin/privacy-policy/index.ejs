<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
  <%- include('../_layouts/head') %>
  <title>Privacy Policy | <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    body { padding-top: 78px !important; }
    #main { margin-top: 0 !important; }
    .section-title { font-size: 1rem; font-weight: 600; color: #1a237e; border-left: 4px solid #3949ab; padding-left: 10px; margin: 20px 0 10px; }
    .required-star { color: #e53935; }
    .form-note { font-size: 12px; color: #757575; margin-top: 4px; }
    .input-field label.active { color: #3949ab !important; }
  </style>
</head>
<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
  data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

  <%- include('../partials/header') %>

  <div id="main">
    <div class="row">
      <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
        <div class="container">
          <div class="row">
            <div class="col s12 m6 l6">
              <h5 class="breadcrumbs-title mt-0 mb-0"><span>Privacy Policy</span></h5>
            </div>
            <div class="col s12 m6 l6 right-align-md">
              <ol class="breadcrumbs mb-0">
                <a class="btn gradient-45deg-purple-deep-orange pull-right btn-breadcrumbs"
                  style="color:#fff;" href="/admin/settings">Back to Settings</a>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <div class="col s12">
        <div class="container">
          <div class="section">
            <div class="card-panel">
              <div class="card-content">
                <form id="privacyForm" method="POST" action="/admin/privacy-policy" onsubmit="return validateForm()">

                  <div class="row">

                    <!-- POLICY DETAILS -->
                    <div class="col s12">
                      <p class="section-title"><i class="bi bi-shield-lock"></i> Privacy Policy Content</p>
                    </div>

                    <div class="input-field col s12">
                      <input id="title" name="title" type="text" value="<%= policy.title || '' %>">
                      <label for="title">Page Title</label>
                    </div>

                    <div class="input-field col s12">
                      <textarea id="editor" name="content" class="materialize-textarea" rows="18"><%= policy.content || '' %></textarea>
                      <label for="editor">Content</label>
                    </div>

                    <!-- STATUS -->
                    <div class="col s12">
                      <p class="section-title"><i class="bi bi-toggle-on"></i> Status</p>
                    </div>
                    <div class="col s12 m6">
                      <div class="switch" style="margin:20px 0;">
                        <label>
                          Inactive
                          <input type="checkbox" name="isActive" value="true" <%= policy.isActive ? 'checked' : '' %>>
                          <span class="lever"></span>
                          Active
                        </label>
                      </div>
                      <p class="form-note">Show Privacy Policy page on website when active</p>
                    </div>

                    <!-- SUBMIT BUTTONS -->
                    <div class="col s12 right-align" style="margin-top:40px;">
                      <button type="submit" id="submitBtn" class="btn gradient-45deg-purple-deep-orange waves-effect waves-light">
                        <i class="material-icons left">save</i>
                        Save Privacy Policy
                      </button>
                      <a href="/admin/settings" class="btn grey waves-effect waves-light" style="margin-left:10px;">
                        <i class="material-icons left">cancel</i> Cancel
                      </a>
                    </div>

                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
        <div class="content-overlay"></div>
      </div>
    </div>
  </div>

  <%- include('../_layouts/commonJs') %>

  <!-- CKEditor -->
  <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>

  <script>
    $(document).ready(function () {
      M.updateTextFields();
      CKEDITOR.replace('editor', {
        height: 500,
        removeButtons: 'About'
      });
    });

    function validateForm() {
      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.innerHTML = '<i class="material-icons left">hourglass_empty</i> Saving...';
      return true;
    }
  </script>
</body>
</html>