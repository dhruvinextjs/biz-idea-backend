<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
  <%- include('../_layouts/head') %>
  <title>Services | <%= title %></title>

  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/jquery.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/extensions/responsive/css/responsive.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/select.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="/app-assets/css/pages/data-tables.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

  <style>
    body { padding-top: 78px !important; }
    #main { margin-top: 0 !important; }

    .badge-active   { background:rgba(76,175,80,0.12); color:#4CAF50; border:1px solid rgba(76,175,80,0.3); padding:3px 10px; border-radius:12px; font-size:11px; }
    .badge-inactive { background:rgba(158,158,158,0.12); color:#9e9e9e; border:1px solid rgba(158,158,158,0.3); padding:3px 10px; border-radius:12px; font-size:11px; }
    .badge-featured { background:rgba(255,193,7,0.12); color:#FFC107; border:1px solid rgba(255,193,7,0.3); padding:3px 10px; border-radius:12px; font-size:11px; }

    #page-length-option tbody tr { height: 95px; }
    #page-length-option tbody td { vertical-align: middle; }
    #page-length-option thead th {
      font-weight: 600;
      font-size: 14px;
      color: #374151;
      padding: 18px 15px;
    }
    #page-length-option tbody td {
      padding: 18px 15px;
      font-size: 14px;
    }
  </style>
</head>

<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
  data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

  <%- include('../partials/header') %>

  <div id="main">
    <div class="row">
      <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
        <div class="container">
          <div class="row">
            <div class="col s12 m6 l6">
              <h5 class="breadcrumbs-title mt-0 mb-0"><span>Services</span></h5>
            </div>
            <div class="col s12 m6 l6 right-align-md">
              <ol class="breadcrumbs mb-0">
                <a class="btn gradient-45deg-purple-deep-orange pull-right btn-breadcrumbs"
                  style="color:#fff;" href="/admin/services/create">
                  Create New Service
                </a>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <div class="col s12">
        <div class="container">
          <div class="section section-data-tables">
            <div class="row">
              <div class="col s12">
                <div class="card">
                  <div class="card-content">
                    <div class="row">
                      <div class="col s12 overflow">

                        <table id="page-length-option" class="display" style="width:100%">
                          <thead>
                            <tr>
                              <th class="ps-3">Order</th>
                              <th>Service</th>
                              <th>Price</th>
                              <th>Features</th>
                              <th>Pinned</th>
                              <th>Status</th>
                              <th class="text-end pe-3">Actions</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (services.length === 0) { %>
                              <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                  <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                                  No services yet. <a href="/admin/services/create">Add one!</a>
                                </td>
                              </tr>
                            <% } else { %>
                              <% services.forEach(s => { %>
                              <tr>
                                <td style="text-align:center;">
                                  <span style="display:inline-block; width:34px; height:34px; line-height:34px; border-radius:50%; background:#eef2ff; color:#4f46e5; font-weight:600;">
                                    <%= s.order %>
                                  </span>
                                </td>
                                <td>
                                  <div style="display:flex; align-items:flex-start; gap:14px;">
                                    <% if(s.image){ %>
                                      <img src="<%= s.image %>" width="60" height="60"
                                        style="width:60px; height:60px; object-fit:cover; border-radius:8px; flex-shrink:0; border:1px solid #e5e7eb;">
                                    <% } else { %>
                                      <div style="width:60px; height:60px; border-radius:8px; background:#f5f5f5; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                        <i class="material-icons" style="color:#9ca3af;">image</i>
                                      </div>
                                    <% } %>

                                    <div>
                                      <div style="font-size:15px; font-weight:600; color:#374151; margin-bottom:5px;">
                                        <%= s.title %>
                                      </div>
                                      <div style="font-size:13px; color:#6b7280; line-height:20px; max-width:300px;">
                                        <%= s.description.substring(0,70) %><%= s.description.length > 70 ? '...' : '' %>
                                      </div>
                                    </div>
                                  </div>
                                </td>
                                <td>
                                  <span style="background:rgba(76,175,80,0.12); color:#4CAF50; border:1px solid rgba(76,175,80,0.3); padding:3px 10px; border-radius:12px; font-size:11px;">
                                    <%= s.price %>
                                  </span>
                                </td>
                                <td>
                                  <span style="background:rgba(33,150,243,0.12); color:#2196F3; border:1px solid rgba(33,150,243,0.3); padding:3px 10px; border-radius:12px; font-size:11px;">
                                    <%= s.features ? s.features.length : 0 %> features
                                  </span>
                                </td>
                                <td class="text-center">
                                  <% if(s.isPinned){ %>
                                    <span class="badge-featured">Featured</span>
                                  <% } else { %>
                                    —
                                  <% } %>
                                </td>
                                <td>
                                  <% if (s.isActive) { %>
                                    <span class="badge-active">Active</span>
                                  <% } else { %>
                                    <span class="badge-inactive">Hidden</span>
                                  <% } %>
                                </td>
                                <td class="text-end pe-3">
                                  <div class="d-flex gap-1 justify-content-end">
                                    <a href="#" class="waves-effect waves-light btn-view-service" data-id="<%= s._id %>" title="View">
                                      <i class="material-icons" style="font-size:18px; color:#2196F3;">remove_red_eye</i>
                                    </a>
                                    <a href="/admin/services/<%= s._id %>/edit" class="waves-effect waves-light" title="Edit">
                                      <i class="material-icons" style="font-size:18px; color:#2196F3;">edit</i>
                                    </a>
                                    <form action="/admin/services/<%= s._id %>/delete" method="POST" style="display:inline; margin:0;">
                                      <button type="submit" class="waves-effect waves-light"
                                        style="background:none; border:none; padding:0; margin:0; cursor:pointer;"
                                        onclick="return confirm('Delete this service?');">
                                        <i class="material-icons" style="font-size:18px; color:#2196F3;">delete</i>
                                      </button>
                                    </form>
                                  </div>
                                </td>
                              </tr>
                              <% }) %>
                            <% } %>
                          </tbody>
                        </table>

                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="content-overlay"></div>
      </div>
    </div>
  </div>

  <!-- Service Detail Modal (kept as you had) -->
  <div class="modal fade" id="serviceDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold">
            <i class="bi bi-briefcase me-2 text-primary"></i>Service Details
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4" id="serviceDetailBody">
          <!-- JS will fill this -->
        </div>
        <div class="modal-footer border-top">
          <a id="modalEditBtn" href="#" class="btn btn-primary px-4 btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Service
          </a>
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <%- include('../_layouts/commonJs') %>
  <script src="/app-assets/vendors/data-tables/js/jquery.dataTables.min.js"></script>
  <script src="/app-assets/js/scripts/data-tables.js"></script>

  <!-- Your existing modal script -->
  <script>
    // View Service Modal Logic
    document.querySelectorAll('.btn-view-service').forEach(btn => {
      btn.addEventListener('click', async function () {
        const id = this.dataset.id;
        const modal = new bootstrap.Modal(document.getElementById('serviceDetailModal'));
        const body = document.getElementById('serviceDetailBody');
        const editBtn = document.getElementById('modalEditBtn');

        body.innerHTML = `<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="text-muted mt-2 mb-0">Loading...</p></div>`;
        editBtn.href = '#';
        modal.show();

        try {
          const res = await fetch(`/admin/services/${id}/view-json`);
          const json = await res.json();
          if (!json.success) throw new Error(json.message);

          const s = json.data;
          editBtn.href = `/admin/services/${s._id}/edit`;

          const featuresHtml = s.features && s.features.length
            ? s.features.map(f => `
                <div class="border rounded p-2 mb-2">
                  <div class="fw-semibold small">${f.title}</div>
                  <div class="text-muted small">${f.description || '—'}</div>
                </div>`).join('')
            : '<p class="text-muted small mb-0">No features added.</p>';

          body.innerHTML = `
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                ${s.image ? `<img src="${s.image}" class="img-fluid rounded w-100" style="max-height:180px;object-fit:cover;" alt="Listing image">` : '<div class="bg-light rounded d-flex align-items-center justify-content-center" style="height:120px"><span class="text-muted small">No listing image</span></div>'}
              </div>
              <div class="col-md-6">
                ${s.detailImage ? `<img src="${s.detailImage}" class="img-fluid rounded w-100" style="max-height:180px;object-fit:cover;" alt="Detail image">` : '<div class="bg-light rounded d-flex align-items-center justify-content-center" style="height:120px"><span class="text-muted small">No detail image</span></div>'}
              </div>
            </div>

            <div class="d-flex gap-2 flex-wrap mb-3">
              ${s.isActive ? '<span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>' : '<span class="badge bg-secondary-subtle px-3 py-2 text-secondary border border-secondary-subtle">Hidden</span>'}
              ${s.isPinned ? '<span class="badge bg-warning text-dark">📌 Pinned</span>' : '<span class="badge bg-light text-muted border">Not Pinned</span>'}
              <span class="badge bg-light text-dark border">Order: ${s.order}</span>
              <span class="badge bg-success-subtle text-success border border-success-subtle">${s.price}</span>
            </div>

            <h5 class="fw-bold mb-1">${s.title}</h5>
            <p class="text-muted small mb-3">${s.description}</p>

            ${s.fullDescription ? `<hr class="my-3"><div class="mb-3" style="white-space:pre-wrap;line-height:1.7;font-size:0.9rem;">${s.fullDescription}</div>` : ''}

            <hr class="my-3">
            <p class="fw-semibold small mb-2">Features (${s.features ? s.features.length : 0})</p>
            ${featuresHtml}
          `;
        } catch (err) {
          body.innerHTML = `<div class="text-center py-5 text-danger"><i class="bi bi-exclamation-triangle fs-2 d-block mb-2"></i><p class="mb-0">Failed to load: ${err.message}</p></div>`;
        }
      });
    });
  </script>

</body>
</html>