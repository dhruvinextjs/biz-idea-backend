<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1 fw-bold">
      <i class="bi bi-briefcase me-2 text-primary"></i>
      <%= service ? 'Edit Service' : 'Add Service' %>
    </h4>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
        <li class="breadcrumb-item"><a href="/admin/services">Services</a></li>
        <li class="breadcrumb-item active"><%= service ? 'Edit' : 'Add' %></li>
      </ol>
    </nav>
  </div>
  <a href="/admin/services" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i> Back
  </a>
</div>

<form
  action="/admin/services/<%= service ? service._id + '/edit' : 'create' %>"
  method="POST"
  enctype="multipart/form-data"
  id="serviceForm"
  onsubmit="return validateForm()">

  <div class="row g-4">

    <!-- LEFT -->
    <div class="col-12 col-lg-8">

      <!-- Basic Info -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
          <h6 class="mb-0 fw-semibold"><i class="bi bi-info-circle me-2 text-primary"></i>Basic Information</h6>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
            <input type="text" name="title" id="title" class="form-control" value="<%= service ? service.title : '' %>" required placeholder="Service title" />
            <div id="titleError" class="text-danger small mt-1"></div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Short Description <span class="text-danger">*</span></label>
            <textarea name="description" id="desc" class="form-control" rows="2" required placeholder="Brief description shown in listing"><%= service ? service.description : '' %></textarea>
            <div id="descError" class="text-danger small mt-1"></div>
          </div>
          <div class="mb-0">
            <label class="form-label fw-semibold">Full Description</label>
            <textarea name="fullDescription" class="form-control" rows="4" placeholder="Detailed description for service page"><%= service ? service.fullDescription : '' %></textarea>
          </div>
        </div>
      </div>

      <!-- Features -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
          <h6 class="mb-0 fw-semibold"><i class="bi bi-list-check me-2 text-success"></i>What You Get (Features)</h6>
        </div>
        <div class="card-body">
          <% for(let i = 0; i < 6; i++) { %>
          <div class="border rounded p-3 mb-3 bg-light bg-opacity-50">
            <div class="fw-semibold small text-muted mb-2">Feature <%= i + 1 %></div>
            <div class="row g-2">
              <div class="col-12 col-md-5">
                <input
                  type="text"
                  name="featureTitle[]"
                  class="form-control form-control-sm"
                  placeholder="Feature title"
                  value="<%= service?.features?.[i]?.title || '' %>"
                />
              </div>
              <div class="col-12 col-md-7">
                <textarea
                  name="featureDescription[]"
                  class="form-control form-control-sm"
                  rows="2"
                  placeholder="Feature description"
                ><%= service?.features?.[i]?.description || '' %></textarea>
              </div>
            </div>
          </div>
          <% } %>
        </div>
      </div>

    </div>

    <!-- RIGHT -->
    <div class="col-12 col-lg-4">

      <!-- Images -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
          <h6 class="mb-0 fw-semibold"><i class="bi bi-image me-2 text-info"></i>Images</h6>
        </div>
        <div class="card-body">

          <div class="mb-4">
            <label class="form-label fw-semibold">Listing Image</label>
            <% if (service && service.image) { %>
              <div class="mb-2 text-center">
                <img src="<%= service.image %>" class="img-thumbnail" style="max-height:100px;object-fit:cover;border-radius:8px" />
                <p class="text-muted small mt-1 mb-0">Current</p>
              </div>
            <% } %>
            <input type="file" name="image" class="form-control" accept="image/*" />
            <div class="text-muted small mt-1">Shown in service listing</div>
          </div>

          <div>
            <label class="form-label fw-semibold">Detail Page Image</label>
            <% if (service && service.detailImage) { %>
              <div class="mb-2 text-center">
                <img src="<%= service.detailImage %>" class="img-thumbnail" style="max-height:100px;object-fit:cover;border-radius:8px" />
                <p class="text-muted small mt-1 mb-0">Current</p>
              </div>
            <% } %>
            <input type="file" name="detailImage" class="form-control" accept="image/*" />
            <div class="text-muted small mt-1">Shown on service detail page</div>
          </div>

        </div>
      </div>

      <!-- Pricing & Order -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
          <h6 class="mb-0 fw-semibold"><i class="bi bi-cash me-2 text-success"></i>Pricing & Order</h6>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label fw-semibold">Price</label>
            <input type="text" name="price" class="form-control" value="<%= service ? service.price : 'Contact Us' %>" placeholder="$499 / Contact Us" />
          </div>
          <div>
            <label class="form-label fw-semibold">Display Order</label>
            <input type="number" name="order" class="form-control" value="<%= service ? service.order : 0 %>" min="0" />
            <div class="text-muted small mt-1">Lower = shown first</div>
          </div>
        </div>
      </div>

      <!-- Status -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
          <h6 class="mb-0 fw-semibold"><i class="bi bi-toggle-on me-2 text-secondary"></i>Status</h6>
        </div>
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <div class="fw-semibold">Active</div>
              <small class="text-muted">Visible on site</small>
            </div>
            <div class="form-check form-switch mb-0">
              <input class="form-check-input" type="checkbox" name="isActive" value="true" style="width:2.5em;height:1.4em" <%= !service || service.isActive ? 'checked' : '' %> />
            </div>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="d-grid gap-2">
        <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
          <i class="bi bi-<%= service ? 'save' : 'plus-circle' %> me-2"></i>
          <%= service ? 'Update Service' : 'Create Service' %>
        </button>
        <a href="/admin/services" class="btn btn-outline-secondary">
          <i class="bi bi-x-circle me-2"></i>Cancel
        </a>
      </div>

    </div>
  </div>
</form>

<script>
function validateForm() {
  let valid = true;
  const title = document.getElementById('title').value.trim();
  const desc  = document.getElementById('desc').value.trim();
  if (!title) { document.getElementById('titleError').innerText = 'Title is required.'; valid = false; }
  else document.getElementById('titleError').innerText = '';
  if (!desc) { document.getElementById('descError').innerText = 'Description is required.'; valid = false; }
  else document.getElementById('descError').innerText = '';
  if (valid) {
    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';
  }
  return valid;
}
</script>

<%- include('../partials/footer') %>
