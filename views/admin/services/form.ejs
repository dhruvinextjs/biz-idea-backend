<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
  <%- include('../_layouts/head') %>
  <title><%= service ? 'Edit Service' : 'Create Service' %> | <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    body { padding-top: 78px !important; }
    #main { margin-top: 0 !important; }
    .section-title { font-size: 1rem; font-weight: 600; color: #1a237e; border-left: 4px solid #3949ab; padding-left: 10px; margin: 20px 0 10px; }
    .required-star { color: #e53935; }
    .form-note { font-size: 12px; color: #757575; margin-top: 4px; }
    .input-field label.active { color: #3949ab !important; }
  </style>
</head>
<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
  data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

  <%- include('../partials/header') %>

  <div id="main">
    <div class="row">
      <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
        <div class="container">
          <div class="row">
            <div class="col s12 m6 l6">
              <h5 class="breadcrumbs-title mt-0 mb-0"><span><%= service ? 'Edit Service' : 'Create Service' %></span></h5>
            </div>
            <div class="col s12 m6 l6 right-align-md">
              <ol class="breadcrumbs mb-0">
                <a class="btn gradient-45deg-purple-deep-orange pull-right btn-breadcrumbs"
                  style="color:#fff;" href="/admin/services">Back to Services</a>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <div class="col s12">
        <div class="container">
          <div class="section">
            <div class="card-panel">
              <div class="card-content">
                <form id="serviceForm" method="POST"
                  action="/admin/services/<%= service ? service._id + '/edit' : 'create' %>"
                  enctype="multipart/form-data"
                  onsubmit="return validateForm()">

                  <div class="row">

                    <!-- BASIC INFORMATION -->
                    <div class="col s12">
                      <p class="section-title"><i class="bi bi-info-circle"></i> Basic Information</p>
                    </div>
                    <div class="input-field col s12">
                      <input id="title" name="title" type="text" value="<%= service ? service.title : '' %>" required>
                      <label for="title" class="<%= service ? 'active' : '' %>">Title <span class="required-star">*</span></label>
                      <span id="titleError" class="helper-text red-text"></span>
                    </div>
                    <div class="input-field col s12">
                      <textarea id="description" name="description" class="materialize-textarea" required><%= service ? service.description : '' %></textarea>
                      <label for="description" class="<%= service ? 'active' : '' %>">Short Description <span class="required-star">*</span></label>
                      <span id="descError" class="helper-text red-text"></span>
                    </div>
                    <div class="input-field col s12">
                      <textarea name="fullDescription" class="materialize-textarea"><%= service ? service.fullDescription : '' %></textarea>
                      <label class="<%= service ? 'active' : '' %>">Full Description</label>
                    </div>

                    <!-- FEATURES -->
                    <div class="col s12">
                      <p class="section-title"><i class="bi bi-list-check"></i> What You Get (Features)</p>
                    </div>
                    <% for(let i = 0; i < 6; i++) { %>
                    <div class="col s12 m6">
                      <div class="card-panel grey lighten-5" style="margin-bottom:20px; padding:15px;">
                        <p class="small grey-text text-darken-2 mb-2">Feature <%= i + 1 %></p>
                        <div class="input-field">
                          <input type="text" name="featureTitle[]" value="<%= service?.features?.[i]?.title || '' %>" placeholder="Feature Title">
                          <label class="active">Title</label>
                        </div>
                        <div class="input-field">
                          <textarea name="featureDescription[]" class="materialize-textarea" placeholder="Feature Description"><%= service?.features?.[i]?.description || '' %></textarea>
                          <label class="active">Description</label>
                        </div>
                      </div>
                    </div>
                    <% } %>

                    <!-- IMAGES -->
                    <div class="col s12">
                      <p class="section-title"><i class="bi bi-image"></i> Images</p>
                    </div>
                    <div class="input-field col s12 m6">
                      <% if (service && service.image) { %>
                        <img src="<%= service.image %>" style="max-height:120px; border-radius:8px; margin-bottom:10px;" class="responsive-img">
                        <p class="form-note">Current Listing Image</p>
                      <% } %>
                      <input type="file" name="image" accept="image/*">
                      <label class="mt-2">Listing Image</label>
                    </div>
                    <div class="input-field col s12 m6">
                      <% if (service && service.detailImage) { %>
                        <img src="<%= service.detailImage %>" style="max-height:120px; border-radius:8px; margin-bottom:10px;" class="responsive-img">
                        <p class="form-note">Current Detail Page Image</p>
                      <% } %>
                      <input type="file" name="detailImage" accept="image/*">
                      <label class="mt-2">Detail Page Image</label>
                    </div>

                    <!-- PRICING & ORDER -->
                    <div class="col s12">
                      <p class="section-title"><i class="bi bi-cash"></i> Pricing & Display</p>
                    </div>
                    <div class="input-field col s12 m6">
                      <input type="text" name="price" value="<%= service ? service.price : 'Contact Us' %>">
                      <label class="active">Price</label>
                    </div>
                    <div class="input-field col s12 m6">
                      <input type="number" name="order" value="<%= service ? service.order : 0 %>" min="0">
                      <label class="active">Display Order (Lower = First)</label>
                    </div>

                    <!-- STATUS -->
                    <div class="col s12">
                      <p class="section-title"><i class="bi bi-toggle-on"></i> Status</p>
                    </div>
                    <div class="col s12 m6">
                      <div class="switch" style="margin:15px 0;">
                        <label>
                          Hidden
                          <input type="checkbox" name="isActive" value="true" <%= !service || service.isActive ? 'checked' : '' %>>
                          <span class="lever"></span>
                          Active
                        </label>
                      </div>
                      <p class="form-note">Visible on website when active</p>
                    </div>
                    <div class="col s12 m6">
                      <div class="switch" style="margin:15px 0;">
                        <label>
                          Not Pinned
                          <input type="checkbox" name="isPinned" value="true" <%= service && service.isPinned ? 'checked' : '' %>>
                          <span class="lever"></span>
                          Pinned (Featured)
                        </label>
                      </div>
                      <p class="form-note">Show on homepage featured section</p>
                    </div>

                    <!-- SUBMIT BUTTONS -->
                    <div class="col s12 right-align" style="margin-top:30px;">
                      <button type="submit" id="submitBtn" class="btn gradient-45deg-purple-deep-orange waves-effect waves-light">
                        <i class="material-icons left"><%= service ? 'save' : 'add_circle' %></i>
                        <%= service ? 'Update Service' : 'Create Service' %>
                      </button>
                      <a href="/admin/services" class="btn grey waves-effect waves-light" style="margin-left:10px;">
                        <i class="material-icons left">cancel</i> Cancel
                      </a>
                    </div>

                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
        <div class="content-overlay"></div>
      </div>
    </div>
  </div>

  <%- include('../_layouts/commonJs') %>

  <script>
    $(document).ready(function () {
      $('select').formSelect();
      M.updateTextFields();
      document.querySelectorAll('.materialize-textarea').forEach(el => M.textareaAutoResize(el));
    });

    function validateForm() {
      let valid = true;
      const title = document.getElementById('title').value.trim();
      const desc = document.getElementById('description').value.trim();

      if (!title) {
        document.getElementById('titleError').innerText = 'Title is required.';
        valid = false;
      } else {
        document.getElementById('titleError').innerText = '';
      }

      if (!desc) {
        document.getElementById('descError').innerText = 'Short Description is required.';
        valid = false;
      } else {
        document.getElementById('descError').innerText = '';
      }

      if (valid) {
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="material-icons left">hourglass_empty</i> Saving...';
      }
      return valid;
    }
  </script>
</body>
</html>