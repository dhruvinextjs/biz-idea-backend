<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <span class="text-muted">Page <%= currentPage %> of <%= totalPages %></span>
  <a href="/admin/case-studies/create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Case Study</a>
</div>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead><tr><th>#</th><th>Title</th><th>Founder</th><th>Company</th><th>Revenue/mo</th><th>Industry</th><th>Featured</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% if (studies.length === 0) { %>
          <tr><td colspan="9" class="text-center text-muted py-4">No case studies yet. <a href="/admin/case-studies/create">Add one!</a></td></tr>
        <% } %>
        <% studies.forEach((s, i) => { %>
        <tr>
          <td class="text-muted"><%= ((currentPage-1)*10) + i + 1 %></td>
          <td><strong><%= s.title.substring(0,40) %><%= s.title.length > 40 ? '...' : '' %></strong></td>
          <td><%= s.founderName %></td>
          <td><%= s.companyName %></td>
          <td><strong>$<%= s.monthlyRevenue.toLocaleString() %></strong></td>
          <td><span class="badge bg-light text-dark border"><%= s.industry %></span></td>
          <td><% if (s.isFeatured) { %><span class="badge bg-warning text-dark">⭐</span><% } else { %>-<% } %></td>
          <td><span class="badge <%= s.isActive ? 'badge-active' : 'badge-inactive' %>"><%= s.isActive ? 'Active' : 'Hidden' %></span></td>
          <td>
            <a href="/admin/case-studies/<%= s._id %>/edit" class="btn btn-sm btn-outline-secondary py-0 me-1"><i class="bi bi-pencil"></i></a>
            <form action="/admin/case-studies/<%= s._id %>/delete" method="POST" style="display:inline">
              <button class="btn btn-sm btn-outline-danger py-0 btn-delete"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<% if (totalPages > 1) { %>
<nav class="mt-3"><ul class="pagination pagination-sm justify-content-center">
  <% for(let i = 1; i <= totalPages; i++) { %>
    <li class="page-item <%= currentPage === i ? 'active' : '' %>"><a class="page-link" href="/admin/case-studies?page=<%= i %>"><%= i %></a></li>
  <% } %>
</ul></nav>
<% } %>

<%- include('../partials/footer') %>
