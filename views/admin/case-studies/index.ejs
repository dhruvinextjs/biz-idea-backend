<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1 fw-bold"><i class="bi bi-briefcase me-2 text-primary"></i>Case Studies</h4>
    <p class="text-muted mb-0 small">Manage all case studies</p>
  </div>
  <a href="/admin/case-studies/create" class="btn btn-primary">
    <i class="bi bi-plus-lg me-1"></i> Add Case Study
  </a>
</div>


<div class="card shadow-sm border-0">
  <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
    <span class="fw-semibold">All Case Studies</span>
    <span class="text-muted small">Page <%= currentPage %> of <%= totalPages %></span>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3">#</th>
            <th>Title</th>
            <th>Founder</th>
            <th>Company</th>
            <th>Revenue/mo</th>
            <th>Industry</th>
            <th>Featured</th>
            <th>Status</th>
            <th class="text-end pe-3">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (studies.length === 0) { %>
            <tr>
              <td colspan="9" class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                No case studies found. <a href="/admin/case-studies/create">Add one!</a>
              </td>
            </tr>
          <% } %>
          <% studies.forEach((s, i) => { %>
          <tr>
            <td class="ps-3 text-muted small"><%= ((currentPage-1)*10) + i + 1 %></td>
            <td>
              <div class="fw-semibold"><%= s.title.substring(0,45) %><%= s.title.length > 45 ? '...' : '' %></div>
            </td>
            <td><small><%= s.founderName %></small></td>
            <td><small><%= s.companyName %></small></td>
            <td><span class="fw-semibold text-success">$<%= s.monthlyRevenue.toLocaleString() %></span></td>
            <td><span class="badge bg-light text-dark border"><%= s.industry %></span></td>
            <td class="text-center">
              <% if (s.isFeatured) { %><span class="badge bg-warning text-dark">⭐ Yes</span><% } else { %><span class="text-muted">—</span><% } %>
            </td>
            <td>
              <% if (s.isActive) { %>
                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
              <% } else { %>
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Hidden</span>
              <% } %>
            </td>
            <td class="text-end pe-3">
              <a href="/admin/case-studies/<%= s._id %>/edit" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                <i class="bi bi-pencil"></i>
              </a>
              <form action="/admin/case-studies/<%= s._id %>/delete" method="POST" style="display:inline">
                <button class="btn btn-sm btn-outline-danger btn-delete" title="Delete">
                  <i class="bi bi-trash"></i>
                </button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% if (totalPages > 1) { %>
  <div class="card-footer bg-white py-3">
    <nav><ul class="pagination pagination-sm justify-content-center mb-0">
      <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= currentPage - 1 %>"><i class="bi bi-chevron-left"></i></a>
      </li>
      <% for(let i = 1; i <= totalPages; i++) { %>
        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= i %>"><%= i %></a>
        </li>
      <% } %>
      <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= currentPage + 1 %>"><i class="bi bi-chevron-right"></i></a>
      </li>
    </ul></nav>
  </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
