<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
  <%- include('../_layouts/head') %>
  <title><%= study ? 'Edit Case Study' : 'Create Case Study' %> | <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    body { padding-top: 78px !important; }
    #main { margin-top: 0 !important; }
    .section-title { font-size: 1rem; font-weight: 600; color: #1a237e; border-left: 4px solid #3949ab; padding-left: 10px; margin: 20px 0 10px; }
    .required-star { color: #e53935; }
    .form-note { font-size: 12px; color: #757575; margin-top: 4px; }
    .input-field label.active { color: #3949ab !important; }
  </style>
</head>
<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
  data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

  <%- include('../partials/header') %>

  <div id="main">
    <div class="row">
      <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
        <div class="container">
          <div class="row">
            <div class="col s12 m6 l6">
              <h5 class="breadcrumbs-title mt-0 mb-0"><span><%= study ? 'Edit Case Study' : 'Create Case Study' %></span></h5>
            </div>
            <div class="col s12 m6 l6 right-align-md">
              <ol class="breadcrumbs mb-0">
                <a class="btn gradient-45deg-purple-deep-orange pull-right btn-breadcrumbs"
                  style="color:#fff;" href="/admin/case-studies">Back to Case Studies</a>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <div class="col s12">
        <div class="container">
          <div class="section">
            <div class="card-panel">
              <div class="card-content">
                <form id="csForm" method="POST"
                  action="/admin/case-studies/<%= study ? study._id + '/edit' : 'create' %>"
                  onsubmit="return validateForm()">
                  <div class="row">

                    <!-- BASIC INFO -->
                    <div class="col s12">
                      <p class="section-title"><i class="bi bi-info-circle"></i> Basic Information</p>
                    </div>
                    <div class="input-field col s12">
                      <input id="title" name="title" type="text" value="<%= study ? study.title : '' %>" required>
                      <label for="title" class="<%= study ? 'active' : '' %>">Title <span class="required-star">*</span></label>
                      <span id="titleError" class="helper-text red-text"></span>
                    </div>
                    <div class="input-field col s12">
                      <textarea id="excerpt" name="excerpt" class="materialize-textarea" required><%= study ? study.excerpt : '' %></textarea>
                      <label for="excerpt" class="<%= study ? 'active' : '' %>">Excerpt <span class="required-star">*</span></label>
                      <span id="excerptError" class="helper-text red-text"></span>
                    </div>

                    <!-- CASE STUDY DETAILS -->
                    <div class="col s12">
                      <p class="section-title"><i class="bi bi-file-earmark-text"></i> Case Study Details</p>
                    </div>
                    <div class="input-field col s12">
                      <textarea name="companyOverview" class="materialize-textarea" placeholder="Acme SaaS is a marketing automation platform..."><%= study ? study.companyOverview : '' %></textarea>
                      <label class="<%= study ? 'active' : '' %>">Company Overview</label>
                    </div>
                    <div class="input-field col s12">
                      <textarea name="founderStory" class="materialize-textarea" placeholder="Founder background, journey and inspiration..."><%= study ? study.founderStory : '' %></textarea>
                      <label class="<%= study ? 'active' : '' %>">Founder Story</label>
                    </div>
                    <div class="input-field col s12 m6">
                      <textarea name="problem" class="materialize-textarea" placeholder="What problem were customers facing?"><%= study ? study.problem : '' %></textarea>
                      <label class="<%= study ? 'active' : '' %>">Problem</label>
                    </div>
                    <div class="input-field col s12 m6">
                      <textarea name="solution" class="materialize-textarea" placeholder="Describe the product/service solution..."><%= study ? study.solution : '' %></textarea>
                      <label class="<%= study ? 'active' : '' %>">Solution</label>
                    </div>
                    <div class="input-field col s12 m6">
                      <textarea name="businessModel" class="materialize-textarea" placeholder="Subscription, SaaS, One-time purchase..."><%= study ? study.businessModel : '' %></textarea>
                      <label class="<%= study ? 'active' : '' %>">Business Model</label>
                    </div>
                    <div class="input-field col s12 m6">
                      <textarea name="revenue" class="materialize-textarea" placeholder="Revenue milestones, MRR, ARR etc..."><%= study ? study.revenue : '' %></textarea>
                      <label class="<%= study ? 'active' : '' %>">Revenue Details</label>
                    </div>
                    <div class="input-field col s12 m6">
                      <textarea name="funding" class="materialize-textarea" placeholder="Bootstrapped, Seed Round, Angel Investors..."><%= study ? study.funding : '' %></textarea>
                      <label class="<%= study ? 'active' : '' %>">Funding</label>
                    </div>
                    <div class="input-field col s12 m6">
                      <textarea name="growth" class="materialize-textarea" placeholder="Growth milestones and achievements..."><%= study ? study.growth : '' %></textarea>
                      <label class="<%= study ? 'active' : '' %>">Growth Journey</label>
                    </div>
                    <div class="input-field col s12 m6">
                      <textarea name="marketingStrategy" class="materialize-textarea" placeholder="SEO, Ads, Social Media, Partnerships..."><%= study ? study.marketingStrategy : '' %></textarea>
                      <label class="<%= study ? 'active' : '' %>">Marketing Strategy</label>
                    </div>
                    <div class="input-field col s12 m6">
                      <textarea name="firstCustomers" class="materialize-textarea" placeholder="Explain how first users/customers were acquired..."><%= study ? study.firstCustomers : '' %></textarea>
                      <label class="<%= study ? 'active' : '' %>">First Customers</label>
                    </div>
                    <div class="input-field col s12">
                      <textarea name="lessons" class="materialize-textarea" placeholder="Lesson 1&#10;Lesson 2&#10;Lesson 3"><%= study && study.lessons ? study.lessons.join('\n') : '' %></textarea>
                      <label class="<%= study ? 'active' : '' %>">Lessons Learned <span style="font-weight:400;color:#9e9e9e;font-size:12px;">(one per line)</span></label>
                    </div>
                    <div class="input-field col s12">
                      <textarea name="howToStart" class="materialize-textarea" placeholder="Step by step guide to start a similar business..."><%= study ? study.howToStart : '' %></textarea>
                      <label class="<%= study ? 'active' : '' %>">How To Start Similar Business</label>
                    </div>

                    <!-- FOUNDER & COMPANY -->
                    <div class="col s12">
                      <p class="section-title"><i class="bi bi-person-badge"></i> Founder &amp; Company</p>
                    </div>
                    <div class="input-field col s12 m6">
                      <input name="founderName" type="text" value="<%= study ? study.founderName : '' %>" required>
                      <label class="<%= study ? 'active' : '' %>">Founder Name <span class="required-star">*</span></label>
                    </div>
                    <div class="input-field col s12 m6">
                      <input name="companyName" type="text" value="<%= study ? study.companyName : '' %>" required>
                      <label class="<%= study ? 'active' : '' %>">Company Name <span class="required-star">*</span></label>
                    </div>
                    <div class="input-field col s12 m6">
                      <input name="monthlyRevenue" type="number" min="0" value="<%= study ? study.monthlyRevenue : '' %>" required>
                      <label class="<%= study ? 'active' : '' %>">Monthly Revenue (USD) <span class="required-star">*</span></label>
                    </div>
                    <div class="input-field col s12 m6">
                      <input name="companySize" type="number" min="1" value="<%= study ? study.companySize : 2 %>">
                      <label class="active">Company Size (employees)</label>
                    </div>
                    <div class="input-field col s12 m6">
                      <input name="image" type="text" value="<%= study ? study.image : '/images/startup-sketch.png' %>">
                      <label class="active">Cover Image URL</label>
                    </div>
                    <div class="input-field col s12 m6">
                      <input name="founderImage" type="text" value="<%= study ? study.founderImage : '/images/person1.jpg' %>">
                      <label class="active">Founder Image URL</label>
                    </div>

                    <!-- CLASSIFICATION -->
                    <div class="col s12">
                      <p class="section-title"><i class="bi bi-tags"></i> Classification</p>
                    </div>
                    <div class="input-field col s12 m6">
                      <select name="industry">
                        <% ['Marketing','Advertising','Analytics','Real Estate','Automations','SaaS','E-Commerce','Other'].forEach(ind => { %>
                          <option value="<%= ind %>" <%= study && study.industry === ind ? 'selected' : '' %>><%= ind %></option>
                        <% }) %>
                      </select>
                      <label>Industry</label>
                    </div>

                    <!-- STATUS -->
                    <div class="col s12">
                      <p class="section-title"><i class="bi bi-toggle-on"></i> Status</p>
                    </div>
                    <div class="col s12 m6">
                      <div class="switch" style="margin:10px 0;">
                        <label>Inactive
                          <input type="checkbox" name="isActive" value="true" <%= !study || study.isActive ? 'checked' : '' %>>
                          <span class="lever"></span>
                          Active
                        </label>
                      </div>
                      <p class="form-note">Visible on site when active</p>
                    </div>
                    <div class="col s12 m6">
                      <div class="switch" style="margin:10px 0;">
                        <label>Normal
                          <input type="checkbox" name="isFeatured" value="true" <%= study && study.isFeatured ? 'checked' : '' %>>
                          <span class="lever"></span>
                          Featured ⭐
                        </label>
                      </div>
                      <p class="form-note">Show at top when featured</p>
                    </div>

                    <!-- BUTTONS -->
                    <div class="col s12 right-align" style="margin-top:20px;">
                      <button type="submit" id="submitBtn"
                        class="btn gradient-45deg-purple-deep-orange waves-effect waves-light">
                        <i class="material-icons left"><%= study ? 'save' : 'add_circle' %></i>
                        <%= study ? 'Update Case Study' : 'Create Case Study' %>
                      </button>
                      <a href="/admin/case-studies" class="btn grey waves-effect waves-light" style="margin-left:8px;">
                        <i class="material-icons left">cancel</i>Cancel
                      </a>
                    </div>

                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
        <div class="content-overlay"></div>
      </div>
    </div>
  </div>

  <%- include('../_layouts/commonJs') %>
  <script>
    $(document).ready(function () {
      $('select').formSelect();
      M.updateTextFields();
      document.querySelectorAll('.materialize-textarea').forEach(el => M.textareaAutoResize(el));
    });
    function validateForm() {
      let valid = true;
      const title = document.getElementById('title').value.trim();
      const excerpt = document.getElementById('excerpt').value.trim();
      if (!title) { document.getElementById('titleError').innerText = 'Title is required.'; valid = false; } else document.getElementById('titleError').innerText = '';
      if (!excerpt) { document.getElementById('excerptError').innerText = 'Excerpt is required.'; valid = false; } else document.getElementById('excerptError').innerText = '';
      if (valid) { const btn = document.getElementById('submitBtn'); btn.disabled = true; btn.innerHTML = '<i class="material-icons left">hourglass_empty</i> Saving...'; }
      return valid;
    }
  </script>
</body>
</html>
