<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>
  <%- include('../_layouts/head') %>
  <title>Contact Messages | <%= title %></title>

  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/jquery.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/extensions/responsive/css/responsive.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/select.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="/app-assets/css/pages/data-tables.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

  <style>
    body { padding-top: 78px !important; }
    #main { margin-top: 0 !important; }

    .status-tabs { display:flex; gap:8px; margin-bottom:18px; flex-wrap:wrap; }
    .status-tab {
      padding:6px 18px; border-radius:20px; font-size:13px; font-weight:500;
      text-decoration:none; border:1px solid #e2e8f0; color:#475569; transition:all 0.2s;
    }
    .status-tab.active, .status-tab:hover { background:#6366f1; color:#fff; border-color:#6366f1; }

    .badge-new     { background:rgba(33,150,243,0.12); color:#2196F3; border:1px solid rgba(33,150,243,0.3); padding:3px 10px; border-radius:12px; font-size:11px; }
    .badge-read    { background:rgba(158,158,158,0.12);color:#9e9e9e; border:1px solid rgba(158,158,158,0.3); padding:3px 10px; border-radius:12px; font-size:11px; }
    .badge-replied { background:rgba(76,175,80,0.12);  color:#4CAF50; border:1px solid rgba(76,175,80,0.3);  padding:3px 10px; border-radius:12px; font-size:11px; }

    tr.row-new { background: rgba(33,150,243,0.04); }
  </style>
</head>

<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
  data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

  <%- include('../partials/header') %>

  <div id="main">
    <div class="row">
      <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
        <div class="container">
          <div class="row">
            <div class="col s12 m6 l6">
              <h5 class="breadcrumbs-title mt-0 mb-0"><span>Contact Messages</span></h5>
            </div>
          </div>
        </div>
      </div>

      <div class="col s12">
        <div class="container">
          <div class="section section-data-tables">
            <div class="row">
              <div class="col s12">

                <!-- Status Tabs -->
                <div class="status-tabs">
                  <a href="/admin/contacts" class="status-tab <%= currentStatus === '' ? 'active' : '' %>">All</a>
                  <a href="/admin/contacts?status=new" class="status-tab <%= currentStatus === 'new' ? 'active' : '' %>">🔵 New</a>
                  <a href="/admin/contacts?status=read" class="status-tab <%= currentStatus === 'read' ? 'active' : '' %>">✅ Read</a>
                  <a href="/admin/contacts?status=replied" class="status-tab <%= currentStatus === 'replied' ? 'active' : '' %>">💬 Replied</a>
                </div>

                <div class="card">
                  <div class="card-content">
                    <div class="row">
                      <div class="col s12 overflow">
                        <table id="page-length-option" class="display" style="width:100%">
                          <thead>
                            <tr>
                              <th>#</th>
                              <th>Name</th>
                              <th>Email</th>
                              <th>Country</th>
                              <th>Phone</th>
                              <th>Project</th>
                              <th>Status</th>
                              <th>Date</th>
                              <th>Action</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (contacts.length === 0) { %>
                              <tr>
                                <td colspan="9" class="center-align grey-text" style="padding:40px 0;">
                                  <i class="material-icons" style="font-size:48px; opacity:0.3; display:block; margin-bottom:8px;">inbox</i>
                                  No contact messages yet.
                                </td>
                              </tr>
                            <% } %>
                            <% contacts.forEach((c, i) => { %>
                            <tr class="<%= c.status === 'new' ? 'row-new' : '' %>">
                              <td><%= ((currentPage-1)*10) + i + 1 %></td>
                              <td><strong><%= c.name %></strong></td>
                              <td><a href="mailto:<%= c.email %>"><%= c.email %></a></td>
                              <td><%= c.country || '-' %></td>
                              <td><%= c.phone || '-' %></td>
                              <td>
                                <% if (c.projectRequirement) { %>
                                  <span title="<%= c.projectRequirement %>">
                                    <%= c.projectRequirement.substring(0, 30) %>...
                                  </span>
                                <% } else { %> - <% } %>
                              </td>
                              <td>
                                <% if (c.status === 'new') { %>
                                  <span class="badge-new">New</span>
                                <% } else if (c.status === 'replied') { %>
                                  <span class="badge-replied">Replied</span>
                                <% } else { %>
                                  <span class="badge-read">Read</span>
                                <% } %>
                              </td>
                              <td><%= new Date(c.createdAt).toLocaleDateString('en-GB') %></td>
                              <td style="white-space:nowrap;">
                                <div style="display:flex; align-items:center; gap:8px;">

                                  <a href="javascript:void(0)" class="waves-effect waves-light"
                                    data-target="status<%= c._id %>" title="Update Status" onclick="M.Modal.getInstance(document.getElementById('status<%= c._id %>')).open();">
                                    <i class="material-icons" style="font-size:18px; color:#2196F3;">edit</i>
                                  </a>

                                  <form action="/admin/contacts/<%= c._id %>/delete" method="POST" style="display:inline; margin:0;">
                                    <button type="submit" class="waves-effect waves-light"
                                      style="background:none; border:none; padding:0; margin:0; cursor:pointer;"
                                      title="Delete" onclick="return confirm('Delete this message?');">
                                      <i class="material-icons" style="font-size:18px; color:#2196F3;">delete</i>
                                    </button>
                                  </form>

                                </div>
                              </td>
                            </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>
        <div class="content-overlay"></div>
      </div>
    </div>
  </div>

  <!-- Status Update Modals -->
  <% contacts.forEach((c) => { %>
  <div id="status<%= c._id %>" class="modal">
    <div class="modal-content">
      <h5>Update Status</h5>
      <p class="grey-text" style="font-size:13px; margin-bottom:6px;">From: <strong><%= c.name %></strong> (<%= c.email %>)</p>
      <% if (c.projectRequirement) { %>
        <p style="font-size:13px; background:#fafafa; padding:10px; border-radius:6px;"><%= c.projectRequirement %></p>
      <% } %>
      <form action="/admin/contacts/<%= c._id %>/status" method="POST" id="statusForm<%= c._id %>">
        <div class="input-field">
          <select name="status" id="statusSelect<%= c._id %>">
            <option value="new" <%= c.status === 'new' ? 'selected' : '' %>>New</option>
            <option value="read" <%= c.status === 'read' ? 'selected' : '' %>>Read</option>
            <option value="replied" <%= c.status === 'replied' ? 'selected' : '' %>>Replied</option>
          </select>
        </div>
      </form>
    </div>
    <div class="modal-footer">
      <a href="javascript:void(0)" class="modal-close waves-effect btn-flat">Cancel</a>
      <a href="javascript:void(0)" class="waves-effect btn gradient-45deg-purple-deep-orange"
        onclick="document.getElementById('statusForm<%= c._id %>').submit();">Update</a>
    </div>
  </div>
  <% }) %>

  <%- include('../_layouts/commonJs') %>
  <script src="/app-assets/vendors/data-tables/js/jquery.dataTables.min.js"></script>
  <script src="/app-assets/js/scripts/data-tables.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var modals = document.querySelectorAll('.modal');
      M.Modal.init(modals, {});

      var selects = document.querySelectorAll('select');
      M.FormSelect.init(selects, {});
    });
  </script>

</body>
</html>
