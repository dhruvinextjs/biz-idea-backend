<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %> | BizIdeas Admin
  </title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

  <style>
    :root {
      --primary: #6366f1;
      --primary-dark: #4f46e5;
      --sidebar-width: 265px;
    }

    body {
      background: #f1f5f9;
      font-family: 'Segoe UI', sans-serif;
      overflow-x: hidden;
    }

    /* ==================== SIDEBAR FIX ==================== */
    .sidebar {
      width: var(--sidebar-width);
      height: 100vh;
      /* Changed from min-height */
      background: #1e293b;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1000;
      overflow-y: auto;
      /* Scroll will work now */
      overflow-x: hidden;
      scrollbar-width: thin;
      scrollbar-color: #64748b #334155;
    }

    .sidebar::-webkit-scrollbar {
      width: 6px;
    }

    .sidebar::-webkit-scrollbar-thumb {
      background: #64748b;
      border-radius: 20px;
    }

    .sidebar::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    .sidebar-brand {
      padding: 1.25rem 1rem;
      border-bottom: 1px solid #334155;
      flex-shrink: 0;
    }

    .sidebar-brand h4 {
      color: #fff;
      margin: 0;
      font-weight: 800;
      font-size: 1.1rem;
    }

    .sidebar-brand .admin-badge {
      font-size: .7rem;
      padding: .15rem .5rem;
      border-radius: 20px;
      margin-top: 4px;
      display: inline-block;
    }

    .sidebar-brand .badge-super {
      background: #fef3c7;
      color: #92400e;
    }

    .sidebar-brand .badge-sub {
      background: #dbeafe;
      color: #1e40af;
    }

    .sidebar-nav {
      padding-top: 8px;
      padding-bottom: 100px;
      /* Extra space so last items are accessible */
    }

    .nav-section {
      color: #475569;
      font-size: .68rem;
      text-transform: uppercase;
      letter-spacing: .08em;
      padding: .7rem 1.2rem .2rem;
      font-weight: 700;
    }

    .nav-link {
      color: #94a3b8;
      padding: .55rem 1.1rem;
      border-radius: 6px;
      margin: 1px 8px;
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: .845rem;
      transition: all .15s;
    }

    .nav-link:hover,
    .nav-link.active {
      color: #fff;
      background: var(--primary);
    }

    .nav-link.disabled-link {
      opacity: .35;
      pointer-events: none;
      cursor: not-allowed;
    }

    .permission-lock {
      font-size: .75rem;
      color: #94a3b8;
      margin-left: auto;
    }

    /* Main Content */
    .main-content {
      margin-left: var(--sidebar-width);
      min-height: 100vh;
    }

    .topbar {
      background: #fff;
      padding: .7rem 1.5rem;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .page-body {
      padding: 1.5rem;
    }

    /* Rest of your existing styles */
    .stat-card {
      background: #fff;
      border-radius: 12px;
      padding: 1.2rem;
      border: 1px solid #e2e8f0;
    }

    .stat-card .stat-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
    }

    .stat-card .stat-value {
      font-size: 1.75rem;
      font-weight: 800;
      color: #1e293b;
    }

    .stat-card .stat-label {
      color: #64748b;
      font-size: .82rem;
    }

    .card {
      border: 1px solid #e2e8f0;
      border-radius: 12px;
    }

    .card-header {
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
      font-weight: 600;
      font-size: .9rem;
    }

    .btn-primary {
      background: var(--primary);
      border-color: var(--primary);
    }

    .btn-primary:hover {
      background: var(--primary-dark);
      border-color: var(--primary-dark);
    }

    .table th {
      font-size: .75rem;
      text-transform: uppercase;
      color: #64748b;
      font-weight: 700;
      letter-spacing: .05em;
      border-bottom: 2px solid #e2e8f0;
    }

    .table td {
      vertical-align: middle;
      font-size: .875rem;
    }

    .badge-active {
      background: #dcfce7;
      color: #16a34a;
      border-radius: 20px;
      padding: .2rem .6rem;
    }

    .badge-inactive {
      background: #fee2e2;
      color: #dc2626;
      border-radius: 20px;
      padding: .2rem .6rem;
    }

    .pagination .page-link {
      color: var(--primary);
      border-radius: 6px;
      margin: 0 2px;
    }

    .pagination .page-item.active .page-link {
      background: var(--primary);
      border-color: var(--primary);
    }

    .alert {
      border-radius: 8px;
    }
  </style>
</head>

<body>

  <% const isSuperAdmin=adminMeta && adminMeta.adminType==='super' ; const hasAccess=(perm)=> isSuperAdmin || (adminMeta
    && adminMeta.permissions && adminMeta.permissions.includes(perm));
    %>

    <!-- Sidebar -->
    <div class="sidebar">
      <div class="sidebar-brand">
        <h4>🚀 BizIdeas</h4>
        <span class="admin-badge <%= isSuperAdmin ? 'badge-super' : 'badge-sub' %>">
          <%= isSuperAdmin ? '⭐ Super Admin' : '🔧 Sub Admin' %>
        </span>
        <div
          style="color:#64748b;font-size:.72rem;margin-top:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
          <%= adminMeta ? adminMeta.name : '' %>
        </div>
      </div>

      <nav class="sidebar-nav">
        <span class="nav-section">Main</span>
        <a href="/admin/dashboard"
          class="nav-link <%= title==='Dashboard'?'active':'' %> <%= !hasAccess('dashboard')?'disabled-link':'' %>">
          <i class="bi bi-speedometer2"></i> Dashboard
          <% if(!hasAccess('dashboard')){ %><i class="bi bi-lock permission-lock"></i>
            <% } %>
        </a>

        <span class="nav-section">Ideas</span>
        <a href="/admin/ideas?type=business"
          class="nav-link <%= title.includes('Business')&&title.includes('Idea')?'active':'' %> <%= !hasAccess('ideas')?'disabled-link':'' %>">
          <i class="bi bi-lightbulb"></i> Business Ideas
          <% if(!hasAccess('ideas')){ %><i class="bi bi-lock permission-lock"></i>
            <% } %>
        </a>
        <a href="/admin/ideas?type=app"
          class="nav-link <%= title.includes('App')&&title.includes('Idea')?'active':'' %> <%= !hasAccess('ideas')?'disabled-link':'' %>">
          <i class="bi bi-phone"></i> App Ideas
          <% if(!hasAccess('ideas')){ %><i class="bi bi-lock permission-lock"></i>
            <% } %>
        </a>
        <a href="/admin/ideas?type=startup"
          class="nav-link <%= title.includes('Startup')&&title.includes('Idea')?'active':'' %> <%= !hasAccess('ideas')?'disabled-link':'' %>">
          <i class="bi bi-rocket"></i> Startup Ideas
          <% if(!hasAccess('ideas')){ %><i class="bi bi-lock permission-lock"></i>
            <% } %>
        </a>

        <span class="nav-section">Content</span>
        <a href="/admin/case-studies"
          class="nav-link <%= title==='Case Studies'?'active':'' %> <%= !hasAccess('case-studies')?'disabled-link':'' %>">
          <i class="bi bi-book"></i> Case Studies
          <% if(!hasAccess('case-studies')){ %><i class="bi bi-lock permission-lock"></i>
            <% } %>
        </a>
        <a href="/admin/blogs"
          class="nav-link <%= title==='Blogs'?'active':'' %> <%= !hasAccess('blogs')?'disabled-link':'' %>">
          <i class="bi bi-pencil-square"></i> Blogs
          <% if(!hasAccess('blogs')){ %><i class="bi bi-lock permission-lock"></i>
            <% } %>
        </a>
        <a href="/admin/posts"
          class="nav-link <%= title==='Community Posts'?'active':'' %> <%= !hasAccess('posts')?'disabled-link':'' %>">
          <i class="bi bi-chat-dots"></i> Community Posts
          <% if(!hasAccess('posts')){ %><i class="bi bi-lock permission-lock"></i>
            <% } %>
        </a>

        <span class="nav-section">Site Config</span>
        <a href="/admin/services"
          class="nav-link <%= title==='Services'?'active':'' %> <%= !hasAccess('services')?'disabled-link':'' %>">
          <i class="bi bi-gear"></i> Services
          <% if(!hasAccess('services')){ %><i class="bi bi-lock permission-lock"></i>
            <% } %>
        </a>
        <a href="/admin/faqs"
          class="nav-link <%= title==='FAQs'?'active':'' %> <%= !hasAccess('faqs')?'disabled-link':'' %>">
          <i class="bi bi-question-circle"></i> FAQs
          <% if(!hasAccess('faqs')){ %><i class="bi bi-lock permission-lock"></i>
            <% } %>
        </a>
        <a href="/admin/testimonials"
          class="nav-link <%= title==='Testimonials'?'active':'' %> <%= !hasAccess('testimonials')?'disabled-link':'' %>">
          <i class="bi bi-star"></i> Testimonials
          <% if(!hasAccess('testimonials')){ %><i class="bi bi-lock permission-lock"></i>
            <% } %>
        </a>

        <a href="/admin/privacy-policy"
   class="nav-link <%= title==='Privacy Policy'?'active':'' %> <%= !hasAccess('privacy-policy')?'disabled-link':'' %>">
  <i class="bi bi-shield-check"></i> Privacy Policy
  <% if(!hasAccess('privacy-policy')){ %>
    <i class="bi bi-lock permission-lock"></i>
  <% } %>
</a>

<a href="/admin/terms-condition"
   class="nav-link">
  <i class="bi bi-file-earmark-text"></i>
  Terms & Conditions
</a>

<a href="/admin/about"
   class="nav-link">
   <i class="bi bi-info-circle"></i>
   About Page
</a>

        <span class="nav-section">People</span>
        <a href="/admin/users"
          class="nav-link <%= title==='Users'?'active':'' %> <%= !hasAccess('users')?'disabled-link':'' %>">
          <i class="bi bi-people"></i> Users
          <% if(!hasAccess('users')){ %><i class="bi bi-lock permission-lock"></i>
            <% } %>
        </a>

        <li><a href="/admin/skills" class="nav-link"><i class="bi bi-tags-fill"></i>Skills</a></li>

        <li><a href="/admin/stages" class="nav-link"><i class="bi bi-tags-fill"></i>stage</a></li>

        <span class="nav-section">Inbox</span>
        <a href="/admin/contacts"
          class="nav-link <%= title==='Contact Messages'?'active':'' %> <%= !hasAccess('contacts')?'disabled-link':'' %>">
          <i class="bi bi-envelope"></i> Contact Messages
          <% if(!hasAccess('contacts')){ %><i class="bi bi-lock permission-lock"></i>
            <% } %>
        </a>
        <a href="/admin/newsletter"
          class="nav-link <%= title==='Newsletter Subscribers'?'active':'' %> <%= !hasAccess('newsletter')?'disabled-link':'' %>">
          <i class="bi bi-bell"></i> Newsletter
          <% if(!hasAccess('newsletter')){ %><i class="bi bi-lock permission-lock"></i>
            <% } %>
        </a>

        <% if(isSuperAdmin){ %>
          <span class="nav-section">Admin</span>
          <a href="/admin/sub-admins"
            class="nav-link <%= title==='Sub-Admins'||title==='Create Sub-Admin'||title==='Edit Sub-Admin'?'active':'' %>">
            <i class="bi bi-shield-check"></i> Sub-Admins
          </a>
          <% } %>

            <div class="mt-4 mx-3">
              <a href="/admin/logout" class="btn btn-outline-danger btn-sm w-100 py-2">
                <i class="bi bi-box-arrow-right me-2"></i>Logout
              </a>
            </div>
      </nav>
    </div>

    <!-- Main Content -->
    <div class="main-content">
      <div class="topbar">
        <h5><i class="bi bi-chevron-right text-muted me-2" style="font-size:.75rem"></i>
          <%= title %>
        </h5>
        <div class="d-flex align-items-center gap-2">
          <span class="badge <%= isSuperAdmin?'bg-warning text-dark':'bg-primary' %>" style="font-size:.7rem">
            <%= isSuperAdmin ? '⭐ Super Admin' : '🔧 Sub Admin' %>
          </span>
          <small class="text-muted"><strong>
              <%= adminMeta ? adminMeta.name : '' %>
            </strong></small>
        </div>
      </div>

      <div class="page-body">
        <% if (typeof success !=='undefined' && success && success.length> 0) { %>
          <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            <%= success %>
              <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
          </div>
          <% } %>

            <% if (typeof error !=='undefined' && error && error.length> 0) { %>
              <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i>
                <%= error %>
                  <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
              </div>
              <% } %>

                <!-- Your page content goes here -->