<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <p class="text-muted mb-0" style="font-size:.85rem">
      Create sub-admins with limited access. Each sub-admin can only access the sections you grant them.
    </p>
  </div>
  <a href="/admin/sub-admins/create" class="btn btn-primary btn-sm">
    <i class="bi bi-plus-lg me-1"></i>Create Sub-Admin
  </a>
</div>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>#</th>
          <th>Name & Email</th>
          <th>Permissions</th>
          <th>Status</th>
          <th>Last Login</th>
          <th>Created</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (subAdmins.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center text-muted py-5">
              No sub-admins yet.<br>
              <a href="/admin/sub-admins/create" class="btn btn-primary btn-sm mt-2">Create your first sub-admin</a>
            </td>
          </tr>
        <% } %>
        <% subAdmins.forEach((s, i) => { %>
        <tr>
          <td class="text-muted"><%= i + 1 %></td>
          <td>
            <strong><%= s.name %></strong><br>
            <small class="text-muted"><%= s.email %></small>
          </td>
          <td style="max-width:320px">
            <% if (s.permissions.length === 0) { %>
              <span class="text-muted small">No permissions assigned</span>
            <% } else { %>
              <div class="d-flex flex-wrap gap-1">
                <% s.permissions.forEach(p => { %>
                  <span class="badge bg-primary bg-opacity-10 text-primary" style="font-size:.7rem;border:1px solid #c7d2fe"><%= p %></span>
                <% }) %>
              </div>
            <% } %>
          </td>
          <td>
            <span class="badge <%= s.isActive ? 'badge-active' : 'badge-inactive' %>">
              <%= s.isActive ? 'Active' : 'Deactivated' %>
            </span>
          </td>
          <td>
            <small class="text-muted">
              <%= s.lastLogin ? new Date(s.lastLogin).toLocaleDateString() + ' ' + new Date(s.lastLogin).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) : 'Never' %>
            </small>
          </td>
          <td><small class="text-muted"><%= new Date(s.createdAt).toLocaleDateString() %></small></td>
          <td>
            <a href="/admin/sub-admins/<%= s._id %>/edit" class="btn btn-sm btn-outline-secondary py-0 me-1">
              <i class="bi bi-pencil"></i>
            </a>
            <form action="/admin/sub-admins/<%= s._id %>/delete" method="POST" style="display:inline">
              <button class="btn btn-sm btn-outline-danger py-0 btn-delete">
                <i class="bi bi-trash"></i>
              </button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Permissions Reference -->
<div class="card mt-3">
  <div class="card-header">🔑 Available Permissions Reference</div>
  <div class="card-body">
    <div class="row g-2">
      <% const permDesc = {
        'dashboard': 'View dashboard stats',
        'ideas': 'Manage Business / App / Startup Ideas',
        'case-studies': 'Manage Case Studies',
        'blogs': 'Manage Blog posts',
        'posts': 'Manage Community Posts',
        'services': 'Manage Services offered',
        'faqs': 'Manage FAQs',
        'testimonials': 'Manage Testimonials',
        'users': 'View and manage registered users',
        'contacts': 'View and reply to contact messages',
        'newsletter': 'View newsletter subscribers',
        'sub-admins': 'Create and manage sub-admins (Super only)',
      }; %>
      <% allPermissions.forEach(p => { %>
      <div class="col-md-4 col-lg-3">
        <div class="d-flex align-items-start gap-2 p-2 rounded" style="background:#f8fafc;border:1px solid #e2e8f0">
          <span class="badge bg-primary bg-opacity-10 text-primary mt-1" style="font-size:.65rem;white-space:nowrap;border:1px solid #c7d2fe"><%= p %></span>
          <small class="text-muted" style="font-size:.75rem"><%= permDesc[p] || p %></small>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
