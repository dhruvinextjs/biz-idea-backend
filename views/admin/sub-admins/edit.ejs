<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
  <%- include('../_layouts/head') %>
  <title>Edit Sub Admin | <%= title %></title>
  <style>
    body { padding-top: 78px !important; }
    #main { margin-top: 0 !important; }
    .error-field { border-bottom: 1px solid #f44336 !important; box-shadow: 0 1px 0 0 #f44336 !important; }
    .error-message { color:#f44336; font-size:12px; margin-top:5px; margin-bottom:15px; display:block; min-height:18px; font-weight:500; }
    .input-field { margin-bottom: 28px !important; }
    .input-field input { margin-bottom: 0 !important; }
    .switch label input[type=checkbox]:checked+.lever { background-color:#84c7c1; }
    .switch label input[type=checkbox]:checked+.lever:after { background-color:#26a69a; }
  </style>
</head>
<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
  data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

  <%- include('../partials/header') %>

  <div id="main">
    <div class="row">
      <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
        <div class="container">
          <div class="row">
            <div class="col s12 m6 l6">
              <h5 class="breadcrumbs-title mt-0 mb-0"><span>Edit Sub Admin</span></h5>
            </div>
            <div class="col s12 m6 l6 right-align-md">
              <ol class="breadcrumbs mb-0">
                <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/admin/sub-admins">Sub Admins</a></li>
                <li class="breadcrumb-item active">Edit</li>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <div class="col s12">
        <div class="container">
          <div class="card">
            <div class="card-content">
              <form method="POST" action="/admin/sub-admins/<%= subAdmin._id %>/edit" id="editForm">

                <!-- Basic Info -->
                <div class="row">
                  <div class="input-field col s12 m6">
                    <input class="validate" id="name" name="name" type="text" value="<%= subAdmin.name %>" required>
                    <label for="name" class="active">Name *</label>
                    <div class="error-message" id="nameError"></div>
                  </div>
                  <div class="input-field col s12 m6">
                    <input class="validate" id="email" name="email" type="email" value="<%= subAdmin.email %>" required>
                    <label for="email" class="active">Email Address *</label>
                    <div class="error-message" id="emailError"></div>
                  </div>
                </div>

                <div class="row">
                  <div class="input-field col s12 m6">
                    <input class="validate" id="password" name="password" type="password" minlength="6" placeholder="Leave blank to keep current">
                    <label for="password" class="active">New Password</label>
                    <div class="error-message" id="passwordError"></div>
                    <span style="font-size:11px; color:#9e9e9e;">Leave blank to keep existing password</span>
                  </div>
                </div>

                <!-- Permissions -->
                <div class="row">
                  <div class="col s12">
                    <h6 style="margin-top:20px; margin-bottom:16px;"><b>Set Permissions</b></h6>

                    <!-- Header -->
                    <div class="row" style="margin:0; padding:10px 15px; background:#f5f5f5; border-radius:4px; margin-bottom:8px;">
                      <div class="col s4"><b>Module Name</b></div>
                      <div class="col s2 center-align"><b>View</b></div>
                      <div class="col s2 center-align"><b>Add</b></div>
                      <div class="col s2 center-align"><b>Edit</b></div>
                      <div class="col s2 center-align"><b>Delete</b></div>
                    </div>

                    <% const permLabels = {
                      'dashboard': 'Dashboard', 'ideas': 'Ideas', 'case-studies': 'Case Studies',
                      'blogs': 'Blogs', 'posts': 'Community Posts', 'services': 'Services',
                      'faqs': 'FAQs', 'testimonials': 'Testimonials', 'users': 'Users',
                      'contacts': 'Contacts', 'newsletter': 'Newsletter'
                    };
                    const permModules = allPermissions.filter(p => p !== 'sub-admins');

                    // existing permissions ko object mein convert karo for easy lookup
                    const existingPerms = {};
                    if (subAdmin.permissions) {
                      subAdmin.permissions.forEach(p => { existingPerms[p] = true; });
                    }
                    // Agar permissions object format mein ho (View/Add/Edit/Delete)
                    const existingPermObj = {};
                    if (subAdmin.permissionDetails) {
                      subAdmin.permissionDetails.forEach(p => { existingPermObj[p.module] = p; });
                    }
                    %>

                    <% permModules.forEach(function(mod) {
                      const ep = existingPermObj[mod] || {};
                    %>
                    <div class="row" style="margin:0; padding:12px 0; border-bottom:1px solid #f0f0f0; align-items:center;">
                      <div class="col s4" style="padding-top:6px;">
                        <b><%= permLabels[mod] || mod %></b>
                      </div>
                      <div class="col s2 center-align">
                        <div class="switch">
                          <label>
                            <input type="checkbox" name="permissions[<%= mod %>][isView]" value="true"
                              <%= ep.isView ? 'checked' : '' %>>
                            <span class="lever"></span>
                          </label>
                        </div>
                      </div>
                      <div class="col s2 center-align">
                        <div class="switch">
                          <label>
                            <input type="checkbox" name="permissions[<%= mod %>][isAdd]" value="true"
                              <%= ep.isAdd ? 'checked' : '' %>>
                            <span class="lever"></span>
                          </label>
                        </div>
                      </div>
                      <div class="col s2 center-align">
                        <div class="switch">
                          <label>
                            <input type="checkbox" name="permissions[<%= mod %>][isEdit]" value="true"
                              <%= ep.isEdit ? 'checked' : '' %>>
                            <span class="lever"></span>
                          </label>
                        </div>
                      </div>
                      <div class="col s2 center-align">
                        <div class="switch">
                          <label>
                            <input type="checkbox" name="permissions[<%= mod %>][isDelete]" value="true"
                              <%= ep.isDelete ? 'checked' : '' %>>
                            <span class="lever"></span>
                          </label>
                        </div>
                      </div>
                      <input type="hidden" name="permissions[<%= mod %>][module]" value="<%= mod %>">
                      <input type="hidden" name="permissions[<%= mod %>][moduleName]" value="<%= permLabels[mod] || mod %>">
                    </div>
                    <% }) %>

                  </div>
                </div>

                <!-- Buttons -->
                <div class="row" style="margin-top:32px;">
                  <div class="col s12 display-flex justify-content-end">
                    <button class="btn btn-edit" type="submit">Update</button>
                    &nbsp;&nbsp;&nbsp;
                    <a class="btn btn-delete" href="/admin/sub-admins">Cancel</a>
                  </div>
                </div>

              </form>
            </div>
          </div>
        </div>
        <div class="content-overlay"></div>
      </div>
    </div>
  </div>

  <%- include('../_layouts/commonJs') %>
  <script>
    $(document).ready(function () {
      function showError(inputId, errorId, msg) { $(inputId).addClass('error-field'); $(errorId).text(msg); }
      function clearError(inputId, errorId) { $(inputId).removeClass('error-field'); $(errorId).text(''); }

      function validateName() {
        const v = $('#name').val().trim();
        if (!v) { showError('#name','#nameError','Please enter name.'); return false; }
        clearError('#name','#nameError'); return true;
      }
      function validateEmail() {
        const v = $('#email').val().trim();
        if (!v || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) { showError('#email','#emailError','Enter valid email.'); return false; }
        clearError('#email','#emailError'); return true;
      }
      function validatePassword() {
        const v = $('#password').val().trim();
        if (v && v.length < 6) { showError('#password','#passwordError','Min 6 characters.'); return false; }
        clearError('#password','#passwordError'); return true;
      }

      $('#name').on('input blur', validateName);
      $('#email').on('input blur', validateEmail);
      $('#password').on('input blur', validatePassword);

      $('#editForm').on('submit', function(e) {
        let valid = validateName() & validateEmail() & validatePassword();
        if (!valid) {
          e.preventDefault();
          const first = $('.error-field').first();
          if (first.length) $('html,body').animate({ scrollTop: first.offset().top - 120 }, 500);
        }
      });
    });
  </script>
</body>
</html>
