<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1 fw-bold"><i class="bi bi-star me-2 text-warning"></i>Testimonials</h4>
    <p class="text-muted mb-0 small">Manage customer testimonials</p>
  </div>
  <a href="/admin/testimonials/create" class="btn btn-primary">
    <i class="bi bi-plus-lg me-1"></i> Add Testimonial
  </a>
</div>

<div class="card shadow-sm border-0">
  <div class="card-header bg-white py-3">
    <span class="fw-semibold">All Testimonials <span class="badge bg-warning-subtle text-warning ms-1"><%= testimonials.length %></span></span>
  </div>
  <div class="card-body p-0">
    <% if (testimonials.length === 0) { %>
      <div class="text-center text-muted py-5">
        <i class="bi bi-star fs-2 d-block mb-2 opacity-50"></i>
        No testimonials yet. <a href="/admin/testimonials/create">Add one!</a>
      </div>
    <% } %>
    <% testimonials.forEach((t, i) => { %>
    <div class="border-bottom px-4 py-3 <%= i % 2 === 0 ? '' : 'bg-light bg-opacity-50' %>">
      <div class="d-flex justify-content-between align-items-start gap-3">
        <div class="d-flex gap-3 flex-grow-1">
          <% if (t.image) { %>
            <img src="<%= t.image %>" width="50" height="50" class="rounded-circle object-fit-cover flex-shrink-0" style="object-fit:cover" />
          <% } else { %>
            <div class="rounded-circle bg-primary-subtle d-flex align-items-center justify-content-center flex-shrink-0" style="width:50px;height:50px">
              <i class="bi bi-person text-primary fs-5"></i>
            </div>
          <% } %>
          <div class="flex-grow-1">
            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
              <span class="fw-semibold"><%= t.name %></span>
              <span class="text-muted small"><%= t.role %></span>
              <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size:11px">Order: <%= t.order %></span>
              <% if (t.isActive) { %>
                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:11px">Active</span>
              <% } else { %>
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size:11px">Hidden</span>
              <% } %>
            </div>
            <div class="text-warning mb-1" style="font-size:14px">
              <% for(let s = 0; s < t.rating; s++) { %>★<% } %>
              <% for(let s = t.rating; s < 5; s++) { %><span class="text-muted">★</span><% } %>
            </div>
            <small class="text-muted"><%= t.content.substring(0, 100) %><%= t.content.length > 100 ? '...' : '' %></small>
          </div>
        </div>
        <div class="d-flex gap-1 flex-shrink-0">
          <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editT<%= t._id %>" title="Edit">
            <i class="bi bi-pencil"></i>
          </button>
          <form action="/admin/testimonials/<%= t._id %>/delete" method="POST" style="display:inline">
            <button class="btn btn-sm btn-outline-danger btn-delete" title="Delete">
              <i class="bi bi-trash"></i>
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="editT<%= t._id %>" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
          <div class="modal-header bg-white border-bottom">
            <h5 class="modal-title fw-semibold"><i class="bi bi-pencil me-2 text-primary"></i>Edit Testimonial</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <form action="/admin/testimonials/<%= t._id %>/edit" method="POST">
            <div class="modal-body">
              <div class="row g-3">
                <div class="col-12 col-md-6">
                  <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                  <input type="text" name="name" class="form-control" value="<%= t.name %>" required />
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label fw-semibold">Role / Company</label>
                  <input type="text" name="role" class="form-control" value="<%= t.role %>" />
                </div>
                <div class="col-12">
                  <label class="form-label fw-semibold">Content <span class="text-danger">*</span></label>
                  <textarea name="content" class="form-control" rows="3" required><%= t.content %></textarea>
                </div>
                <div class="col-12">
                  <label class="form-label fw-semibold">Image URL</label>
                  <input type="text" name="image" class="form-control" value="<%= t.image %>" />
                </div>
                <div class="col-6">
                  <label class="form-label fw-semibold">Rating (1-5)</label>
                  <input type="number" name="rating" class="form-control" value="<%= t.rating %>" min="1" max="5" />
                </div>
                <div class="col-6">
                  <label class="form-label fw-semibold">Order</label>
                  <input type="number" name="order" class="form-control" value="<%= t.order %>" />
                </div>
                <div class="col-12">
                  <div class="d-flex justify-content-between align-items-center border rounded px-3 py-2">
                    <div>
                      <div class="fw-semibold">Active</div>
                      <small class="text-muted">Visible on site</small>
                    </div>
                    <div class="form-check form-switch mb-0">
                      <input class="form-check-input" type="checkbox" name="isActive" value="true" style="width:2.2em;height:1.3em" <%= t.isActive ? 'checked' : '' %> />
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="modal-footer bg-white border-top">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Changes</button>
            </div>
          </form>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
</div>

<%- include('../partials/footer') %>
