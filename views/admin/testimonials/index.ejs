<%- include('../partials/header') %>

<div class="row g-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
  <h4>⭐ All Testimonials (<%= testimonials.length %>)</h4>

  <a href="/admin/testimonials/create" class="btn btn-primary">
    ➕ Add Testimonial
  </a>
</div>

  <div class="col-md-8">
    <div class="card">
      
      <div class="card-body p-0">
        <% if (testimonials.length === 0) { %><div class="text-center text-muted py-4">No testimonials yet.</div><% } %>
        <% testimonials.forEach(t => { %>
        <div class="border-bottom p-3">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <strong><%= t.name %></strong> <span class="text-muted small"><%= t.role %></span>
              <br><span class="text-warning">'★'.repeat(<%= t.rating %>)</span>
              <br><small class="text-muted"><%= t.content.substring(0,80) %>...</small>
            </div>
            <div class="d-flex gap-1">
              <button class="btn btn-sm btn-outline-secondary py-0" data-bs-toggle="modal" data-bs-target="#editT<%= t._id %>"><i class="bi bi-pencil"></i></button>
              <form action="/admin/testimonials/<%= t._id %>/delete" method="POST" style="display:inline">
                <button class="btn btn-sm btn-outline-danger py-0 btn-delete"><i class="bi bi-trash"></i></button>
              </form>
            </div>
          </div>
        </div>

        <div class="modal fade" id="editT<%= t._id %>" tabindex="-1">
          <div class="modal-dialog"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Edit Testimonial</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <form action="/admin/testimonials/<%= t._id %>/edit" method="POST">
              <div class="modal-body">
                <div class="mb-2"><label class="form-label fw-semibold">Name</label><input type="text" name="name" class="form-control" value="<%= t.name %>" required/></div>
                <div class="mb-2"><label class="form-label fw-semibold">Role</label><input type="text" name="role" class="form-control" value="<%= t.role %>"/></div>
                <div class="mb-2"><label class="form-label fw-semibold">Content</label><textarea name="content" class="form-control" rows="3" required><%= t.content %></textarea></div>
                <div class="mb-2"><label class="form-label fw-semibold">Image URL</label><input type="text" name="image" class="form-control" value="<%= t.image %>"/></div>
                <div class="mb-2"><label class="form-label fw-semibold">Rating</label><input type="number" name="rating" class="form-control" value="<%= t.rating %>" min="1" max="5"/></div>
                <div class="mb-2"><label class="form-label fw-semibold">Order</label><input type="number" name="order" class="form-control" value="<%= t.order %>"/></div>
                <div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="isActive" value="true" <%= t.isActive ? 'checked' : '' %>/><label class="form-check-label">Active</label></div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
              </div>
            </form>
          </div></div>
        </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
