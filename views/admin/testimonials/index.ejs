<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
  <%- include('../_layouts/head') %>
  <title>Testimonials | <%= title %></title>

  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/jquery.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/extensions/responsive/css/responsive.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/select.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="/app-assets/css/pages/data-tables.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

  <style>
    body { padding-top: 78px !important; }
    #main { margin-top: 0 !important; }

    .badge-active   { background:rgba(76,175,80,0.12); color:#4CAF50; border:1px solid rgba(76,175,80,0.3); padding:3px 10px; border-radius:12px; font-size:11px; }
    .badge-inactive { background:rgba(158,158,158,0.12); color:#9e9e9e; border:1px solid rgba(158,158,158,0.3); padding:3px 10px; border-radius:12px; font-size:11px; }

    .star-rating {
      color: #ffc107;
      font-size: 18px;
      letter-spacing: 3px;
    }

    .testimonial-content {
      color: #555;
      line-height: 1.5;
      max-width: 420px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  </style>
</head>

<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
  data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

  <%- include('../partials/header') %>

  <div id="main">
    <div class="row">
      <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
        <div class="container">
          <div class="row">
            <div class="col s12 m6 l6">
              <h5 class="breadcrumbs-title mt-0 mb-0"><span>Testimonials</span></h5>
            </div>
            <div class="col s12 m6 l6 right-align-md">
              <ol class="breadcrumbs mb-0">
                <a class="btn gradient-45deg-purple-deep-orange pull-right btn-breadcrumbs"
                  style="color:#fff;" href="/admin/testimonials/create">Add New Testimonial</a>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <div class="col s12">
        <div class="container">
          <div class="section section-data-tables">
            <div class="row">
              <div class="col s12">
                <div class="card">
                  <div class="card-content">
                    <div class="row">
                      <div class="col s12 overflow">

                        <table id="page-length-option" class="display" style="width:100%">
                          <thead>
                            <tr>
                              <th>Order</th>
                              <th>Customer</th>
                              <th>Rating</th>
                              <th>Content</th>
                              <th>Status</th>
                              <th class="text-end">Actions</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (testimonials.length === 0) { %>
                              <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                  <i class="bi bi-star fs-2 d-block mb-2 opacity-50"></i>
                                  No testimonials yet. <a href="/admin/testimonials/create">Add one!</a>
                                </td>
                              </tr>
                            <% } else { %>
                              <% testimonials.forEach(t => { %>
                              <tr>
                                <td class="text-center">
                                  <span style="display:inline-block; width:34px; height:34px; line-height:34px; border-radius:50%; background:#eef2ff; color:#4f46e5; font-weight:600;">
                                    <%= t.order %>
                                  </span>
                                </td>
                                <td>
                                  <div style="display:flex; align-items:center; gap:12px;">
                                    <% if (t.image) { %>
                                      <img src="<%= t.image %>" width="48" height="48" 
                                           style="border-radius:50%; object-fit:cover; border:2px solid #f0f0f0;" 
                                           onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                    <% } %>
                                    <div style="width:48px; height:48px; border-radius:50%; background:#e3f2fd; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                      <i class="bi bi-person" style="color:#1976d2; font-size:24px;"></i>
                                    </div>
                                    <div class="display-flex flex-column">
                                      <div style="font-weight:600; color:#374151; margin-bottom: 8px;"><%= t.name %></div>
                                      <small class="text-muted mt-10"><%= t.role || '—' %></small>
                                    </div>
                                  </div>
                                </td>
                                <td>
                                  <div class="star-rating">
                                    <%- Array(5).fill(0).map((_, i) => 
                                      i < (t.rating || 0) 
                                        ? '<span style="color:#ffc107">★</span>' 
                                        : '<span style="color:#e0e0e0">★</span>'
                                    ).join('') %>
                                  </div>
                                </td>
                                <td>
                                  <div class="testimonial-content">
                                    <%= t.content %>
                                  </div>
                                </td>
                                <td>
                                  <% if (t.isActive) { %>
                                    <span class="badge-active">Active</span>
                                  <% } else { %>
                                    <span class="badge-inactive">Hidden</span>
                                  <% } %>
                                </td>
                                <td class="text-end">
                                  <div class="d-flex gap-2 justify-content-end">
                                    <button class="waves-effect waves-light btn-edit-testimonial"
                                     style="background:none; border:none; padding:0; margin:0; cursor:pointer;"
                                            data-id="<%= t._id %>"
                                            data-name="<%= t.name %>"
                                            data-role="<%= t.role || '' %>"
                                            data-content="<%= t.content %>"
                                            data-image="<%= t.image || '' %>"
                                            data-rating="<%= t.rating %>"
                                            data-order="<%= t.order %>"
                                            data-active="<%= t.isActive %>"
                                            title="Edit">
                                      <i class="material-icons" style="font-size:18px; color:#2196F3;">edit</i>
                                    </button>

                                    <form action="/admin/testimonials/<%= t._id %>/delete" method="POST" style="display:inline; margin:0;">
                                      <button type="submit" class="waves-effect waves-light"
                                        style="background:none; border:none; padding:0; margin:0; cursor:pointer;"
                                        onclick="return confirm('Delete this testimonial?');" title="Delete">
                                        <i class="material-icons" style="font-size:18px; color:#2196F3;">delete</i>
                                      </button>
                                    </form>
                                  </div>
                                </td>
                              </tr>
                              <% }) %>
                            <% } %>
                          </tbody>
                        </table>

                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="content-overlay"></div>
      </div>
    </div>
  </div>

  <!-- Edit Modal (same as before) -->
  <div class="modal fade" id="editTestimonialModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold"><i class="bi bi-pencil me-2 text-primary"></i>Edit Testimonial</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form id="editTestimonialForm" method="POST">
          <div class="modal-body">
            <input type="hidden" id="editId" name="id">

            <div class="row">
              <div class="input-field col s12 m6">
                <input id="editName" name="name" type="text" required>
                <label for="editName">Customer Name</label>
              </div>
              <div class="input-field col s12 m6">
                <input id="editRole" name="role" type="text">
                <label for="editRole">Role / Company</label>
              </div>
            </div>

            <div class="input-field col s12">
              <textarea id="editContent" name="content" class="materialize-textarea" required></textarea>
              <label for="editContent">Testimonial Content</label>
            </div>

            <div class="row">
              <div class="input-field col s12 m6">
                <input id="editImage" name="image" type="text">
                <label for="editImage">Image URL (optional)</label>
              </div>
              <div class="input-field col s12 m6">
                <input id="editRating" name="rating" type="number" min="1" max="5" required>
                <label for="editRating">Rating (1-5)</label>
              </div>
            </div>

            <div class="row">
              <div class="input-field col s6">
                <input id="editOrder" name="order" type="number" min="0">
                <label for="editOrder">Display Order</label>
              </div>
              <div class="col s6" style="margin-top: 25px;">
                <div class="switch">
                  <label>
                    Hidden
                    <input type="checkbox" id="editIsActive" name="isActive" value="true">
                    <span class="lever"></span>
                    Active
                  </label>
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn grey waves-effect waves-light" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn gradient-45deg-purple-deep-orange waves-effect waves-light">Save Changes</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <%- include('../_layouts/commonJs') %>
  <script src="/app-assets/vendors/data-tables/js/jquery.dataTables.min.js"></script>
  <script src="/app-assets/js/scripts/data-tables.js"></script>

  <script>
    document.querySelectorAll('.btn-edit-testimonial').forEach(btn => {
      btn.addEventListener('click', function () {
        const modal = new bootstrap.Modal(document.getElementById('editTestimonialModal'));
        
        document.getElementById('editId').value = this.dataset.id;
        document.getElementById('editName').value = this.dataset.name;
        document.getElementById('editRole').value = this.dataset.role || '';
        document.getElementById('editContent').value = this.dataset.content;
        document.getElementById('editImage').value = this.dataset.image || '';
        document.getElementById('editRating').value = this.dataset.rating;
        document.getElementById('editOrder').value = this.dataset.order;
        document.getElementById('editIsActive').checked = this.dataset.active === 'true';

        document.getElementById('editTestimonialForm').action = `/admin/testimonials/${this.dataset.id}/edit`;

        M.updateTextFields();
        modal.show();
      });
    });

    document.getElementById('editTestimonialModal').addEventListener('shown.bs.modal', function () {
      M.textareaAutoResize(document.getElementById('editContent'));
    });
  </script>
</body>
</html>